<Window x:Class="BodyTracker.Views.UserSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Body Information Tracker" 
        Height="400" 
        Width="600"
        Background="White"
         Icon="/Icon/ProgramIcon.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Connection Status"
                              Style="{StaticResource StandardGroupBox}"
                              Grid.Column="0">
                        
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Connected:"
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    Style="{StaticResource StandardTextBlockInfo}"/>

                        <TextBlock x:Name="DbConnection"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   Style="{StaticResource DescribingTextBlock}"
                                   Text="{Binding ActualConnectionState}"/>

                        <TextBlock Text="Actual User:"
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Style="{StaticResource StandardTextBlockInfo}"/>

                        <TextBlock x:Name="DbActualUser"
                                    Grid.Column="1"
                                    Grid.Row="1"
                                   Text="{Binding ActualUser}"
                                    Style="{StaticResource DescribingTextBlock}"/>

                        <TextBlock Text="Database:"
                                    Grid.Column="0"
                                    Grid.Row="2"
                                    Style="{StaticResource StandardTextBlockInfo}"/>

                        <TextBlock x:Name="DbActualDatabase"
                                    Grid.Column="1"
                                    Grid.Row="2"
                                    Text="{Binding AcutalDatabase}"
                                    Style="{StaticResource DescribingTextBlock}"/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Menue"
                            Style="{StaticResource StandardGroupBox}"
                          Grid.Column="1">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Grid.Column="1"
                                Margin="20,0,0,0">

                        <Button x:Name="btnNewLogin"
                                Content="New Login" 
                                Style="{StaticResource StandardButton}" 
                                Click="btnNewLogin_Click">
                        </Button>

                        <Button x:Name="btnNewPerson"
                                Content="New Person" 
                                Style="{StaticResource StandardButton}" 
                                Click="btnNewPerson_Click"/>

                    </StackPanel>
                </GroupBox>
            </Grid>


            <GroupBox Header="Select Person"
                      Style="{StaticResource StandardGroupBox}"
                      >
                <StackPanel Orientation="Vertical">
                    <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="PersonGrid" 
                                Grid.Row="0" 
                                      ItemsSource="{Binding Persons, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding Selected, 
                                                     Mode=TwoWay}"
                                      ColumnHeaderStyle="{StaticResource DataGrid_ColumnHeaderStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" 
                                      Margin="8"
                                      FontWeight="Normal"
                                      VerticalScrollBarVisibility="Auto"
                                      HeadersVisibility="Column"
                                      ScrollViewer.CanContentScroll="True"
                                      EnableColumnVirtualization="True"
                                      EnableRowVirtualization="True"
                                      Height="110"
                                      RowEditEnding="PersonsGrid_RowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding PersonID}"
                                                        Width="Auto"
                                                        CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="First Name"
                                                        Binding="{Binding PersonFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    
                                    <DataGridTextColumn Header="Last Name" 
                                                Binding="{Binding PersonLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="Birthdate" 
                                                        Binding="{Binding PersonBirthDate, Mode=TwoWay, 
                                                        StringFormat=d, UpdateSourceTrigger=PropertyChanged}"
                                                        CellStyle="{StaticResource DataGrid_CellStyleDate}"/>
                                <DataGridTextColumn Header="Height" 
                                                    Binding="{Binding PersonHeight, Mode=TwoWay, 
                                                              UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                    CellStyle="{StaticResource DataGrid_CellStyle}"/>

                            </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Button x:Name="LoadUserdata"
                                Content="Load Body Data from Person"
                                Style="{StaticResource StandardButton}" 
                                Click="btnLoadUserdata_Click"/>
                    </StackPanel>
            </GroupBox>


        </StackPanel>
    </ScrollViewer>
</Window>