<Window x:Class="BodyTracker.Views.UserSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Body Information Tracker" 
        Height="700" 
        Width="600"
        Background="White"
         Icon="/Icon/ProgramIcon.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="Server Connection Information"
                  Style="{StaticResource StandardGroupBox}">
                    <StackPanel Orientation="Vertical">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="User:"
                               Style="{StaticResource StandardTextBlock}"/>
                            <TextBox x:Name="DbUserBox"
                             Style="{StaticResource StandardTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Password:"
                           Style="{StaticResource StandardTextBlock}"/>
                            <PasswordBox x:Name="pbPasswordBox"
                                 PasswordChanged="PasswordChanged"
                                 Style="{StaticResource StandardPasswordBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Database:"
                           Style="{StaticResource StandardTextBlock}"/>
                            <TextBox x:Name="DbDatenbank"
                             Style="{StaticResource StandardTextBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SQL Server IP:"
                           Style="{StaticResource StandardTextBlock}"/>
                            <TextBox x:Name="DbServer"
                                     Style="{StaticResource StandardTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SQL Server Port:"
                           Style="{StaticResource StandardTextBlock}"/>
                            <TextBox x:Name="DbPort"
                                         Style="{StaticResource StandardTextBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">

                            <Button x:Name="btnSaveConnection"
                            Content="Save Connection Datas"
                            Click="OnSaveCredentials"
                            Style="{StaticResource SaveButton}">
                            </Button>
                        </StackPanel>
                    </StackPanel>
            </GroupBox>



            <GroupBox Header="Select Person"
                  Style="{StaticResource StandardGroupBox}">
                <StackPanel Orientation="Vertical">
                    <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" 
                              Margin="0,24,0,0" 
                              FontSize="14"
                              FontWeight="Normal"
                              ItemsSource="{Binding Persons}" 
                              SelectedItem="{Binding Selected}"                      
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" 
                                                Binding="{Binding PersonID}" 
                                                Width="60"/>
                                    <DataGridTextColumn Header="First Name" 
                                                Binding="{Binding PersonFirstName}"/>
                                    <DataGridTextColumn Header="Last Name" 
                                                Binding="{Binding PersonLastName}"/>
                                    <DataGridTextColumn Header="Birthdate" 
                                                Binding="{Binding PersonBirthDate, StringFormat=d}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Button x:Name="LoadUserdata"
                                Content="Load Body Data from Person"
                                Style="{StaticResource StandardButton}" 
                                Click="LoadUserdata_Click"/>
                    </StackPanel>
            </GroupBox>


            <GroupBox Header="Create new Person" 
               Style="{StaticResource StandardGroupBox}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="First name:"
                        Style="{StaticResource StandardTextBlock}"/>
                        <TextBox x:Name="tbNewFirstName"
                                 Style="{StaticResource StandardTextBox}"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Last Name:"
                            Style="{StaticResource StandardTextBlock}"/>
                        <TextBox x:Name="tbNewLastName"
                          Style="{StaticResource StandardTextBox}"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Grid.Row="2" 
                            Text="Birth date:" 
                            Style="{StaticResource StandardTextBlock}"/>
                        <DatePicker x:Name="dpBirthDate"
                                    FontSize="14"
                                    SelectedDate="{Binding BirthDate}"
                                    Margin="3"/>
                    </StackPanel>
                    <Button x:Name="SaveNewUser"
                     Content="Save new Person"
                     Command="{Binding NewUserCommand}"
                     Style="{StaticResource StandardButton}"/>


                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>