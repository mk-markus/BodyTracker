<Page x:Class="BodyTracker.MVVM.Views.ChartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChartsPage">



    <Grid>
        

        <StackPanel Orientation="Vertical">

            <GroupBox Header="Chart Setting"
                      Style="{StaticResource StandardGroupBox}">
                <StackPanel Orientation="Horizontal">
            
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Start Date: "
                                   Style="{StaticResource StandardTextBlock}"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Margin="3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="End Date: "
                                   Style="{StaticResource StandardTextBlock}"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Margin="3"/>
                    </StackPanel>
                </StackPanel>
               


            </GroupBox>

            <GroupBox Header="Chart"
                      Height="500"
                      Width="Auto"
                      Style="{StaticResource StandardGroupBox}">
                <lvc:CartesianChart Series="{Binding Series}" 
                                    XAxes="{Binding XAxes}" 
                                    YAxes="{Binding YAxes}" 
                                    LegendPosition="Top"/>
            </GroupBox>
           
        </StackPanel>



          

    </Grid>
</Page>
