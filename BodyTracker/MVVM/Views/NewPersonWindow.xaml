<Window x:Class="BodyTracker.MVVM.Views.NewPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
        mc:Ignorable="d"
        Title="NewPersonWindow" 
        Height="300" 
        Width="600"
        Icon="/Icon/ProgramIcon.ico">
    
    <Grid>
        <GroupBox Header="Create new Person" 
                  Style="{StaticResource StandardGroupBox}">
            
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Text="First name:"
                               Style="{StaticResource StandardTextBlock}"/>
                    
                    <TextBox x:Name="tbNewFirstName"
                             Style="{StaticResource StandardTextBox}"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Text="Last Name:"
                               Style="{StaticResource StandardTextBlock}"/>
                   
                    <TextBox x:Name="tbNewLastName"
                             Style="{StaticResource StandardTextBox}"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Grid.Row="2"
                               Text="Birth date:" 
                               Style="{StaticResource StandardTextBlock}"/>
                    <DatePicker x:Name="dpBirthDate"
                                FontSize="14"
                                SelectedDate="{Binding BirthDate}"
                                Margin="3"/>
                    
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Grid.Row="2" 
                               Text="Person Height [m]:" 
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding PersonHeight}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             Style="{StaticResource NumericValidationStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    
                    <Button x:Name="SaveNewUser"
                            Content="Create"
                           
                            Style="{StaticResource StandardButton}" 
                            Click="btnSaveNewUser_Click"/>
                    
                    <Button x:Name="Cancel"
                            Content="Cancel"
                            Style="{StaticResource StandardButton}" 
                            Click="btnCancel_Click"/>
                    
                </StackPanel>
                
            </StackPanel>
            
        </GroupBox>
        
    </Grid>
    
</Window>
