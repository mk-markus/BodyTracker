<Window x:Class="BodyTracker.Views.UserSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Body Information Tracker" 
        Height="400" 
        Width="600"
        Background="White"
        Icon="/Icon/ProgramIcon.ico">

    <!-- Main ScrollViewer to handle content overflow -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Top Section: Connection Status and Menu Controls -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Status Group Box -->
                <GroupBox Header="Connection Status"
                          Style="{DynamicResource StandardGroupBox}"
                          Grid.Column="0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Connection State Labels and Bindings -->
                            <TextBlock Text="Connected:"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Style="{DynamicResource StandardTextBlockInfo}"/>

                            <TextBlock x:Name="DbConnection"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   Style="{DynamicResource TextBlockDescribing}"
                                   Text="{Binding ActualConnectionState}"/>

                            <TextBlock Text="Actual User:"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   Style="{DynamicResource StandardTextBlockInfo}"/>

                            <TextBlock x:Name="DbActualUser"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{Binding ActualUser}"
                                   Style="{DynamicResource TextBlockDescribing}"/>

                            <TextBlock Text="Database:"
                                   Grid.Column="0"
                                   Grid.Row="2"
                                   Style="{DynamicResource StandardTextBlockInfo}"/>

                            <TextBlock x:Name="DbActualDatabase"
                                   Grid.Column="1"
                                   Grid.Row="2"
                                   Text="{Binding AcutalDatabase}"
                                   Style="{DynamicResource TextBlockDescribing}"/>
                    </Grid>
                </GroupBox>

                <!-- Navigation and Action Menu Group Box -->
                <GroupBox Header="Menue"
                          Style="{DynamicResource StandardGroupBox}"
                          Grid.Column="1">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Grid.Column="1"
                                Margin="20,0,0,0">

                        <!-- Login and User Creation Action Buttons -->
                        <Button x:Name="btnNewLogin"
                                Content="New Login" 
                                Style="{DynamicResource StandardButton}" 
                                Click="btnNewLogin_Click">
                        </Button>

                        <Button x:Name="btnNewPerson"
                                Content="New Person" 
                                Style="{DynamicResource StandardButton}" 
                                Click="btnNewPerson_Click"/>

                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- Bottom Section: Person Selection and Data Grid -->
            <GroupBox Header="Select Person"
                      Style="{DynamicResource StandardGroupBox}">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DataGrid for displaying and editing available persons -->
                        <DataGrid x:Name="PersonGrid" 
                                  Grid.Row="0" 
                                  ItemsSource="{Binding Persons, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding Selected, 
                                                         Mode=TwoWay}"
                                  Style="{DynamicResource DataGrid_Default}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" 
                                  Margin="8"
                                  FontWeight="Normal"
                                  VerticalScrollBarVisibility="Auto"
                                  HeadersVisibility="Column"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  Height="110"
                                  RowEditEnding="PersonsGrid_RowEditEnding"
                                  MouseDoubleClick="PersonGrid_MouseDoubleClick">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding PersonID}"
                                                    Width="Auto"/>

                                <DataGridTextColumn Header="First Name"
                                                    Binding="{Binding PersonFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Last Name" 
                                                    Binding="{Binding PersonLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Birthdate" 
                                                    Binding="{Binding PersonBirthDate, Mode=TwoWay, 
                                                            StringFormat=d, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Height" 
                                                    Binding="{Binding PersonHeight, Mode=TwoWay, 
                                                            UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Load Data Action Button -->
                    <Button x:Name="LoadUserdata"
                            Content="Load Body Data from Person"
                            Style="{DynamicResource StandardButton}" 
                            Click="btnLoadUserdata_Click"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>