<Window x:Class="BodyTracker.MVVM.Views.NewPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
        mc:Ignorable="d"
        Title="NewPersonWindow" 
        Height="300" 
        Width="600"
        Icon="/Icon/ProgramIcon.ico">
    
    <Grid>
        <GroupBox Header="Create new Person" 
                  Style="{StaticResource StandardGroupBox}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="First name:"
                           Style="{StaticResource StandardTextBlock}"
                           Grid.Column="0"
                           Grid.Row="0"/>

                <TextBox x:Name="tbNewFirstName"
                         Style="{StaticResource StandardTextBox}"
                         Text="{Binding FirstName, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="1"
                         Grid.Row="0"/>

                <TextBlock Text="Last Name:"
                           Style="{StaticResource StandardTextBlock}"
                           Grid.Column="0"
                           Grid.Row="1" />

                <TextBox x:Name="tbNewLastName"
                         Style="{StaticResource StandardTextBox}"
                         Text="{Binding LastName, Mode=TwoWay, 
                                    UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="1"
                         Grid.Row="1"/>

                <TextBlock  Text="Birth date:" 
                            Style="{StaticResource StandardTextBlock}"
                            Grid.Column="0"
                            Grid.Row="2"/>
                
                <DatePicker x:Name="dpBirthDate"
                            FontSize="14"
                            SelectedDate="{Binding BirthDate,Mode=TwoWay, 
                                    UpdateSourceTrigger=PropertyChanged}"
                            Margin="3"
                            Grid.Column="1"
                            Grid.Row="2"/>

                <TextBlock Text="Person Height [m]:" 
                            Style="{StaticResource StandardTextBlock}"
                            Grid.Column="0"
                            Grid.Row="3"/>

                <TextBox Text="{Binding PersonHeight, Mode=TwoWay, 
                                    UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="Decimal_PreviewTextInput" 
                         Style="{StaticResource NumericValidationStyle}"
                         Grid.Column="1"
                         Grid.Row="3"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Grid.Column="0"
                            Grid.Row="4"
                            Grid.ColumnSpan="2">
                    
                    <Button x:Name="SaveNewUser"
                            Content="Create"                           
                            Style="{StaticResource SaveButton}" 
                            Click="btnSaveNewUser_Click"
                            IsEnabled="{Binding IsNewPersonFormValid}"/>

                    <Button x:Name="Cancel"
                            Content="Cancel"
                            Style="{StaticResource StandardButton}" 
                            Click="btnCancel_Click"/>
          
                    
                </StackPanel>
                
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="Red" 
                           Margin="8" 
                           TextWrapping="Wrap"
                           FontSize="20"
                           Grid.Column="0"
                           Grid.Row="5"
                           Grid.ColumnSpan="2"/>

            </Grid>

        </GroupBox>
        
    </Grid>
    
</Window>
