<Page x:Class="BodyTracker.MVVM.Views.NewEntryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewEntryPage"
      Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <GroupBox Header="New Entry"
                      Style="{StaticResource StandardGroupBox}">
            <StackPanel Orientation="Vertical">
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Datum:"
                               Style="{StaticResource StandardTextBlock}"/>
                    <DatePicker FontSize="14"
                                FontWeight="Normal"
                                Margin="3"
                                SelectedDate="{Binding MeasurementDate}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Gewicht (kg):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding BodyWeight}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="BMI:"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding Bmi}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Körperfett (%):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding BodyFatPercentage}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Muskelmasse (%):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding BodyMusclePercentage}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Viszeralesfett:"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding BodyVisceralFat}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Burstumfang (cm):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding ChestCircumference}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bauchumfang (cm):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding WaistCircumference}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hüftumfang (cm):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding HipsCircumference}"
                             PreviewTextInput="Decimal_PreviewTextInput" 
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fettzange (mm):"
                               Style="{StaticResource StandardTextBlock}"/>
                    <TextBox Text="{Binding FatTongs}"
                             PreviewTextInput="Decimal_PreviewTextInput"
                             GotKeyboardFocus="SelectAllOnFocus"
                             Style="{StaticResource StandardTextBox}"/>
                </StackPanel>

                <Button Content="Speichern"  
                        Click="OnSaved"
                        Style="{StaticResource SaveButton}"/>


            </StackPanel>
        </GroupBox>
    </ScrollViewer>
</Page>
