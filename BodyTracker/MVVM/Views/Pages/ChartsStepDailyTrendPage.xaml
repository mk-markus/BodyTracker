<Page x:Class="BodyTracker.MVVM.Views.Pages.ChartsStepDailyTrendPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views.Pages"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChartsStepDailyTrendPage">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Date Filter -->
        <GroupBox Header="Select Chart Timespan"
                  Style="{StaticResource StandardGroupBox}"
                  Grid.Column="0"
                  Grid.Row="0">
            
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Start Date:"
                               Style="{StaticResource StandardTextBlock}" />

                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                FontWeight="Normal"
                                Margin="3" />

                    <TextBlock Text="End Date:"
                               Style="{StaticResource StandardTextBlock}" />

                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                FontWeight="Normal"
                                Margin="3" />

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    
                    <Button Content="Actual Year"
                            Style="{StaticResource StandardButton}"
                            Command="{Binding SetActualYearCommand}" />

                    <Button Content="Actual Week"
                            Style="{StaticResource StandardButton}"
                            Command="{Binding SetActualWeekCommand}" />

                    <Button Content="Actual Month"
                            Style="{StaticResource StandardButton}"
                            Command="{Binding SetActualMonthCommand}" />

                    <Button Content="Show All Data"
                            Style="{StaticResource StandardButton}"
                            Command="{Binding ShowAllDataCommand}" />

                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- Metrics -->
        <GroupBox Header="Show Daily Step Values"
                  Style="{StaticResource StandardGroupBox}"
                  Grid.Column="1"
                  Grid.Row="0"
                  Width="350"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Content="Steps"
                          IsChecked="{Binding ShowSteps}"
                          Command="{Binding RefreshChart}"
                          Style="{StaticResource StandardCheckBox}"
                          Grid.Row="0"
                          Grid.Column="0"/>

                <CheckBox Content="Steps Trend"
                          IsChecked="{Binding ShowStepsTrend}"
                          Command="{Binding RefreshChart}"
                          Style="{StaticResource StandardCheckBox}"
                          Grid.Row="0"
                          Grid.Column="1"/>

                <CheckBox Content="Distance"
                          IsChecked="{Binding ShowDistance}"
                          Command="{Binding RefreshChart}"
                          Style="{StaticResource StandardCheckBox}"
                          Grid.Row="1"
                          Grid.Column="0"/>

                <CheckBox Content="Distance Trend"
                          IsChecked="{Binding ShowDistanceTrend}"
                          Command="{Binding RefreshChart}"
                          Style="{StaticResource StandardCheckBox}"
                          Grid.Row="1"
                          Grid.Column="1"/>

                <CheckBox Content="Calories"
                          IsChecked="{Binding ShowCalories}"
                          Command="{Binding RefreshChart}"
                          Style="{StaticResource StandardCheckBox}"
                          Grid.Row="2"
                          Grid.Column="0"/>

                <CheckBox Content="Calories Trend"
                          IsChecked="{Binding ShowCaloriesTrend}"
                          Command="{Binding RefreshChart}"
                          Style="{StaticResource StandardCheckBox}"
                          Grid.Row="2"
                          Grid.Column="1"/>

            </Grid>

        </GroupBox>


        <GroupBox Header="Daily Step Trend"
                  Grid.Column="0"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Style="{StaticResource StandardGroupBox}">

            <lvc:CartesianChart x:Name="StepTrendChart"
                                Series="{Binding Series}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                LegendPosition="Bottom" />

        </GroupBox>

    </Grid>
</Page>
