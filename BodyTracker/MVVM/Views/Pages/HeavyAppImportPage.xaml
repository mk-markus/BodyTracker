<Page x:Class="BodyTracker.MVVM.Views.Pages.HeavyAppImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:BodyTracker.MVVM.ViewModels"
      Title="Heavy App CSC Import">

    <Border Style="{DynamicResource DashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Controls -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">

                <Button Content="Open Heavy App CSV"
                        Command="{Binding CommandOpenHeavyAppCsvFile}"
                        Style="{DynamicResource ModernStandardButton}" />

                <Button Content="Upload Training Data"
                        Command="{Binding CommandInsertHeavyAppCsvDatas}"
                        Style="{DynamicResource ModernStandardButton}" />

                <ProgressBar Height="25"
                             MinWidth="100"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding IsLoading, Converter={StaticResource bool2VisibilityConverter}}"
                             Style="{DynamicResource ProgressbarCurrentBarValue}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />

                <TextBlock Text="{Binding ProgressText}"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource TextBlockDescribing}"
                           Width="300"
                           TextAlignment="Center" />

            </StackPanel>

            <!-- Data Preview -->

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding HeavyAppDatas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="10"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Workout"
                                        Binding="{Binding Title}"
                                        Width="200" />

                    <DataGridTextColumn Header="Exercise"
                                        Binding="{Binding ExerciseTitle}"
                                        Width="220" />

                    <DataGridTextColumn Header="Start Time"
                                        Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="150" />

                    <DataGridTextColumn Header="End Time"
                                        Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="150" />

                    <DataGridTextColumn Header="Set"
                                        Binding="{Binding SetIndex}"
                                        Width="70" />

                    <DataGridTextColumn Header="Set Type"
                                        Binding="{Binding SetType}"
                                        Width="100" />

                    <DataGridTextColumn Header="Weight (kg)"
                                        Binding="{Binding WeightKg, StringFormat=F2}"
                                        Width="100" />

                    <DataGridTextColumn Header="Reps"
                                        Binding="{Binding Reps}"
                                        Width="70" />

                    <DataGridTextColumn Header="Distance (km)"
                                        Binding="{Binding DistanceKm, StringFormat=F2}"
                                        Width="110" />

                    <DataGridTextColumn Header="Duration (s)"
                                        Binding="{Binding DurationSeconds}"
                                        Width="110" />

                    <DataGridTextColumn Header="RPE"
                                        Binding="{Binding Rpe, StringFormat=F1}"
                                        Width="70" />

                    <DataGridTextColumn Header="Superset"
                                        Binding="{Binding SupersetId}"
                                        Width="140" />

                    <DataGridTextColumn Header="Notes"
                                        Binding="{Binding ExerciseNotes}"
                                        Width="250" />

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="300" />

                    <DataGridTextColumn Header="Data UUID"
                                        Binding="{Binding DataUuid}"
                                        Width="250" />

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Border>

</Page>