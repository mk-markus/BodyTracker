<Page x:Class="BodyTracker.MVVM.Views.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPageNew">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentTealBrush}" Margin="0,0,0,30">
                    <TextBlock Text="{Binding UserNameInitial}" 
                               Style="{DynamicResource TextBlockDashBoardTitle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="0"
                               Margin="0"
                               ToolTip="{Binding UserName}"/>
                </Border>

                
                <RadioButton Style="{StaticResource NavButtonStyle}" 
                             ToolTip="Dashboard"
                             IsChecked="{Binding IsDashboardSelected, Mode=TwoWay}">
                    <TextBlock Text="🏠" FontSize="16"/>
                </RadioButton>
                
                <RadioButton Style="{StaticResource NavButtonStyle}" 
                             ToolTip="Analytics"
                             IsChecked="{Binding IsMeasurementDatabaseSelected, Mode=TwoWay}">
                    <TextBlock Text="🗄️" FontSize="16"/>
                </RadioButton>
                
                <RadioButton Style="{StaticResource NavButtonStyle}" 
                             ToolTip="Charts"
                             IsChecked="{Binding IsChartsSelected, Mode=TwoWay}">
                    <TextBlock Text="📈" FontSize="16"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" 
                             ToolTip="New Entry"
                             IsChecked="{Binding IsNewEntrySelected, Mode=TwoWay}">
                    <TextBlock Text="🆕" FontSize="16"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" 
                             ToolTip="Data Import"
                             IsChecked="{Binding IsImportSelected, Mode=TwoWay}">
                    <TextBlock Text="📥" FontSize="16"/>
                </RadioButton>
                
            </StackPanel>
        </Border>

        <!-- Hauptinhalt -->
        <Grid Grid.Column="1" Margin="24">
            <Frame x:Name="MainContentFrame" NavigationUIVisibility="Hidden"
                   Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Page>
