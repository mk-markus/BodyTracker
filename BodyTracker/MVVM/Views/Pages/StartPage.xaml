<Page x:Class="BodyTracker.MVVM.Views.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" 
      d:DesignWidth="800"
      Title="EntryPage">

    <Grid>
        <TabControl x:Name="MainTabControll">
            
            <TabItem Header="Measurement">
                <Frame x:Name="MeasurementFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
            <TabItem Header="New Entry">
                <Frame x:Name="NewEntryFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
            <TabItem Header="Charts">
                <TabControl>
                    <TabItem Header="Body Measurements">
                        <Frame x:Name="ChartMeasurementFrame" NavigationUIVisibility="Hidden"/>
                    </TabItem>
                    <TabItem Header="Step Daily Trend">
                        <Frame x:Name="ChartStepDailyTrendFrame" NavigationUIVisibility="Hidden"/>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Import Samsung Health Data">
                <TabControl>
                    <TabItem Header="Food Intake">
                        <Frame x:Name="FoodIntakeFrame" NavigationUIVisibility="Hidden"/>
                    </TabItem>
                    <TabItem Header="Step Daily Trend">
                        <Frame x:Name="StepDailyTrendFrame" NavigationUIVisibility="Hidden"/>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Info">
                <Frame x:Name="InfoFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
            
        </TabControl>
        
    </Grid>
</Page>
