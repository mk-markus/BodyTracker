<Page x:Class="BodyTracker.MVVM.Views.MeasurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <GroupBox Header="Measurement Setting Menu"
                      Style="{StaticResource StandardGroupBox}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                    <Button Content="Delete" Click="OnDeleteClick" Style="{StaticResource StandardButton}" Width="100" />
                </StackPanel>
            </GroupBox>

            <GroupBox Style="{StaticResource StandardGroupBox}">
                <GroupBox.Header>
                    <TextBlock>
                        <Run Text="Measurements from " 
                             FontWeight="Normal"/>
                        <Run Text="{Binding UserName}" 
                             FontWeight="Bold"/>
                    </TextBlock>
                </GroupBox.Header>

                <DataGrid x:Name="MeasurementsGrid"
                          ItemsSource="{Binding Measurement, UpdateSourceTrigger=PropertyChanged}" 
                          ColumnHeaderStyle="{StaticResource DataGrid_ColumnHeaderStyle}"
                          SelectedItem="{Binding SelectedMeasurement}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          Margin="8"
                          FontWeight="Normal"
                          VerticalScrollBarVisibility="Auto"
                          HeadersVisibility="Column"
                          ScrollViewer.CanContentScroll="True"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          Height="300"
                          RowEditEnding="MeasurementsGrid_RowEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" 
                                            Binding="{Binding MeasurementDate, StringFormat='dddd, dd.MM.yyyy'}"
                                            Width="Auto"
                                            CellStyle="{StaticResource DataGrid_CellStyleDate}"/>

                        <DataGridTextColumn Header="Bodyweight (kg)" 
                                            Binding="{Binding BodyWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="BMI" 
                                            Binding="{Binding BMI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Body Fat (%)" 
                                            Binding="{Binding BodyFatPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Body Fat Top (%)" 
                                            Binding="{Binding BodyFatPercentageTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Body Fat Bottom (%)" 
                                            Binding="{Binding BodyFatPercentageBottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Muscle Mass (%)" 
                                            Binding="{Binding BodyMusclePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Muscle Mass Top (%)" 
                                            Binding="{Binding BodyMusclePercentageTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Muscle Mass Bottom (%)" 
                                            Binding="{Binding BodyMusclePercentageBottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Body Water (%)" 
                                            Binding="{Binding BodyWaterPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Bone Mass (kg)" 
                                            Binding="{Binding BodyBoneMass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Visceral Fat" 
                                            Binding="{Binding BodyVisceralFat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Chest Circumference (cm)" 
                                            Binding="{Binding ChestCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Waist Circumference (cm)" 
                                            Binding="{Binding WaistCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Hips Circumference (cm)" 
                                            Binding="{Binding HipsCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Fat Tong Breast Crease (mm)" 
                                            Binding="{Binding FatTongBreastCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Fat Tong Midaxillary Crease (mm):" 
                                            Binding="{Binding FatTongArmpitCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Fat Tong Abdominal Crease (mm)" 
                                            Binding="{Binding FatTongAbdominalCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Fat Tong Hip Crease (mm)" 
                                            Binding="{Binding FatTongHipCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>
                        
                        <DataGridTextColumn Header="Fat Tong Thigh Crease (mm)" 
                                            Binding="{Binding FatTongThighCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>
                        
                        <DataGridTextColumn Header="Fat Tong back Crease (mm)" 
                                            Binding="{Binding FatTongBackCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>

                        <DataGridTextColumn Header="Fat Tong Triceps Crease (mm)" 
                                            Binding="{Binding FatTongTricepsCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            CellStyle="{StaticResource DataGrid_CellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Style="{StaticResource StandardGroupBox}">
                <GroupBox.Header>
                    <TextBlock>
                        <Run Text="Mean values from " 
                             FontWeight="Normal"/>
                        <Run Text="{Binding UserName}" 
                             FontWeight="Bold"/>
                    </TextBlock>
                </GroupBox.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Text="Start Date: "
                                   Style="{StaticResource StandardTextBlock}"/>
                        <DatePicker SelectedDate="{Binding MeanStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Margin="3"/>

                        <TextBlock Text="End Date: "
                                   Style="{StaticResource StandardTextBlock}"/>
                        <DatePicker SelectedDate="{Binding MeanEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Margin="3"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal">
                        <Button x:Name="AcutalYear"
                                Content="Actual Year"
                                Style="{StaticResource StandardButton}"
                                Click="btnSetActualYear_Click"/>
                        <Button x:Name="ActualWeek"
                                Content="Actual Week"
                                Style="{StaticResource StandardButton}"
                                Click="btnSetActualWeek_Click"/>

                        <Button x:Name="ActualMonth"
                                Content="Actual Month"
                                Style="{StaticResource StandardButton}"
                                Click="btnSetActualMonth_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="MeanValue"
                              ItemsSource="{Binding MeanMeasurement, UpdateSourceTrigger=PropertyChanged}"
                              CellStyle="{StaticResource DataGrid_CellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGrid_ColumnHeaderStyle}"
                              SelectedItem="{Binding SelectedMeasurement}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="8"
                              FontWeight="Normal"
                              VerticalScrollBarVisibility="Auto"
                              HeadersVisibility="Column"
                              ScrollViewer.CanContentScroll="True"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              Height="300"
                              Grid.Column="0"
                              Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bodyweight (kg)" 
                                                Binding="{Binding BodyWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"/>
                            <DataGridTextColumn Header="BMI"
                                                Binding="{Binding BMI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                IsReadOnly="true"/>
                            <DataGridTextColumn Header="Body Fat (%)"
                                                Binding="{Binding BodyFatPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                            <DataGridTextColumn Header="Muscle Mass (%)"
                                                Binding="{Binding BodyMusclePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Body Water (%)" 
                                                Binding="{Binding BodyWaterPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Chest Circumference (cm)"
                                                Binding="{Binding ChestCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Waist Circumference (cm)" 
                                                Binding="{Binding WaistCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Hips Circumference (cm)" 
                                                Binding="{Binding HipsCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Caliper Body Fat (%)" 
                                                Binding="{Binding CaliperBodyFatPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </GroupBox>
        </StackPanel>
    </Grid>
</Page>
