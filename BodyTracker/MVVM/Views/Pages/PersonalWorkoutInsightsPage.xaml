<Page x:Class="BodyTracker.MVVM.Views.Pages.PersonalWorkoutInsightsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" 
      xmlns:local="clr-namespace:BodyTracker.Services">

    <!--Änderung: Converter-Resource aktivieren (vorher kommentiert)-->
    <Page.Resources>
        <local:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>
    </Page.Resources>

    <StackPanel>



        <!--<StackPanel.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </StackPanel.RowDefinitions>-->

        <!-- Header -->
        <StackPanel Margin="20"
                    Orientation="Horizontal">

            <!--<StackPanel.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
            </StackPanel.ColumnDefinitions>-->

            <!--<StackPanel>

                <TextBlock Text="⚡ Perosnal Workout Insights"
                           Style="{DynamicResource TextBlockDashBoardTitle}"/>

            </StackPanel>-->

            <!-- KPI 1 -->
            <Border Grid.Column="1"
                    Margin="10"
                    Style="{DynamicResource DashboardCardStyle}">

                <!--<Grid VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>-->

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="Total Training Sessions"
                                Style="{DynamicResource TextBlockDescribing}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                                FontWeight="Bold"
                               
                                Grid.Column="0"
                                Grid.Row="0"
                               Grid.ColumnSpan="2"/>

                    <TextBlock Text="{Binding TotalWorkouts}"
                                Style="{DynamicResource TextBlockDescribing}"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                                Grid.Column="0"
                                Grid.Row="1"
                               Grid.ColumnSpan="2"/>

                </StackPanel>
                <!--</Grid>-->
            </Border>

            <!-- KPI 2 -->
            <Border Grid.Column="2"
                    Margin="10"
                    Style="{DynamicResource DashboardCardStyle}">

                <!--<Grid VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>-->

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Total Workout Volume (kg): "
                               Style="{DynamicResource TextBlockDescribing}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Grid.Column="0"
                               Grid.Row="0"/>

                    <TextBlock Text="{Binding TotalWorkoutsVolume}"
                               Style="{DynamicResource TextBlockDescribing}"
                                FontSize="32"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                  Grid.Column="0"
                                  Grid.Row="1"
                                 Grid.ColumnSpan="2"/>

                    <!--<TextBlock Text="Total Workout Primary Volume (kg): "
                               Style="{DynamicResource TextBlockDescribing}"
                               FontWeight="Bold"
                               Grid.Column="0"
                               Grid.Row="1"/>

                    <TextBlock Text="{Binding TotalWorkoutsPrimaryVolume}"
                               Style="{DynamicResource TextBlockDescribing}"
                               Grid.Column="1"
                               Grid.Row="1"/>

                    <TextBlock Text="Total Workput Secondary Volume (kg): "
                               Style="{DynamicResource TextBlockDescribing}"
                               FontWeight="Bold"
                               Grid.Column="0"
                               Grid.Row="2"/>

                    <TextBlock Text="{Binding TotalWorkoutsSecondaryVolume}"
                               Style="{DynamicResource TextBlockDescribing}"
                               Grid.Column="1"
                               Grid.Row="2"/>-->

                </StackPanel>

                <!--</Grid>-->
            </Border>
        </StackPanel>

        <!-- Charts Top -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Häufigste Übungen -->
            <Border Grid.Column="0"
                    Grid.Row="0"
          Margin="5"
          Style="{DynamicResource DashboardCardStyle}">
                <ScrollViewer Height="300"
                              Width="Auto">
                    <ItemsControl ItemsSource="{Binding TopExercises}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--Übungsname-->
                                    <TextBlock Grid.Column="0"
                                 Text="{Binding ExerciseName}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           Margin="10,0,10,0"
                                           Width="Auto"/>

                                    <!--ProgressBar: MultiBinding braucht Converter (hier vorhanden)-->
                                    <ProgressBar Grid.Column="1"
                                                    Height="20"
                                                    Margin="10,0,10,0"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    Value="{Binding Percentage}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left">
                                        <ProgressBar.Width>
                                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                <Binding Path="Percentage"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </ProgressBar.Width>
                                    </ProgressBar>

                                    <!--Prozentanzeige-->
                                    <TextBlock Grid.Column="2"
                                 Text="{Binding Percentage, StringFormat={}{0:P0}}"
                                 HorizontalAlignment="Center"
                                               TextAlignment="Left"
                                               Margin="10,0,10,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>

            </Border>

            <!--Verteilung-->
            <Border Grid.Column="1"
                    Margin="5"
                    Grid.RowSpan="1"
                    Style="{DynamicResource DashboardCardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="💪 Workout Muscle Distribution"
                               Style="{DynamicResource TextBlockDashBoardTitle}"
                               Margin="10"/>

                    <lvc:PieChart Grid.Row="1"
                                    Series="{Binding WorkoutMuscleDistributionSeries}"
                                    LegendPosition="Right"
                                    LegendTextSize="11"
                                    Height="300"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">



                    </lvc:PieChart>


                </Grid>
            </Border>
            <!-- Untere Grafik -->
            <Border Grid.Row="2"
                Margin="25"
                Style="{DynamicResource DashboardCardStyle}">


                <StackPanel>

                    <TextBlock Text="📈 Monatliches Trainingsvolumen"
                           Margin="15"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold"/>

                    <lvc:CartesianChart
                    Series="{Binding MonthlyVolumeSeries}"
                    XAxes="{Binding MonthlyXAxis}"
                    YAxes="{Binding MonthlyYAxis}" />

                </StackPanel>

            </Border>

        </Grid>
    </StackPanel>
</Page>