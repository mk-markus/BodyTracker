<Page x:Class="BodyTracker.MVVM.Views.Pages.StepDailyTrendPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:BodyTracker.MVVM.ViewModels"
      Title="Step Daily Trend">
    
    <!--<Page.DataContext>
        <vm:StepDailyTrendViewModel />
    </Page.DataContext>-->

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="10">
            
            <Button Content="Open Daily Trend File" 
                    Command="{Binding OpenSamsungStepDailyTrendCommand}" 
                    Style="{StaticResource StandardButton}"/>
            
            <Button Content="Upload Step Daily Trend Data"
                    Command="{Binding InsertSamsungStepsDailyTrendToDatabaseCommand}" 
                    Style="{StaticResource StandardButton}"/>

            <ProgressBar Height="25" 
                         Width="100"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         Visibility="{Binding IsLoading, Converter={StaticResource bool2VisibilityConverter}}" />

            <TextBlock Text="{Binding ProgressText}"
                       HorizontalAlignment="Center"
                       Style="{StaticResource StandardTextBlock}"/>
            
        </StackPanel>
        
        
         <DataGrid Grid.Row="1"
          ItemsSource="{Binding StepDailyTrend}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          Margin="10"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
          ScrollViewer.CanContentScroll="True"
                   Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Date"
                            Binding="{Binding DayTime, StringFormat=dd.MM.yyyy}"
                            Width="120" />

                    <DataGridTextColumn Header="Steps"
                            Binding="{Binding Count}"
                            Width="100" />

                    <DataGridTextColumn Header="Distance (m)"
                            Binding="{Binding Distance, StringFormat=F2}"
                            Width="120" />

                    <DataGridTextColumn Header="Speed"
                            Binding="{Binding Speed, StringFormat=F2}"
                            Width="100" />

                    <DataGridTextColumn Header="Calories"
                            Binding="{Binding Calorie, StringFormat=F0}"
                            Width="100" />

                    <DataGridTextColumn Header="Source Package"
                            Binding="{Binding SourcePkgName}"
                            Width="220" />

                    <DataGridTextColumn Header="Source Type"
                            Binding="{Binding SourceType}"
                            Width="100" />

                    <DataGridTextColumn Header="Created"
                            Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm}"
                            Width="150" />

                    <DataGridTextColumn Header="Updated"
                            Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm}"
                            Width="150" />

                    <DataGridTextColumn Header="Device UUID"
                            Binding="{Binding DeviceUuid}"
                            Width="150" />

                    <DataGridTextColumn Header="Package"
                            Binding="{Binding PkgName}"
                            Width="220" />

                    <DataGridTextColumn Header="Data UUID"
                            Binding="{Binding DataUuid}"
                            Width="250" />

                    <DataGridTextColumn Header="Binning Data"
                            Binding="{Binding BinningData}"
                            Width="300" />

                </DataGrid.Columns>

            </DataGrid>
    </Grid>
</Page>
