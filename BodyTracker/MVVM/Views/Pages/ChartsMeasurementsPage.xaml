<Page x:Class="BodyTracker.MVVM.Views.ChartsMeasurementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChartsPage">

    <Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <GroupBox Header="Select Chart Timespan"
                      Style="{StaticResource StandardGroupBox}"
                      Grid.Column="0"
                      Grid.Row="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0"
                                Grid.Row="0"
                                Orientation="Horizontal">
                        
                        <TextBlock Text="Start Date: "
                                   Style="{StaticResource StandardTextBlock}"/>
                        
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Margin="3"/>

                        <TextBlock Text="End Date: "
                                   Style="{StaticResource StandardTextBlock}"/>
                        
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Margin="3"/>
                        
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        
                        <Button x:Name="AcutalYear"
                                Content="Acutal Year"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding SetActualYearCommand}"/>

                        <Button x:Name="ActualWeek"
                                Content="Acutal Week"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding SetActualWeekCommand}"/>

                        <Button x:Name="ActualMonth"
                                Content="Acutal Month"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding SetActualMonthCommand}"/>
                        
                        <Button x:Name="AllMeasurements"
                                Content="Show All Measurements"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding ShowAllDataCommand}"/>
                        
                    </StackPanel>
                    
                </Grid>
                
            </GroupBox>

            <GroupBox Header="Show Measurement Values"
                      Style="{StaticResource StandardGroupBox}"
                      Grid.Column="1"
                      Grid.Row="0"
                      Width="290"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Content="Body Weight"
                              IsChecked="{Binding ShowBodyWeight}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="0"
                              Grid.Row="0"/>

                    <CheckBox Content="Body Weight Trend"
                              IsChecked="{Binding ShowBodyWeightTrend}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="1"
                              Grid.Row="0"/>

                    <CheckBox Content="Body Muscle"
                              IsChecked="{Binding ShowBodyMuscle}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="0"
                              Grid.Row="1"/>

                    <CheckBox Content="Body Muscle Trend"
                              IsChecked="{Binding ShowBodyMuscleTrend}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="1"
                              Grid.Row="1"/>

                    <CheckBox Content="Body Fat"
                              IsChecked="{Binding ShowBodyFat}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="0"
                              Grid.Row="2"/>
                    
                    <CheckBox Content="Body Fat Trend"
                              IsChecked="{Binding ShowBodyFatTrend}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="1"
                              Grid.Row="2"/>

                    <CheckBox Content="Body Water"
                              IsChecked="{Binding ShowBodyWater}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="0"
                              Grid.Row="3"/>

                    <CheckBox Content="Body Water Trend"
                              IsChecked="{Binding ShowBodyWaterTrend}"
                              Command="{Binding RefreshChart}"
                              Style="{StaticResource StandardCheckBox}"
                              Grid.Column="1"
                              Grid.Row="3"/>
                    
                </Grid>
                
            </GroupBox>

            <GroupBox Header="Chart"
                      Height="800"
                      Width="Auto"
                      Style="{StaticResource StandardGroupBox}"
                      Grid.Column="0"
                      Grid.Row="2"
                      Grid.ColumnSpan="2">

                <lvc:CartesianChart x:Name="BodyChart"
                                    Series="{Binding Series}" 
                                    XAxes="{Binding XAxes}" 
                                    YAxes="{Binding YAxes}" 
                                    LegendPosition="Bottom"
                                  >

                </lvc:CartesianChart>
            </GroupBox>

        </Grid>
        
    </Grid>

</Page>
