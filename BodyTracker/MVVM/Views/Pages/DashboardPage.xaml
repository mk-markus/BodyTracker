<Page x:Class="BodyTracker.MVVM.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d"
      Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Grid>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Current And Last Month's Progress  -->
                <Border Grid.Column="0"
                        Grid.Row="0"
                        Grid.RowSpan="5"
                        Style="{DynamicResource DashboardCardStyle}" 
                        Margin="0,0,10,0">
                    
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Vertical">

                        <TextBlock Text="Current And Last Month's Progress"
                               Style="{DynamicResource TextBlockDashBoardTitle}"
                               Grid.Column="0"
                               Grid.Row="0"/>
                       
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,0,0,12">

                            <StackPanel Orientation="Horizontal" 
                                        Margin="0,0,16,0">

                                <Rectangle Style="{DynamicResource RectanglePreviousMonth}"/>

                                <TextBlock Text="Previous Month" 
                                           Style="{DynamicResource TextBlockPreviousMonth}"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <Rectangle Style="{DynamicResource RectangleActualMonth}"/>

                                <TextBlock Text="Current Month" Style="{DynamicResource TextBlockActualMonth}"/>

                            </StackPanel>

                        </StackPanel>

                        <!-- 1. Weight -->
                        <StackPanel Grid.Column="0">

                            <Grid Margin="0,0,0,4">

                                <TextBlock Text="Weight (kg)" 
                                           Style="{DynamicResource TextBlockDescribing}"/>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">

                                    <ContentControl Content="{Binding BodyWeightTrendArrow}"
                                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                    <TextBlock Text="{Binding BodyWeightDifference}" 
                                                Style="{DynamicResource TextBlockDifference}"/>

                                </StackPanel>

                            </Grid>

                            <!-- Balken-Diagramm  -->
                            <Grid Height="14">
                                <ProgressBar Value="{Binding BodyWeightPreviousBarValue}" 
                                             Maximum="{Binding BodyWeightBarMaximum}" 
                                             Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                                <ProgressBar Value="{Binding BodyWeightCurrentBarValue}" 
                                             Maximum="{Binding BodyWeightBarMaximum}" 
                                             Style="{DynamicResource ProgressbarCurrentBarValue}"/>
                            </Grid>

                        </StackPanel>

                        <!-- 2. Body Fat -->
                        <StackPanel Margin="0,0,0,12">

                            <Grid Margin="0,0,0,4">

                                <TextBlock Text="Body Fat (%)" 
                                            Style="{DynamicResource TextBlockDescribing}"/>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">

                                    <ContentControl Content="{Binding BodyFatTrendArrow}"
                                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                    <TextBlock Text="{Binding BodyFatDifference}" 
                                                Style="{DynamicResource TextBlockDifference}"/>
                                </StackPanel>

                            </Grid>

                            <!-- Balken-Diagramm  -->
                            <Grid Height="14">
                                <ProgressBar Value="{Binding BodyFatPreviousBarValue}" 
                                                Maximum="{Binding BodyFatBarMaximum}" 
                                                Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                                <ProgressBar Value="{Binding BodyFatCurrentBarValue}" 
                                                Maximum="{Binding BodyFatBarMaximum}" 
                                                Style="{DynamicResource ProgressbarCurrentBarValue}"/>
                            </Grid>

                        </StackPanel>


                        <!-- 3. Muscle Mass -->

                        <StackPanel Margin="0,0,0,12">

                            <Grid Margin="0,0,0,4">

                                <TextBlock Text="Muscle Mass (%)" 
                                            Style="{DynamicResource TextBlockDescribing}"/>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">

                                    <ContentControl Content="{Binding BodyMuscleMassTrendArrow}"
                                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                    <TextBlock Text="{Binding BodyMuscleMassDifference}" 
                                               Style="{DynamicResource TextBlockDifference}"/>
                                </StackPanel>

                            </Grid>

                            <!-- Balken-Diagramm -->
                            <Grid Height="14">
                                <ProgressBar Value="{Binding BodyMuscleMassPreviousBarValue}" 
                                                Maximum="{Binding BodyMuscleMassBarMaximum}" 
                                                Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                                <ProgressBar Value="{Binding BodyMuscleMassCurrentBarValue}" 
                                                Maximum="{Binding BodyMuscleMassBarMaximum}" 
                                                Style="{DynamicResource ProgressbarCurrentBarValue}"/>
                            </Grid>

                        </StackPanel>

                        <!-- 4. Body Water -->

                        <StackPanel Margin="0,0,0,12">

                            <Grid Margin="0,0,0,4">

                                <TextBlock Text="Body Water (%)" 
                                            Style="{DynamicResource TextBlockDescribing}"/>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">

                                    <ContentControl Content="{Binding BodyWaterTrendArrow}"
                                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                    <TextBlock Text="{Binding BodyWaterDifference}" 
                                                Style="{DynamicResource TextBlockDifference}"/>
                                </StackPanel>

                            </Grid>

                            <!-- Balken-Diagramm  -->
                            <Grid Height="14">
                                <ProgressBar Value="{Binding BodyWaterPreviousBarValue}" 
                                             Maximum="{Binding BodyWaterBarMaximum}" 
                                             Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                                <ProgressBar Value="{Binding BodyWaterCurrentBarValue}" 
                                                Maximum="{Binding BodyWaterBarMaximum}" 
                                                Style="{DynamicResource ProgressbarCurrentBarValue}"/>
                            </Grid>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Grid.Row="0"
                        Style="{DynamicResource DashboardCardStyle}">

                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Orientation="Vertical">

                        <TextBlock Text="New Database Entry"
                                   Style="{DynamicResource TextBlockDashBoardTitle}"/>


                        <Button Content="New Measurements"
                                Command="{Binding CommandShowNewDatabaseEntryPage}"
                                Style="{DynamicResource ModernStandardButton}"
                                Margin="0,10,0,0"/>

                    </StackPanel>



                </Border>
               

                <!--Last 3 Month Chart-->
                <Border Grid.Column="0"
                        Grid.Row="6"
                        Grid.ColumnSpan="5"                        
                        Style="{StaticResource DashboardCardStyle}"
                        
                        Margin="0,10,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <TextBlock Text="Progress Chart Last 3 Months" 
                                   Style="{DynamicResource TextBlockDashBoardTitle}"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Margin="0,0,0,0"/>

                        <lvc:CartesianChart x:Name="BodyChart"
                                            Series="{Binding Series}" 
                                            XAxes="{Binding XAxes}" 
                                            YAxes="{Binding YAxes}" 
                                            LegendPosition="Bottom"
                                            Background="Transparent"
                                            Grid.Column="0"
                                            Grid.Row="1">
                        </lvc:CartesianChart>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
</Page>