<Page x:Class="BodyTracker.MVVM.Views.MeasurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.MVVM.Views"
      mc:Ignorable="d">

    <Grid>
        

      
            <StackPanel>
                <GroupBox Header="Measurement Setting Menue"
                          Style="{StaticResource StandardGroupBox}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">

                        <Button Content="Löschen" Click="OnDeleteClick" Style="{StaticResource StandardButton}" Width="100" />
                        
                    </StackPanel>

                </GroupBox>

                <GroupBox Style="{StaticResource StandardGroupBox}">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run Text="Messwerte von " 
                                 FontWeight="Normal"/>
                            <Run Text="{Binding UserName}" 
                                 FontWeight="Bold"/>
                        </TextBlock>
                    </GroupBox.Header>

                    
                    <DataGrid x:Name="MeasurementsGrid"
                              ItemsSource="{Binding Measurement, UpdateSourceTrigger=PropertyChanged}" 
                              CellStyle="{StaticResource DataGrid_CellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGrid_ColumnHeaderStyle}"
                              SelectedItem="{Binding SelectedMeasurement}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              Margin="8"
                              FontWeight="Normal"
                              VerticalScrollBarVisibility="Auto"
                              HeadersVisibility="Column"
                              ScrollViewer.CanContentScroll="True"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              Height="300"
                              RowEditEnding="MeasurementsGrid_RowEditEnding">
                        <DataGrid.Columns >
                            <DataGridTextColumn Header="Datum" 
                                                Binding="{Binding MeasurementDate,StringFormat=d}"/>
                            <DataGridTextColumn Header="Gewicht (kg)" 
                                                Binding="{Binding BodyWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"/>
                            <DataGridTextColumn Header="BMI" 
                                                Binding="{Binding BMI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Körperfett (%)" 
                                                Binding="{Binding BodyFatPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" />
                            <DataGridTextColumn Header="Muskelmasse (%)" 
                                                Binding="{Binding BodyMusclePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"/>
                            <DataGridTextColumn Header="Viszeralfett" 
                                                Binding="{Binding BodyVisceralFat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Brustumfang (cm)" 
                                                Binding="{Binding ChestCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Bauchumfang (cm)" 
                                                Binding="{Binding WaistCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Hüftumfang (cm)" 
                                                Binding="{Binding HipsCircumference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Fettzange (mm)" 
                                                    Binding="{Binding FatTong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                    </DataGrid.Columns>
                    </DataGrid>
                   
                </GroupBox>
               

        </StackPanel>

            
        
    </Grid>
</Page>
