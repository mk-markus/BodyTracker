<Window x:Class="BodyTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BodyTracker" Height="600" Width="1100">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="Eingabe" Click="Eingabe_Click" Margin="0,0,8,0"/>
            <Button Content="Diagramm" Click="Diagramm_Click" Margin="0,0,8,0"/>
            <Button Content="Neu laden" Command="{Binding ReloadCommand}"/>
            <Button Content="Löschen" Click="OnDeleteClick" Margin="8,0,0,0"/>
            <Button Content="Schließen" Margin="16,0,0,0" Click="OnSchliessen"/>
            <TextBlock Text="  Benutzer: " Margin="16,0,0,0"/>
            <TextBlock Text="{Binding UserName}" FontWeight="Bold"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Measurement}" SelectedItem="{Binding SelectedMeasurement}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding MeasurementDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding BodyWeight, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="BMI" Binding="{Binding BMI, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Körperfett (%)" Binding="{Binding BodyFatPercentage, StringFormat=N1}" Width="120"/>
                <DataGridTextColumn Header="Muskelmasse (%)" Binding="{Binding BodyMusclePercentage, StringFormat=N1}" Width="120"/>
                <DataGridTextColumn Header="Viszeralfett" Binding="{Binding BodyVisceralFat}" Width="100"/>
                <DataGridTextColumn Header="Brustumfang (cm)" Binding="{Binding ChestCircumference, StringFormat=N2}" Width="140"/>
                <DataGridTextColumn Header="Bauchumfang (cm)" Binding="{Binding WaistCircumference, StringFormat=N2}" Width="140"/>
                <DataGridTextColumn Header="Hüftumfang (cm)" Binding="{Binding HipsCircumference, StringFormat=N2}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
