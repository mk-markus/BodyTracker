<Window x:Class="BodyTracker.Views.UserSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verbindung  Benutzer" Height="560" Width="660">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Datenbank-Verbindung" FontWeight="Bold"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Benutzer"/>
                <TextBox Grid.Column="1" x:Name="DbUserBox"/>
                <TextBlock Grid.Row="1" Text="Passwort" Margin="0,8,0,0"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="DbPassBox"/>
                <TextBlock Grid.Row="2" Text="Datenbank" Margin="0,8,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="DbDatenbank"/>
                <TextBlock Grid.Row="3" Text="Serveradresse" Margin="0,8,0,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="DbServer"/>
                <TextBlock Grid.Row="4" Text="Portnummer" Margin="0,8,0,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DbPort"/>

            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Verbindung speichern" Click="OnSaveCredentials"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Bitte Benutzer auswählen oder neu anlegen" FontWeight="Bold"/>

            <DataGrid Grid.Row="0" Margin="0,24,0,0" ItemsSource="{Binding Personen}" SelectedItem="{Binding Ausgewaehlt}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PersonID}" Width="60"/>
                    <DataGridTextColumn Header="Vorname" Binding="{Binding PersonFirstName}"/>
                    <DataGridTextColumn Header="Nachname" Binding="{Binding PersonLastName}"/>
                    <DataGridTextColumn Header="Geburtsdatum" Binding="{Binding PersonBirthDate, StringFormat=d}"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Neu anlegen" Margin="0,10,0,0">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Vorname" Margin="0,0,8,8"/>
                    <TextBox Grid.Column="1" Text="{Binding Vorname, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Nachname" Margin="0,8,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Nachname, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="Geburtsdatum" Margin="0,8,8,8"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Geburtsdatum}"/>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Neu anlegen" Command="{Binding NeuAnlegenCommand}" Margin="0,0,8,0"/>
                <Button Content="Weiter" Click="OnWeiter"/>
                <Button Content="Beenden" Click="OnBeenden" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>