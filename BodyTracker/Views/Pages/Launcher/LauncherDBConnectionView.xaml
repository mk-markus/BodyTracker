<Page x:Class="BodyTracker.Views.Pages.LauncherNewDatabaseConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:pswd="clr-namespace:BodyTracker.Services"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="{loc:Translate NewDatabaseConnectionPageTitle}">

    <Grid>
        <Border Style="{DynamicResource BorderDashboardCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{loc:Translate TxtDatabaseUser}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"/>

                <TextBox x:Name="DbUserBox"
                         Text="{Binding SqlUsername, Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource StandardNumericInputField}"
                         Width="200"
                         TextAlignment="Left"
                         Grid.Row="0"
                         Grid.Column="1"/>


                <TextBlock Text="{loc:Translate TxtDatabasePassword}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Row="1"
                           Grid.Column="0"
                           />

                <PasswordBox x:Name="pbPasswordBox"
                             pswd:PasswordBoxHelper.BindPassword="True"
                             pswd:PasswordBoxHelper.BoundPassword="{Binding SqlPassword, Mode=TwoWay, 
                             UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardPasswordBox}"
                             PasswordChar="*"
                             Width="200"
                             Grid.Row="1"
                             Grid.Column="1"/>

                <TextBlock Text="{loc:Translate TxtDatabaseNameLbl}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Row="2"
                           Grid.Column="0"/>

                <TextBox x:Name="DbDatenbank"
                         Text="{Binding SqlDatabaseName, Mode=TwoWay, 
                          UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource StandardNumericInputField}"
                         Width="200"
                         TextAlignment="Left"
                         Grid.Row="2"
                         Grid.Column="1"/>

                <TextBlock Text="{loc:Translate TxtSqlServerIp}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Row="3"
                           Grid.Column="0"/>

                <TextBox Text="{Binding SqlIpAddress, Mode=TwoWay, 
                          UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource StandardNumericInputField}"
                         Width="200"
                         TextAlignment="Left"             
                         Grid.Row="3"
                         Grid.Column="1"/>

                <TextBlock Text="{loc:Translate TxtSqlServerPort}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Row="4"
                           Grid.Column="0"/>

                <TextBox Text="{Binding SqlPort, Mode=TwoWay, 
                          UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource StandardNumericInputField}"
                         Width="200"
                         TextAlignment="Left"             
                         Grid.Row="4"
                         Grid.Column="1"/>

                <TextBlock Text="{Binding ValidationMessage}" 
                     Foreground="Red" 
                     Margin="8" 
                     TextWrapping="Wrap"
                     Grid.Column="0"
                     Grid.Row="6"
                     Grid.ColumnSpan="2"/>


                <StackPanel Orientation="Horizontal" 
                      HorizontalAlignment="Center" 
                      Margin="0,8,0,0"
                      Grid.Row="5"
                      Grid.Column="0"
                      Grid.ColumnSpan="2">

                    <Button x:Name="btnLogin"
                            Content="{loc:Translate BtnConnect}"
                            IsEnabled="{Binding IsFormValid}"
                            Style="{StaticResource SaveButton}"
                            Command="{Binding CommandLogin}"/>

                </StackPanel>

            </Grid>

        </Border>
    </Grid>
</Page>