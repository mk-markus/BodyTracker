<Page x:Class="BodyTracker.Views.Pages.LauncherSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:localError="clr-namespace:BodyTracker.Services.ErrorHandlingViews"
      xmlns:pswd="clr-namespace:BodyTracker.Services"
      xmlns:s="clr-namespace:BodyTracker.Resources.Languages"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="{loc:Translate LauncherSettingsViewTitle}">

    <Grid>
        <Border Style="{DynamicResource BorderDashboardCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{loc:Translate TxtApiKey}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"
                           Grid.Row="0"/>


                <StackPanel Grid.Column="1"
                            Grid.Row="0"
                            Orientation="Horizontal">

                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                             Grid.Column="1" Grid.Row="0"
                             Width="250"
                             TextAlignment="Center"
                             Style="{StaticResource ValidatableTextBoxStyle}"
                             localError:ValidationProperties.HasError="{Binding HasApiKeyError}"
                             localError:ValidationProperties.ErrorMessage="{Binding ApiKeyError}"/>

                    <Button Content="💾"
                            ToolTip="{loc:Translate BtnSaveApiKeyToolTip}"
                            FontSize="15"
                            Height="25"
                            Width="25"
                            Command="{Binding CommandSaveApiKey}"
                            Style="{DynamicResource IconStandardButton}"
                            Margin="10,0,0,0"/>
                </StackPanel>


                <TextBlock Text="{loc:Translate TxtDefaultImportFolder}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"
                           Grid.Row="1"/>


                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Orientation="Horizontal">

                    <TextBox Text="{Binding DefaultImportShortPath, Mode=TwoWay, 
                             UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource StandardTextBox}"
                             Width="250"
                             TextAlignment="Center"/>

                    <Button Content="..."
                            ToolTip="{loc:Translate BtnOpenDefaultFolderToolTip}"
                            FontSize="15"  Height="25" Width="25"
                            Command="{Binding CommandSelectDefaultImportFolder}"
                            Style="{DynamicResource IconStandardButton}"
                            Margin="10,0,0,0"/>

                </StackPanel>

                <TextBlock Text="{loc:Translate TxtLanguage}"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0" Grid.Row="2"/>
                
                <ComboBox ItemsSource="{Binding LanguagesList}"
                          SelectedItem="{Binding SelectedLanguagesItem, Mode=TwoWay}"
                          Style="{DynamicResource ModernFlatComboBox}"
                          Grid.Column="1"
                          Grid.Row="2"
                          Width="Auto"
                          Height="Auto"
                          Margin="5,0,0,0"
                          
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>


                <TextBlock Text="{Binding ValidationMessage}" 
                     Foreground="Red" 
                     Margin="8" 
                     TextWrapping="Wrap"
                     Grid.Column="0"
                     Grid.Row="6"
                     Grid.ColumnSpan="2"/>

            </Grid>

        </Border>
    </Grid>
</Page>