<Page x:Class="BodyTracker.Views.Pages.LauncherSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:localError="clr-namespace:BodyTracker.Services.ErrorHandlingViews"
      xmlns:pswd="clr-namespace:BodyTracker.Services"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="NewDatabaseConnectionPage">

    <Grid>
        <Border Style="{DynamicResource BorderDashboardCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="API_Key:"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"
                           Grid.Row="0"/>


                <StackPanel Grid.Column="1"
                            Grid.Row="0"
                            Orientation="Horizontal">
                    
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                             Grid.Column="1" Grid.Row="0"
                             Width="250"
                             TextAlignment="Center"
                             Style="{StaticResource ValidatableTextBoxStyle}"
                             localError:ValidationProperties.HasError="{Binding HasApiKeyError}"
                             localError:ValidationProperties.ErrorMessage="{Binding ApiKeyError}"/>

                    <Button Content="💾"
                            ToolTip="Save API Key"
                            FontSize="15"
                            Height="25"
                            Width="25"
                            Command="{Binding CommandSaveApiKey}"
                            Style="{DynamicResource IconStandardButton}"
                            Margin="10,0,0,0"/>
                </StackPanel>
         
                
                <TextBlock Text="Default Import Folder: "
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"
                           Grid.Row="1"/>


                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Orientation="Horizontal">

                    <TextBox Text="{Binding DefaultImportShortPath, Mode=TwoWay, 
                             UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource StandardTextBox}"
                             Width="250"
                             TextAlignment="Center"/>
                    
                    <Button Content="..."
                            ToolTip="Select Folder"
                            FontSize="15"  Height="25" Width="25"
                            Command="{Binding CommandSelectDefaultImportFolder}"
                            Style="{DynamicResource IconStandardButton}"
                            Margin="10,0,0,0"/>

                </StackPanel>

                <TextBlock Text="{Binding ValidationMessage}" 
                     Foreground="Red" 
                     Margin="8" 
                     TextWrapping="Wrap"
                     Grid.Column="0"
                     Grid.Row="6"
                     Grid.ColumnSpan="2"/>


                <!--<StackPanel Orientation="Horizontal" 
                      HorizontalAlignment="Center" 
                      Margin="0,8,0,0"
                      Grid.Row="5"
                      Grid.Column="0"
                      Grid.ColumnSpan="2">

                    <Button x:Name="btnSave"
                            Content="Save"
                            IsEnabled="{Binding IsFormValid}"
                            Style="{StaticResource SaveButton}"
                            Command="{Binding CommandSave}"/>-->

                <!--</StackPanel>-->

            </Grid>

        </Border>
    </Grid>
</Page>
