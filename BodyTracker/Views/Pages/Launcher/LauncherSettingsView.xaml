<Page x:Class="BodyTracker.Views.Pages.LauncherSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:localError="clr-namespace:BodyTracker.Services.ErrorHandlingViews"
      xmlns:pswd="clr-namespace:BodyTracker.Services"
      xmlns:s="clr-namespace:BodyTracker.Resources.Languages"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="{loc:Translate LauncherSettingsViewTitle}">

    <ScrollViewer >
        <Border Style="{DynamicResource BorderDashboardCardStyle}">

            <Grid ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Height="450">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0"
                        Grid.Row="0"
                        Style="{DynamicResource BorderDashboardCardStyle}"
                        Margin="0,0,0,10">

                    <StackPanel Grid.Column="1"
                                Grid.Row="0"
                                Orientation="Horizontal">

                        <TextBlock Text="{loc:Translate TxtApiKey}"
                                   Style="{DynamicResource TextBlockDescribing}"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Width="130"/>

                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Grid.Column="1" Grid.Row="0" Width="250"
                                 TextAlignment="Center"
                                 Style="{StaticResource ValidatableTextBoxStyle}"
                                 localError:ValidationProperties.HasError="{Binding HasApiKeyError}"
                                 localError:ValidationProperties.ErrorMessage="{Binding ApiKeyError}"/>

                        <Button Content="💾"
                                ToolTip="{loc:Translate BtnSaveApiKeyToolTip}"
                                FontSize="15" Height="25" Width="25"
                                Command="{Binding CommandSaveApiKey}"
                                Style="{DynamicResource IconStandardButton}"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="0" Grid.Row="1" Margin="0,0,0,10"
                        Style="{DynamicResource BorderDashboardCardStyle}">

                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">

                        <TextBlock Text="{loc:Translate TxtDefaultImportFolder}"
                                   Style="{DynamicResource TextBlockDescribing}"
                                   Grid.Column="0" Grid.Row="1"
                                    Width="130"/>

                        <TextBox Text="{Binding DefaultImportShortPath, Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                            Style="{DynamicResource StandardTextBox}"
                            Width="250"
                            TextAlignment="Center"/>

                        <Button Content="..."
                            ToolTip="{loc:Translate BtnOpenDefaultFolderToolTip}"
                            FontSize="15"  Height="25" Width="25"
                            Command="{Binding CommandSelectDefaultImportFolder}"
                            Style="{DynamicResource IconStandardButton}"
                            Margin="10,0,0,0"/>


                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="2" Style="{DynamicResource BorderDashboardCardStyle}"
                        Margin="0,0,0,10">

                    <StackPanel Grid.Column="1"
                                Grid.Row="2"
                                Orientation="Vertical">
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate TxtScaleUser}"
                                    Style="{DynamicResource TextBlockDescribing}"
                                    Grid.Column="0"
                                    Grid.Row="2"
                                    Width="130"/>

                            <TextBox Text="{Binding ScaleUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Column="1" Grid.Row="0"
                                    Width="250"
                                    TextAlignment="Center"
                                    Style="{StaticResource ValidatableTextBoxStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate TxtScaleUserPin}"
                                       Style="{DynamicResource TextBlockDescribing}"
                                       Grid.Column="0"
                                       Grid.Row="3"
                                        Width="130"/>


                            <StackPanel Grid.Column="1"
                                        Grid.Row="3"
                                        Orientation="Horizontal">

                                <PasswordBox pswd:PasswordBoxHelper.BindPassword="True"
                                            pswd:PasswordBoxHelper.BoundPassword="{Binding ScaleUserPin, Mode=TwoWay, 
                                            UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource StandardPasswordBox}"
                                            PasswordChar="*"
                                            Width="250"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalContentAlignment="Center"/>

                                <!--<Button Content="💾"
                                    ToolTip="{loc:Translate BtnSaveScaleUserPinToolTip}"
                                    FontSize="15"
                                    Height="25"
                                    Width="25"
                                    Command="{Binding CommandSaveScaleUserPin}"
                                    Style="{DynamicResource IconStandardButton}"
                                    Margin="10,0,0,0"/>-->
                            </StackPanel>
                        </StackPanel>
                        
                        <Button Content="{loc:Translate BtnSave}"
                                ToolTip="{loc:Translate BtnSaveScaleUserToolTip}"
                                FontSize="15"
                                Width="100"
                                Command="{Binding CommandSaveScaleUser}"
                                Style="{DynamicResource SaveButton}"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>



                <Border Grid.Column="0" Grid.Row="3" Style="{DynamicResource BorderDashboardCardStyle}"
                        Margin="0">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate TxtLanguage}"
                                    Style="{DynamicResource TextBlockDescribing}"
                                    Grid.Column="0" Grid.Row="4"  Width="130"/>

                        <ComboBox ItemsSource="{Binding LanguagesList}"
                                   SelectedItem="{Binding SelectedLanguagesItem, Mode=TwoWay}"
                                   Style="{DynamicResource ModernFlatComboBox}"
                                   Grid.Column="1"
                                   Grid.Row="4"
                                   Width="Auto"
                                  MinWidth="100"
                                   Height="Auto"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                   
                </Border>

                


                <TextBlock Text="{Binding ValidationMessage}" 
                     Foreground="Red" 
                     Margin="8" 
                     TextWrapping="Wrap"
                     Grid.Column="0"
                     Grid.Row="6"
                     Grid.ColumnSpan="2"/>

            </Grid>

        </Border>
    </ScrollViewer>
</Page>