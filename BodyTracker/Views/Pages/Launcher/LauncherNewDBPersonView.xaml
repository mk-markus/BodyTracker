<Page x:Class="BodyTracker.Views.Pages.LauncherNewDatabasePersonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewDatabasePersonPage">

    <Grid>
        <Border Style="{DynamicResource BorderDashboardCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="First name:"
                   Style="{DynamicResource TextBlockDescribing}"
                   Grid.Column="0"
                   Grid.Row="0"/>

                <TextBox x:Name="tbNewFirstName"
                         Style="{DynamicResource StandardNumericInputField}"
                         Width="200"
                         TextAlignment="Left"
                         Text="{Binding FirstName, Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="1"
                         Grid.Row="0"/>

                <TextBlock Text="Last Name:"
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"
                           Grid.Row="1" />

                <TextBox x:Name="tbNewLastName"
                         Style="{DynamicResource StandardNumericInputField}"
                         Width="200"
                         TextAlignment="Left"
                         Text="{Binding LastName, Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="1"
                         Grid.Row="1"/>

                <TextBlock  Text="Birth date:" 
                            Style="{DynamicResource TextBlockDescribing}"
                            Grid.Column="0"
                            Grid.Row="2"/>
                
                <DatePicker x:Name="dpBirthDate"
                            FontSize="12"
                            Width="200"
                            HorizontalAlignment="Left"
                            SelectedDate="{Binding BirthDate,Mode=TwoWay,                    
                                            UpdateSourceTrigger=PropertyChanged}"
                            Margin="3"
                            Grid.Column="1"
                            Grid.Row="2"/>

                <TextBlock Text="Person Height [m]:" 
                           Style="{DynamicResource TextBlockDescribing}"
                           Grid.Column="0"
                           Grid.Row="3"/>

                <TextBox Text="{Binding PersonHeight, Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NumericValidationStyle}"
                         Grid.Column="1"
                         Grid.Row="3"/>

                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Column="0"
                    Grid.Row="4"
                    Grid.ColumnSpan="2">

                    <Button x:Name="SaveNewUser"
                            Content="Create"                           
                            Style="{StaticResource SaveButton}" 
                            IsEnabled="{Binding IsNewPersonFormValid}"
                            Command="{Binding NewUserCommand}"/>

                   
                </StackPanel>

                <TextBlock Text="{Binding ValidationMessage}"
                   Foreground="Red" 
                   Margin="8" 
                   TextWrapping="Wrap"
                   FontSize="20"
                   Grid.Column="0"
                   Grid.Row="5"
                   Grid.ColumnSpan="2"/>

            </Grid>

        </Border>
    </Grid>
</Page>
