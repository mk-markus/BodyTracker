<Page x:Class="BodyTracker.Views.Pages.LauncherHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"

      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Translate LauncherHomePageTitle}">

    <!-- Main ScrollViewer to handle content overflow -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Top Section: Connection Status and Menu Controls -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bottom Section: Person Selection and Data Grid -->
            <Border Style="{DynamicResource BorderDashboardCardStyle}">

                <StackPanel Orientation="Vertical">


                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- DataGrid for displaying and editing available persons -->
                        <DataGrid x:Name="PersonGrid" 
                                  Grid.Row="0" 
                                  ItemsSource="{Binding Persons, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedPerson, 
                                                         Mode=TwoWay}"
                                  Style="{DynamicResource DataGrid_Default}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" 
                                  Margin="8"
                                  FontWeight="Normal"
                                  VerticalScrollBarVisibility="Auto"
                                  HeadersVisibility="Column"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  MinHeight="110"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  MouseDoubleClick="PersonGrid_MouseDoubleClick"
                                  >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="RowEditEnding">
                                    <i:InvokeCommandAction Command="{Binding CommandPersonRowEditEnding}"
                                  PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Translate GridHeaderPersonId}"
                                                    Binding="{Binding PersonID}"
                                                    Width="Auto"/>

                                <DataGridTextColumn Header="{loc:Translate GridHeaderFirstName}"
                                                    Binding="{Binding PersonFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="{loc:Translate GridHeaderLastName}" 
                                                    Binding="{Binding PersonLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="{loc:Translate GridHeaderBirthdate}" 
                                                    Binding="{Binding PersonBirthDate, Mode=TwoWay, 
                                                            StringFormat=d, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="{loc:Translate GridHeaderHeight}" 
                                                    Binding="{Binding PersonHeight, Mode=TwoWay, 
                                                            UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Load Data Action Button -->
                    <Button x:Name="LoadUserdata"
                            Content="{loc:Translate BtnLoadBodyData}"
                            Command="{Binding CommandLoadBodyTrackerToolAsync}"
                            Style="{DynamicResource StandardButton}"/>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>