<Page x:Class="BodyTracker.Views.Pages.Main.DBEntryExerciseView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DBEntryExerciseView">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource BorderDashboardCardStyle}"
                 Margin="0,10,0,10"
                 Grid.Column="0"
                 Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{loc:Translate TitleActions}"
                            Style="{DynamicResource TextBlockDashBoardTitle}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🗑"
                             ToolTip="{loc:Translate ToolTipDeleteSelectedEntry}"
                             Command="{Binding CommandDelete}"
                             Style="{DynamicResource IconStandardButton}" 
                             Margin="0,0,15,0"/>

                        <Button Content="🔄"
                             ToolTip="{loc:Translate ToolTipRefreshDatabaseDatas}"
                             Command="{Binding CommandRefresh}"
                             Style="{DynamicResource IconStandardButton}" />

                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                     Grid.Column="0"
                     Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="ExerciseGrid"
                                ItemsSource="{Binding ExerciseDatas}"
                                SelectedItem="{Binding SelectedData, Mode=TwoWay}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                SelectionUnit="FullRow"
                                SelectionMode="Single"
                                Margin="0,10,10,0"
                                FontWeight="Normal"
                                VerticalScrollBarVisibility="Auto"
                                HeadersVisibility="Column"
                                ScrollViewer.CanContentScroll="True"
                                EnableColumnVirtualization="True"
                                EnableRowVirtualization="True"
                                GridLinesVisibility="All"
                                Style="{StaticResource DataGrid_Default}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Translate ColDbId}" Binding="{Binding ExerciseID}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColLiveDataInternal}" Binding="{Binding LiveDataInternal}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMissionValue}" Binding="{Binding MissionValue}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColRaceTarget}" Binding="{Binding RaceTarget}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSubsetData}" Binding="{Binding SubsetData}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColStartLongitude}" Binding="{Binding StartLongitude, StringFormat=N6}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColRoutineDataUuid}" Binding="{Binding RoutineDataUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColTotalCalorie}" Binding="{Binding TotalCalorie, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCompletionStatus}" Binding="{Binding CompletionStatus}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColPaceInfoId}" Binding="{Binding PaceInfoId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColActivityType}" Binding="{Binding ActivityType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColPaceLiveData}" Binding="{Binding PaceLiveData}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSensingStatus}" Binding="{Binding SensingStatus}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSourceType}" Binding="{Binding SourceType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMissionType}" Binding="{Binding MissionType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColFtp}" Binding="{Binding Ftp, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColTrackingStatus}" Binding="{Binding TrackingStatus}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColProgramId}" Binding="{Binding ProgramId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColTitle}" Binding="{Binding Title}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColRewardStatus}" Binding="{Binding RewardStatus}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColHeartRateSampleCount}" Binding="{Binding HeartRateSampleCount}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColStartLatitude}" Binding="{Binding StartLatitude, StringFormat=N6}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMissionExtraValue}" Binding="{Binding MissionExtraValue}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColProgramScheduleId}" Binding="{Binding ProgramScheduleId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColHeartRateDeviceUuid}" Binding="{Binding HeartRateDeviceUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColLocationDataInternal}" Binding="{Binding LocationDataInternal}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCustomId}" Binding="{Binding CustomId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColAdditionalInternal}" Binding="{Binding AdditionalInternal}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDuration}" Binding="{Binding Duration}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColAdditional}" Binding="{Binding Additional}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCreateShVer}" Binding="{Binding CreateShVer}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMeanCaloricBurnRate}" Binding="{Binding MeanCaloricBurnRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColLocationData}" Binding="{Binding LocationData}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColExerciseType}" Binding="{Binding ExerciseType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCustom}" Binding="{Binding Custom}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxAltitude}" Binding="{Binding MaxAltitude, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColInclineDistance}" Binding="{Binding InclineDistance, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMeanHeartRate}" Binding="{Binding MeanHeartRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCountType}" Binding="{Binding CountType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMeanRpm}" Binding="{Binding MeanRpm, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMinAltitude}" Binding="{Binding MinAltitude, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColModifyShVer}" Binding="{Binding ModifyShVer}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxHeartRate}" Binding="{Binding MaxHeartRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColClientDataId}" Binding="{Binding ClientDataId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxPower}" Binding="{Binding MaxPower, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxSpeed}" Binding="{Binding MaxSpeed, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMeanCadence}" Binding="{Binding MeanCadence, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMinHeartRate}" Binding="{Binding MinHeartRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColClientDataVer}" Binding="{Binding ClientDataVer}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCount}" Binding="{Binding Count}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDistance}" Binding="{Binding Distance, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxCaloricBurnRate}" Binding="{Binding MaxCaloricBurnRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCalorie}" Binding="{Binding Calorie, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxCadence}" Binding="{Binding MaxCadence, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDeclineDistance}" Binding="{Binding DeclineDistance, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColVo2Max}" Binding="{Binding Vo2Max, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColTimeOffset}" Binding="{Binding TimeOffset}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMaxRpm}" Binding="{Binding MaxRpm, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColComment}" Binding="{Binding Comment}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColLiveData}" Binding="{Binding LiveData}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMeanPower}" Binding="{Binding MeanPower, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColMeanSpeed}" Binding="{Binding MeanSpeed, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColPkgName}" Binding="{Binding PkgName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColAltitudeGain}" Binding="{Binding AltitudeGain, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColAltitudeLoss}" Binding="{Binding AltitudeLoss, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColExerciseCustomType}" Binding="{Binding ExerciseCustomType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColAuxiliaryDevices}" Binding="{Binding AuxiliaryDevices}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColEndTime}" Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSweatLoss}" Binding="{Binding SweatLoss, StringFormat=N2}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>