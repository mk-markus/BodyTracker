<Page x:Class="BodyTracker.Views.Pages.Main.DBEntryFoodInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DBEntryFoodInfoView">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Style="{DynamicResource BorderDashboardCardStyle}"
                    Margin="0,10,0,10"
                    Grid.Column="0"
                    Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="🛠️ Actions"
                               Style="{DynamicResource TextBlockDashBoardTitle}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🗑"
                               ToolTip="Delete Selected Entry"
                               Command="{Binding CommandDelete}"
                               Style="{DynamicResource IconStandardButton}" 
                               Margin="0,0,15,0"/>

                        <Button Content="🔄"
                               ToolTip="Refresh Datas: Reload all datas from Database"
                               Command="{Binding CommandRefresh}"
                               Style="{DynamicResource IconStandardButton}" />

                    </StackPanel>
                </StackPanel>

            </Border>

            <Grid Grid.Column="0"
                  Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                        Grid.Column="0"
                        Grid.Row="0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="FoodInfoGrid"
                                  ItemsSource="{Binding FoodInfoDatas}"
                                  SelectedItem="{Binding SelectedData, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Single"
                                  Margin="0,10,10,0"
                                  FontWeight="Normal"
                                  VerticalScrollBarVisibility="Auto"
                                  HeadersVisibility="Column"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  GridLinesVisibility="All"
                                  Style="{StaticResource DataGrid_Default}">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="RowEditEnding">
                                    <i:InvokeCommandAction
                                        Command="{Binding CommandRowEditEnding}"
                                        PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <DataGrid.Columns>
                                <!-- General Info -->
                                <DataGridTextColumn Header="DB ID" Binding="{Binding Id}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Person ID" Binding="{Binding PersonId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Serving Description" Binding="{Binding ServingDescription}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Metric Serving Amount" Binding="{Binding MetricServingAmount, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Metric Serving Unit" Binding="{Binding MetricServingUnit}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Default Serving Unit" Binding="{Binding DefaultNumberOfServingUnit, StringFormat=N2}" IsReadOnly="True"/>

                                <!-- Nutritional Values -->
                                <DataGridTextColumn Header="Calories" Binding="{Binding Calorie, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Carbohydrates" Binding="{Binding Carbohydrate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Protein" Binding="{Binding Protein, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Total Fat" Binding="{Binding TotalFat, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Saturated Fat" Binding="{Binding SaturatedFat, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Monosaturated Fat" Binding="{Binding MonosaturatedFat, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Polysaturated Fat" Binding="{Binding PolysaturatedFat, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Trans Fat" Binding="{Binding TransFat}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sugar" Binding="{Binding Sugar, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Added Sugar" Binding="{Binding AddedSugar, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Dietary Fiber" Binding="{Binding DietaryFiber, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sodium" Binding="{Binding Sodium, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Potassium" Binding="{Binding Potassium, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Calcium" Binding="{Binding Calcium, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Iron" Binding="{Binding Iron, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Cholesterol" Binding="{Binding Cholesterol, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Vitamin A" Binding="{Binding VitaminA, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Vitamin C" Binding="{Binding VitaminC, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Vitamin D" Binding="{Binding VitaminD, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Unit Count / Calorie" Binding="{Binding UnitCountPerCalorie, StringFormat=N2}" IsReadOnly="True"/>

                                <!-- Metadata & Provider -->
                                <DataGridTextColumn Header="Provider Food ID" Binding="{Binding ProviderFoodId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Info Provider" Binding="{Binding InfoProvider}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding Custom}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Device UUID" Binding="{Binding DeviceUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Package Name" Binding="{Binding PkgName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Data UUID" Binding="{Binding DataUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Update At" Binding="{Binding UpdateTime}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Create At" Binding="{Binding CreateTime}" IsReadOnly="True"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>