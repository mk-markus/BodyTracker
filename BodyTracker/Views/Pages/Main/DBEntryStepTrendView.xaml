<Page x:Class="BodyTracker.Views.Pages.Main.DBEntryStepTrendView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DBEntryStepTrendView">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Style="{DynamicResource BorderDashboardCardStyle}"
                   Margin="0,10,0,10"
                   Grid.Column="0"
                   Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="🛠️ Actions"
                              Style="{DynamicResource TextBlockDashBoardTitle}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🗑"
                               ToolTip="Delete Selected Entry"
                               Command="{Binding CommandDelete}"
                               Style="{DynamicResource IconStandardButton}" 
                               Margin="0,0,15,0"/>

                        <Button Content="🔄"
                               ToolTip="Refresh Datas --> Reload all datas from Database"
                               Command="{Binding CommandRefresh}"
                               Style="{DynamicResource IconStandardButton}" />

                    </StackPanel>
                </StackPanel>

            </Border>

            <Grid Grid.Column="0"
                 Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                       Grid.Column="0"
                       Grid.Row="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!--<RowDefinition Height="*"/>-->
                        </Grid.RowDefinitions>

                        <!--<TextBlock Grid.Column="0"
                                  Grid.Row="0">
                           
                       <Run Text="Measurements from " 
                            FontWeight="SemiBold"
                            FontSize="12"/>
                       <Run Text="{Binding UserName}" 
                            FontWeight="Bold"
                            FontSize="15"/>

                       </TextBlock>-->

                        <DataGrid x:Name="StepTrendGrid"
                                  ItemsSource="{Binding StepTrendDatas, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedData, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Single"
                                  Margin="0,10,10,0"
                                  FontWeight="Normal"
                                  VerticalScrollBarVisibility="Auto"
                                  HeadersVisibility="Column"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  Height="Auto"
                                  GridLinesVisibility="All"
                                  Style="{StaticResource DataGrid_Default}"
                                  Grid.Column="0"
                                  Grid.Row="0">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="RowEditEnding">
                                    <i:InvokeCommandAction Command="{Binding CommandRowEditEnding}"
                                   PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="DB ID" Binding="{Binding StepTrendID}" IsReadOnly="True"/>

                                <DataGridTextColumn Header="ID" Binding="{Binding StepTrendID}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DayTime, StringFormat=dd.MM.yyyy}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Steps" Binding="{Binding Count}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Distance (m)" Binding="{Binding Distance, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Speed" Binding="{Binding Speed, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Calories" Binding="{Binding Calorie, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Source Package" Binding="{Binding SourcePkgName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Device UUID" Binding="{Binding DeviceUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Package Name" Binding="{Binding PkgName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Data UUID" Binding="{Binding DataUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Updated" Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Binning Data" Binding="{Binding BinningData}" IsReadOnly="True"/>
                            </DataGrid.Columns>

                        </DataGrid>


                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
