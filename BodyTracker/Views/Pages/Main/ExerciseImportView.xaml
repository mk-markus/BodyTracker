<Page x:Class="BodyTracker.Views.Pages.Main.ExerciseImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      Title="Exercise">

    <Border Style="{DynamicResource BorderDashboardCardStyle}" Margin="0,10,0,0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                <Button Content="🔄" ToolTip="{loc:Translate ToolTipRefresh}" Command="{Binding CommandRefresh}" Style="{DynamicResource IconStandardButton}" />
                <Button Content="📁" ToolTip="{loc:Translate ToolTipOpenFileDialog}" Command="{Binding CommandOpen}" Style="{DynamicResource IconStandardButton}" />
                <Button Content="📤" ToolTip="{loc:Translate ToolTipInsertDatabase}" Command="{Binding CommandInsert}" Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}" Margin="10" TextAlignment="Center" Style="{DynamicResource TextBlockDescribing}" />
                    <TextBlock Text="{Binding ProgressText}" TextAlignment="Center" Style="{DynamicResource TextBlockDescribing}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding ExerciseDatas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource DataGrid_Default}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate ColCompletionStatus}" Binding="{Binding CompletionStatus}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColSourceType}" Binding="{Binding SourceType}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMissionType}" Binding="{Binding MissionType}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColTitle}" Binding="{Binding Title}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColStartLongitude}" Binding="{Binding StartLongitude}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColHeartRateSampleCount}" Binding="{Binding HeartRateSampleCount}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColStartLatitude}" Binding="{Binding StartLatitude}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDuration}" Binding="{Binding Duration}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCreateShVer}" Binding="{Binding CreateShVer}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMeanCaloricBurnRate}" Binding="{Binding MeanCaloricburnRate}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime,StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColExerciseType}" Binding="{Binding ExerciseType}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxAltitude}" Binding="{Binding MaxAltitude}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColInclineDistance}" Binding="{Binding InclineDistance}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMeanHeartRate}" Binding="{Binding MeanHeartRate}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCountType}" Binding="{Binding CountType}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMeanRpm}" Binding="{Binding MeanRpm}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMinAltitude}" Binding="{Binding MinAltitude}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColModifyShVer}" Binding="{Binding ModifyShVer}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxHeartRate}" Binding="{Binding MaxHeartRate}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime,StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime,StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColClientDataId}" Binding="{Binding ClientDataId}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxPower}" Binding="{Binding MaxPower}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxSpeed}" Binding="{Binding MaxSpeed}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMeanCadence}" Binding="{Binding MeanCadence}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMinHeartRate}" Binding="{Binding MinHeartRate}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColClientDataVer}" Binding="{Binding ClientDataVer}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCount}" Binding="{Binding Count}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDistance}" Binding="{Binding Distance}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCalorie}" Binding="{Binding Calorie}" Width="100"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxCadence}" Binding="{Binding MaxCadence}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDeclineDistance}" Binding="{Binding DeclineDistance}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColVo2Max}" Binding="{Binding Vo2Max}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxRpm}" Binding="{Binding MaxRpm}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColComment}" Binding="{Binding Comment}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMeanPower}" Binding="{Binding MeanPower}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMeanSpeed}" Binding="{Binding MeanSpeed}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColPkgName}" Binding="{Binding PkgName}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColAltitudeGain}" Binding="{Binding AltitudeGain}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColAltitudeLoss}" Binding="{Binding AltitudeLoss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColEndTime}" Binding="{Binding EndTime,StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColSweatLoss}" Binding="{Binding SweatLoss}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>