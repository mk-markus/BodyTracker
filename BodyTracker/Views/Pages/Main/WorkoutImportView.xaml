<Page x:Class="BodyTracker.Views.Pages.WorkoutImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:BodyTracker.ViewModels"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      Title="Hevy App CSC Import">

    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Controls -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="10">

                <Button Content="📥"
                        ToolTip="{loc:Translate ToolTipDownloadHevy}"
                        Command="{Binding CommandDownload}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📁"
                        ToolTip="{loc:Translate ToolTipOpenHevyCsv}"
                        Command="{Binding CommandOpen}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📤"  
                        ToolTip="{loc:Translate ToolTipInsertDatabase}"
                        Command="{Binding CommandInsert}"
                        Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}"
                               Margin="10"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                    <TextBlock Text="{Binding ProgressText}"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />
                </WrapPanel>
            </StackPanel>

            <!-- Data Preview -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding HevyAppDatas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="10"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate ColTitle}" Binding="{Binding Title}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColEndTime}" Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDescription}" Binding="{Binding Description}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColExerciseTitle}" Binding="{Binding ExerciseTitle}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSupersetId}" Binding="{Binding SupersetId}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColExerciseNotes}" Binding="{Binding ExerciseNotes}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSetIndex}" Binding="{Binding SetIndex}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSetType}" Binding="{Binding SetType}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColWeightKg}" Binding="{Binding WeightKg, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColReps}" Binding="{Binding Reps}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDistanceKm}" Binding="{Binding DistanceKm, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDurationSeconds}" Binding="{Binding DurationSeconds}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColRpe}" Binding="{Binding Rpe, StringFormat=F1}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDataUuidCap}" Binding="{Binding DataUuid}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>