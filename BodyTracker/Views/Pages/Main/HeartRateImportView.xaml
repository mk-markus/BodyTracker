<Page x:Class="BodyTracker.Views.Pages.Main.HeartRateImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      Title="Heart Rate">

    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="10">


                <Button Content="🔄"
                        ToolTip="{loc:Translate ToolTipRefresh}"
                        Command="{Binding CommandRefresh}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📁"
                        ToolTip="{loc:Translate ToolTipOpenFileDialog}"
                        Command="{Binding CommandOpen}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📤"
                        ToolTip="{loc:Translate ToolTipInsertDatabase}"
                        Command="{Binding CommandInsert}"
                        Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}"
                               Margin="10"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                    <TextBlock Text="{Binding ProgressText}"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                </WrapPanel>

            </StackPanel>

            <DataGrid Grid.Row="1"
                    ItemsSource="{Binding HeartRateDatas}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="{loc:Translate ColSource}"
                                        Binding="{Binding Source}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColTagId}"
                                        Binding="{Binding TagId}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColCreateShVer}"
                                        Binding="{Binding CreateShVer}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColHeartBeatCount}"
                                        Binding="{Binding HeartBeatCount}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColStartTime}"
                                        Binding="{Binding StartTime,StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColCustom}"
                                        Binding="{Binding Custom}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColBinningData}"
                                        Binding="{Binding BinningData}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColModifyShVer}"
                                        Binding="{Binding ModifyShVer}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColUpdateTime}"
                                        Binding="{Binding UpdateTime,StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColCreateTime}"
                                        Binding="{Binding CreateTime,StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColClientDataId}"
                                        Binding="{Binding ClientDataId}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColHeartRateMax}"
                                        Binding="{Binding HeartRateMax}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColHeartRateMin}"
                                        Binding="{Binding HeartRateMin}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColClientDataVer}"
                                        Binding="{Binding ClientDataVer}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColTimeOffset}"
                                        Binding="{Binding TimeOffset}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}"
                                        Binding="{Binding DeviceUuid}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColComment}"
                                        Binding="{Binding Comment}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColPkgName}"
                                        Binding="{Binding PkgName}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColEndTime}"
                                        Binding="{Binding EndTime,StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColDataUuid}"
                                        Binding="{Binding DataUuid}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="{loc:Translate ColHeartRate}"
                                        Binding="{Binding HeartRate}"
                                        Width="Auto"/>

                </DataGrid.Columns>

            </DataGrid>
        </Grid>

    </Border>
</Page>