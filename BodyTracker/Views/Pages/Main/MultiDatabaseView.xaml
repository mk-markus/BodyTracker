<Page x:Class="BodyTracker.Views.Pages.Main.MultiDatabaseView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiDatabaseView">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Sidebar -->
        <Border Grid.Column="0"
             Grid.Row="0"
             Style="{DynamicResource BorderDashboardCardStyle}">

            <StackPanel VerticalAlignment="Top"
                     HorizontalAlignment="Left"
                     Orientation="Horizontal">

                <!-- ================= SHOW DATABASE ENTRIES MEASUREMENT ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowBodyMeasurementEntryView}"
                             GroupName="ImportSelection"
                             IsChecked="True"
                             ToolTip="{loc:Translate ToolTipMeasurementDatabaseEntries}">

                    <TextBlock Text="{loc:Translate NavBodyMeasurement}"
               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES SAMSUNG FOOD INTAKE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                          Command="{Binding CommandShowFoodIntakeEntryView}"
                          GroupName="ImportSelection"
                          IsChecked="False"
                          ToolTip="{loc:Translate ToolTipFoodIntakeEntries}">

                    <TextBlock Text="{loc:Translate NavFoodIntake}"
                            Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES SAMSUNG FOOD INFO ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                          Command="{Binding CommandShowFoodInfoEntryView}"
                          GroupName="ImportSelection"
                          IsChecked="False"
                          ToolTip="{loc:Translate ToolTipFoodInfoEntries}">

                    <TextBlock Text="{loc:Translate NavFoodInfo}"
                            Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES SAMSUNG DAILY STEP ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                          Command="{Binding CommandShowStepTrendEntryView}"
                          GroupName="ImportSelection"
                          ToolTip="{loc:Translate ToolTipDailyStepsEntries}">

                    <TextBlock Text="{loc:Translate NavDailyStep}"
                            Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES SAMSUNG EXERCISE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                          Command="{Binding CommandShowExerciseEntryView}"
                          GroupName="ImportSelection"
                          ToolTip="{loc:Translate ToolTipExerciseEntries}">

                    <TextBlock Text="{loc:Translate NavExercise}"
                            Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES SAMSUNG HEART RATE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                          Command="{Binding CommandShowHeartRateEntryView}"
                          GroupName="ImportSelection"
                          ToolTip="{loc:Translate ToolTipHeartRateEntries}">

                    <TextBlock Text="{loc:Translate NavHeartRate}"
                            Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES SAMSUNG OXYGEN SATURATION ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                          Command="{Binding CommandOxygenSaturationEntryView}"
                          GroupName="ImportSelection"
                          ToolTip="{loc:Translate ToolTipOxygenSaturationEntries}">

                    <TextBlock  Text="{loc:Translate NavSpO2}"
                                Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DATABASE ENTRIES Hevy APP ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                          Command="{Binding CommandShowHevyAppEntryView}"
                          GroupName="ImportSelection"
                          ToolTip="{loc:Translate ToolTipHevyEntries}">

                    <TextBlock Text="{loc:Translate NavGym}"
                            Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

            </StackPanel>
        </Border>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="1">
            <Frame x:Name="MainChartContent" 
                Content="{Binding CurrentPage}"
                NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>