<Page x:Class="BodyTracker.Views.Pages.FoodNutritionImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      Title="Food Nutrition Import">
    
    <Border Style="{DynamicResource BorderDashboardCardStyle}" Margin="0,10,0,0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                <Button Content="🔄" ToolTip="{loc:Translate ToolTipRefresh}" Command="{Binding CommandRefresh}" Style="{DynamicResource IconStandardButton}" />
                <Button Content="📁" ToolTip="{loc:Translate ToolTipOpenFileDialog}" Command="{Binding CommandOpen}" Style="{DynamicResource IconStandardButton}" />
                <Button Content="📤" ToolTip="{loc:Translate ToolTipInsertDatabase}" Command="{Binding CommandInsert}" Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}" Margin="10" TextAlignment="Center" Style="{DynamicResource TextBlockDescribing}" />
                    <TextBlock Text="{Binding ProgressText}" TextAlignment="Center" Style="{DynamicResource TextBlockDescribing}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding FoodNutritionDatas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                      CanUserDeleteRows="False" Margin="10" Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="{loc:Translate ColTitle}" Binding="{Binding Title}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColCalorie}" Binding="{Binding Calorie, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColProtein}" Binding="{Binding Protein, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCarbohydrate}" Binding="{Binding Carbohydrate, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColTotalFat}" Binding="{Binding TotalFat, StringFormat=F2}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColSaturatedFat}" Binding="{Binding SaturatedFat, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColUnsaturatedFat}" Binding="{Binding UnsaturatedFat, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColMonosaturatedFat}" Binding="{Binding MonosaturatedFat, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPolyunsaturatedFat}" Binding="{Binding PolyunsaturatedFat, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPolysaturatedFat}" Binding="{Binding PolysaturatedFat, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColTransFat}" Binding="{Binding TransFat, StringFormat=F2}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColSugar}" Binding="{Binding Sugar, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColAddedSugar}" Binding="{Binding AddedSugar, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDietaryFiber}" Binding="{Binding DietaryFiber, StringFormat=F2}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColCholesterol}" Binding="{Binding Cholesterol, StringFormat=F2}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColSodium}" Binding="{Binding Sodium, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPotassium}" Binding="{Binding Potassium, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCalcium}" Binding="{Binding Calcium, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColMagnesium}" Binding="{Binding Magnesium, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPhosphorus}" Binding="{Binding Phosphorus, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColIron}" Binding="{Binding Iron, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColZinc}" Binding="{Binding Zinc, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCopper}" Binding="{Binding Copper, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColManganese}" Binding="{Binding Manganese, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSelenium}" Binding="{Binding Selenium, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColChromium}" Binding="{Binding Chromium, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColMolybdenum}" Binding="{Binding Molybdenum, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColIodine}" Binding="{Binding Iodine, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColChloride}" Binding="{Binding Chloride, StringFormat=F6}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColVitaminA}" Binding="{Binding VitaminA, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColVitaminB6}" Binding="{Binding VitaminB6, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColVitaminB12}" Binding="{Binding VitaminB12, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColVitaminC}" Binding="{Binding VitaminC, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColVitaminD}" Binding="{Binding VitaminD, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColVitaminE}" Binding="{Binding VitaminE, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColVitaminK}" Binding="{Binding VitaminK, StringFormat=F6}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColThiamin}" Binding="{Binding Thiamin, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColRiboflavin}" Binding="{Binding Riboflavin, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColNiacin}" Binding="{Binding Niacin, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColBiotin}" Binding="{Binding Biotin, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColFolate}" Binding="{Binding Folate, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColFolicAcid}" Binding="{Binding FolicAcid, StringFormat=F6}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPantothenicAcid}" Binding="{Binding PantothenicAcid, StringFormat=F6}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColCaffeine}" Binding="{Binding Caffeine, StringFormat=F6}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColMealType}" Binding="{Binding MealType}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColTimeOffset}" Binding="{Binding TimeOffset}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColCreateShVersion}" Binding="{Binding CreateShVer}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColModifyShVersion}" Binding="{Binding ModifyShVer}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColCustom}" Binding="{Binding Custom}" Width="Auto" />

                    <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPkgName}" Binding="{Binding PkgName}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" Width="Auto" />

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>