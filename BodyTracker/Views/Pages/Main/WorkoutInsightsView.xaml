<Page x:Class="BodyTracker.Views.Pages.PersonalWorkoutInsightsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views"
      mc:Ignorable="d"
      Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"  Padding="0"
            HorizontalScrollBarVisibility="Auto"
                Margin="0,10,0,0">
        <Grid MaxWidth="1550"
        Margin="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= TIMESPAN SECTION | EXERCISE PROGRESS SELECTION | TOTAL WORKOUTS AND EXERCISE VOLUME OVERVIEW ================= -->
            <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= TIMESPAN SECTION ================= -->
                <Border Grid.Row="0" Style="{StaticResource BorderDashboardCardStyle}" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📅 Timespan" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernFlatDatePicker}"/>

                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernFlatDatePicker}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <!-- ================= TOGGLE BUTTON QUICK DATE RANGES ================= -->
                            <ToggleButton x:Name="DateShortCuts"
                                       Style="{DynamicResource ModernStandardToggleButton}"
                                       Content="📅 Quick Ranges ▼ "
                                       Margin="0,10,0,0"
                                      HorizontalAlignment="Left"
                                       ToolTip="Filters the chart to show data exclusively for the current year."/>

                            <Button Content="🔄"
                                ToolTip="Refresh Datas: Reload all datas from Database"
                                Command="{Binding CommandRefresh}"
                                Style="{DynamicResource IconStandardButton}" 
                                Margin="10,10,0,0"/>


                        </StackPanel>
                        <!-- ================= POPUP QUICK DATE RANGES ================= -->
                        <Popup PlacementTarget="{Binding ElementName=DateShortCuts}"
                                Placement="Bottom"
                                StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=DateShortCuts}" 
                                AllowsTransparency="True">

                            <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                     Width="{Binding ActualWidth, ElementName=DateShortCuts}">

                                <StackPanel>

                                    <Button Content="📅 Year" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandSetActualYear}" 
                                             ToolTip="Filter chart data for the current year."
                                             Margin="0,0,0,0"/>

                                    <Button Content="📆 Week" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandSetActualWeek}" 
                                             ToolTip="Filter chart data for the current week."
                                             Margin="0,5,0,0"/>

                                    <Button Content="🗓️ Month" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandSetActualMonth}" 
                                             ToolTip="Filter chart data for the current month."
                                             Margin="0,5,0,0"/>

                                    <!--<Button Content="🌍 All Time" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandShowAllData}" 
                                             ToolTip="Display the complete historical dataset without time restrictions."
                                             Margin="0,5,0,0"/>-->
                                </StackPanel>
                            </Border>
                        </Popup>

                    </StackPanel>
                </Border>

                <!-- ================= EXERCISE PROGRESS SELECTION ================= -->
                <Border Grid.Row="1" Style="{DynamicResource BorderDashboardCardStyle}" Padding="10" Margin="0,0,0,10">
                    <StackPanel Margin="0">
                        <TextBlock Text="🎯 Exercise Progress Selection" Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ExercisesList}"
                      SelectedItem="{Binding SelectedExerciseItem, Mode=TwoWay}"
                      Style="{DynamicResource ModernFlatComboBox}"/>
                    </StackPanel>
                </Border>

                <!-- ================= TOTAL WORKOUTS AND EXERCISE VOLUME OVERVIEW ================= -->
                <Border Grid.Row="2" Style="{DynamicResource BorderDashboardCardStyle}" Padding="10" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Workouts Box -->
                        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🏋️ Workouts" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalWorkouts}" FontSize="22" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Volume Box -->
                        <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📊 Total Volume" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalWorkoutsVolume}" FontSize="18" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>

       
            <!-- ================= MOST DONE EXERCISES ================= -->
            <Border Grid.Column="1"
                    Grid.Row="0"
                    Padding="10"
                    Margin="0,0,10,0" 
                    Height="{Binding ActualHeight, ElementName=TimeSECTION}"
                    Style="{DynamicResource BorderDashboardCardStyle}">
                <StackPanel Margin="16">
                    <TextBlock Text="🔥 Most Done Exercises" 
                                   Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}" 
                                   Margin="0,0,0,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                        <ItemsControl ItemsSource="{Binding TopExercises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Exercise Name -->
                                        <TextBlock Grid.Column="0" Style="{DynamicResource TextBlockDescribing}" 
                                                       Text="{Binding ExerciseName}" 
                                                       VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis"/>

                                        <!-- ProgressBar -->
                                        <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="1" 
                                                         Value="{Binding Percentage}" 
                                                         VerticalAlignment="Center" 
                                                         Margin="10,0" 
                                                         Foreground="#38BDF8" 
                                                         Background="Transparent"/>

                                        <!-- Percentage -->
                                        <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat={}{0:P0}}" 
                                                       Style="{DynamicResource TextBlockWorkoutInsightsPercentageStyle}" 
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= Muscle Distribution Spider Chart ================= -->
            <Border Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.Column="2"
                     Grid.ColumnSpan="2"
                     Style="{DynamicResource BorderDashboardCardStyle}"
                     Margin="0,00,0,0">

                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="💪 Workout Muscle Distribution (MoM)" 
                                Grid.Column="0"
                                Grid.Row="0"
                                Style="{DynamicResource TextBlockDashBoardTitle}" 
                                Margin="0,0,0,10"/>

                    <lvc:PolarChart Grid.Column="0"
                         Grid.Row="1"
                         MinHeight="1"
                         MinWidth="1"
                         Height="Auto"
                         Width="Auto"
                         LegendPosition="Hidden"
                         LegendTextSize="10"
                         
                         Series="{Binding SeriesMuscleDistributionSpiderChart}" 
                         AngleAxes="{Binding AngleAxisMuscleDistirbutionSpiderChart}"
                         RadiusAxes="{Binding RadiusAxisMuscleDistirbutionSpiderChart}"/>
                </Grid>
            </Border>


            <!-- ================= PEAK VOLUME ================= -->
            <Border Style="{DynamicResource BorderDashboardCardStyle}" 
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Grid.Row="2"
                    Padding="10"
                    Margin="0,10,0,0">
                
                <StackPanel Margin="16">
                    <TextBlock Text="📈 Peak Weight Progress" 
                               Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}" 
                               Margin="0,0,0,12"/>
                    <lvc:CartesianChart Height="250" 
                                       Series="{Binding SeriesWorkoutPeakProgress}" 
                                       XAxes="{Binding XAxesWorkoutPeakProgress}" 
                                       YAxes="{Binding YAxesWorkoutPeakProgress}" 
                                       LegendPosition="Hidden"
                                       />
                </StackPanel>
            </Border>

            <!-- ================= TOTAL VOLUME ================= -->
            <Border Style="{DynamicResource BorderDashboardCardStyle}" 
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Grid.Row="3"
                    Padding="10"
                    Margin="0,10,0,0">
                
                <StackPanel Margin="16">
                    <TextBlock Text="📈 Total Volume Progress" 
                               Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}" 
                               Margin="0,0,0,12"/>
                    <lvc:CartesianChart Height="250" 
                                       Series="{Binding SeriesWorkoutTotalVolumeProgress}" 
                                       XAxes="{Binding XAxesWorkoutTotalVolumeProgress}" 
                                       YAxes="{Binding YAxesWorkoutTotalVolumeProgress}" 
                                       LegendPosition="Hidden"/>
                </StackPanel>
            </Border>

            <!-- ================= MAX REPs VOLUME ================= -->
            <Border Style="{DynamicResource BorderDashboardCardStyle}" 
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Grid.Row="4"
                    Padding="10"
                    Margin="0,10,0,0">
                
                <StackPanel Margin="16">
                    <TextBlock Text="📈 Max Reps Progress" 
                               Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}" 
                               Margin="0,0,0,12"/>
                    <lvc:CartesianChart Height="250" 
                                       Series="{Binding SeriesWorkoutMaxRepProgress}" 
                                       XAxes="{Binding XAxesWorkoutMaxRepProgress}" 
                                       YAxes="{Binding YAxesWorkoutMaxRepProgress}" 
                                       LegendPosition="Hidden"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>