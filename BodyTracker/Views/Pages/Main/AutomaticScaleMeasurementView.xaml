<Page x:Class="BodyTracker.Views.Pages.Main.AutomaticScaleMeasurementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d"
      Title="PopupAutoMeasurement"
      Background="White">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Soft pulse animation for the active scale scanning state -->
        <Storyboard x:Key="ActiveScanAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanIndicatorScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.25" Duration="0:0:1" 
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ScanIndicatorScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.25" Duration="0:0:1" 
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ScanIndicatorGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.7" Duration="0:0:1" 
                             AutoReverse="True"/>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource ActiveScanAnimation}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main content area in dashboard card style -->
        <Border Grid.Row="1" Style="{DynamicResource BorderDashboardCardStyle}" 
                Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" 
                CornerRadius="12" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. HEADER SECTION -->
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="{Binding TxtScaleHeaderBadge}" 
                               Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" FontSize="12" 
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding TxtScaleHeaderTitle}" 
                               FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 2. BODY TEXT OR SUCCESS VIEW -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">

                    <!-- Introductory body text (Not visible if IsScaleMeasurementFinished = true) -->
                    <TextBlock Text="{Binding TxtScaleIntro}" 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleMeasurementFinished}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Border mit Schritten (Not visible if IsScaleMeasurementFinished = true) -->
                    <Border Background="{StaticResource SidebarBackgroundBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10" 
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleMeasurementFinished}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding CurrentScaleIconStepsList}" FontSize="18" HorizontalAlignment="Left" 
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Success view (Only visible if IsScaleMeasurementFinished = true) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Visibility="{Binding IsScaleMeasurementFinished, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">

                        <!-- Large circle with checkmark -->
                        <Border Width="90" Height="90" Background="{StaticResource AccentTealBrush}" CornerRadius="45" 
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="✓" FontSize="50" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Border>

                        <!-- Description below the checkmark -->
                        <TextBlock Text="{Binding TxtScaleIntro}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Countdown text -->
                        <TextBlock Text="{Binding TxtScaleCountdownText}" Foreground="{StaticResource AccentBlueBrush}" 
                                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 3. BOTTOM SECTION: ANIMATED SCAN INDICATOR (Not visible if IsScaleMeasurementFinished = true) -->
                <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}" 
                        CornerRadius="12" Padding="20,16" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrushColor}" 
                        BorderThickness="1">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScaleMeasurementFinished}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- The scan animation -->
                        <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,15,0" VerticalAlignment="Center">
                            <Ellipse x:Name="ScanIndicatorGlow" Width="36" Height="36" Fill="{StaticResource AccentTealBrush}" 
                                     Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="ScanIndicatorScale" ScaleX="1" ScaleY="1" CenterX="18" CenterY="18"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" 
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TxtScaleStatusMessage}" 
                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" 
                                       FontSize="14" Margin="0,0,0,6"/>
                            <ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBlueBrush}" 
                                         Background="{StaticResource BorderBrushColor}" BorderBrush="{x:Null}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom action bar with defined spacing -->
        <StackPanel Grid.Row="2"
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Margin="0,10,0,10">

            <Button Style="{DynamicResource ModernStandardButton}"
                    Content="{loc:Translate BtnConfirm}"
                    Command="{Binding CommandConfirm}" IsEnabled="{Binding IsScaleMeasurementFinished}" 
                    Visibility="{Binding IsScaleMeasurementFinished, Converter={StaticResource bool2VisibilityConverter}, FallbackValue=Collapsed}"
                    Margin="5,0"/>
            
            <Button Style="{DynamicResource ModernStandardButton}"
                    Content="{loc:Translate BtnCancel}"
                    Command="{Binding CommandCancel}"
                    Margin="5,0"/>

        </StackPanel>
    </Grid>
</Page>