<Page x:Class="BodyTracker.ViewModels.Main.OxygenSaturationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.ViewModels.Main"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OxygenSaturationViewModel">

    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="10">

                <Button Content="🔄"
                        ToolTip="Refresh"
                        Command="{Binding CommandRefresh}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📁"
                        ToolTip="Open File Dialog"
                        Command="{Binding CommandOpen}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📤"
                        ToolTip="Insert Datas in Database"
                        Command="{Binding CommandInsert}"
                        Style="{DynamicResource IconStandardButton}" />

                <!--<ProgressBar Height="25"
                             MinWidth="100"
                             IsIndeterminate="True"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding IsLoading, Converter={StaticResource bool2VisibilityConverter}}"
                             Style="{DynamicResource ProgressbarCurrentBarValue}" />-->

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}"
                               Margin="10"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                    <TextBlock Text="{Binding ProgressText}"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                </WrapPanel>
                
            </StackPanel>

            <DataGrid Grid.Row="1"
                    ItemsSource="{Binding OxygenSaturationDatas}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="integrated__id"
                                        Binding="{Binding IntegratedId}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="source"
                                        Binding="{Binding Source}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="tag_id"
                                        Binding="{Binding TagId}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="coverage__rate"
                                        Binding="{Binding CoverageRate}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.create__sh__ver"
                                        Binding="{Binding CreateShVer}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.start__time"
                                        Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.custom"
                                        Binding="{Binding Custom}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.modify__sh__ver"
                                        Binding="{Binding ModifyShVer}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.update__time"
                                        Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.create__time"
                                        Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.client__data__id"
                                        Binding="{Binding ClientDataId}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.low__duration"
                                        Binding="{Binding LowSpO2Duration}"
                                        Width="Auto"/>
                    
                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.binning"
                                        Binding="{Binding Binning}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.max"
                                        Binding="{Binding SpO2Max, StringFormat=F2}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.min"
                                        Binding="{Binding SpO2Min, StringFormat=F2}"
                                        Width="Auto"/>
                    
                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.spo2"
                                        Binding="{Binding SpO2, StringFormat=F2}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.client__data__ver"
                                        Binding="{Binding ClientDataVer}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.time__offset"
                                        Binding="{Binding TimeOffset}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.deviceuuid"
                                        Binding="{Binding DeviceUuid}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.comment"
                                        Binding="{Binding Comment}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.pkg__name"
                                        Binding="{Binding PackageName}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.end__time"
                                        Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.datauuid"
                                        Binding="{Binding DataUuid}"
                                        Width="Auto"/>

                    <DataGridTextColumn Header="com.samsung.health.oxygen__saturation.heart__rate"
                                        Binding="{Binding HeartRate, StringFormat=F2}"
                                        Width="Auto"/>

                </DataGrid.Columns>

            </DataGrid>
        </Grid>

    </Border>
</Page>
