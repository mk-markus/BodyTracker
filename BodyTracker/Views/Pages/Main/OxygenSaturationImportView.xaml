<Page x:Class="BodyTracker.ViewModels.Main.OxygenSaturationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.ViewModels.Main"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OxygenSaturationViewModel">

    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="10">

                <Button Content="🔄"
                        ToolTip="{loc:Translate ToolTipRefresh}"
                        Command="{Binding CommandRefresh}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📁"
                        ToolTip="{loc:Translate ToolTipOpenFileDialog}"
                        Command="{Binding CommandOpen}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📤"
                        ToolTip="{loc:Translate ToolTipInsertDatabase}"
                        Command="{Binding CommandInsert}"
                        Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}"
                               Margin="10"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                    <TextBlock Text="{Binding ProgressText}"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="1"
                    ItemsSource="{Binding OxygenSaturationDatas}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate ColIntegratedId}" Binding="{Binding IntegratedId}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColSource}" Binding="{Binding Source}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColTagId}" Binding="{Binding TagId}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCoverageRate}" Binding="{Binding CoverageRate}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCreateShVer}" Binding="{Binding CreateShVer}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCustom}" Binding="{Binding Custom}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColModifyShVer}" Binding="{Binding ModifyShVer}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColClientDataId}" Binding="{Binding ClientDataId}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColLowDuration}" Binding="{Binding LowSpO2Duration}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColBinning}" Binding="{Binding Binning}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMaxSpO2}" Binding="{Binding SpO2Max, StringFormat=F2}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColMinSpO2}" Binding="{Binding SpO2Min, StringFormat=F2}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColSpO2}" Binding="{Binding SpO2, StringFormat=F2}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColClientDataVer}" Binding="{Binding ClientDataVer}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColTimeOffset}" Binding="{Binding TimeOffset}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColComment}" Binding="{Binding Comment}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColPackageName}" Binding="{Binding PackageName}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColEndTime}" Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Translate ColHeartRate}" Binding="{Binding HeartRate, StringFormat=F2}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>