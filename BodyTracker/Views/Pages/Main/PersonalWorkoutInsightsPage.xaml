<Page x:Class="BodyTracker.Views.Pages.PersonalWorkoutInsightsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:lvcc="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
      xmlns:local="clr-namespace:BodyTracker.Services"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1600"
      Title="PersonalWorkoutInsightsPage">

    <Page.Resources>
       
        <!--<local:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>-->



    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   
            <RowDefinition Height="*"/>       
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

         <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI Card 1: Total Training Sessions -->
            <Border Grid.Column="0" 
                    Style="{DynamicResource BorderWorkoutInsightDashBoardStyle}">

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Height="100">
                
                    <TextBlock Text="TOTAL WORKOUTS" 
                               Style="{DynamicResource TextBlockWorkoutInsightsHeaderTitleStyle}"/>
                    
                    <TextBlock Text="{Binding TotalWorkouts}" 
                               Style="{DynamicResource TextBlockWorkoutInsightsHeaderNumberStyle}"/>
                
                </StackPanel>
            </Border>

            <!-- KPI Card 2: Total Workout Volume -->
            <Border Grid.Column="1" 
                    Style="{DynamicResource BorderWorkoutInsightDashBoardStyle}">
                
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Height="100">
                
                    <TextBlock Text="TOTAL VOLUME (kg)" 
                               Style="{DynamicResource TextBlockWorkoutInsightsHeaderTitleStyle}"/>
                    
                    <TextBlock Text="{Binding TotalWorkoutsVolume, StringFormat={}{0:N0}}" 
                               Style="{DynamicResource TextBlockWorkoutInsightsHeaderNumberStyle}"
                               Foreground="#34D399"/>
                    
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Top Exercises (Horizontal Bar Chart via ItemsControl) -->
            <Border Grid.Column="0" 
                    Margin="0,10,10,0"
                    Style="{DynamicResource BorderWorkoutInsightDashBoardStyle}">
                <Grid Margin="5,0,5,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="🏋️‍ Most Done Exercises" 
                               Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                  Margin="10,5">
                        <ItemsControl ItemsSource="{Binding TopExercises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Exercise Name TextBlock -->
                                        <TextBlock Grid.Column="0" 
                                                   Style="{DynamicResource TextBlockDescribing}"
                                                   Text="{Binding ExerciseName}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"
                                                   Width="200"/>

                                        <!-- 
                                           Dynamic ProgressBar.
                                           The Width is calculated via MultiBinding using the custom converter.
                                        -->
                                        <ProgressBar Grid.Column="1" 
                                                     Height="16" 
                                                     Minimum="0" 
                                                     Maximum="1"
                                                     Width="500"
                                                     Value="{Binding Percentage}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     Foreground="#38BDF8" 
                                                     Background="Transparent"/>



                                        <!-- Percentage Value TextBlock -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Percentage, StringFormat={}{0:P0}}" 
                                                   Style="{DynamicResource TextBlockWorkoutInsightsPercentageStyle}"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel: Muscle Group Distribution (Pie Chart via LiveCharts2) -->
            <Border Grid.Column="1" 
                    Margin="0,10,10,0"
                    Style="{DynamicResource BorderWorkoutInsightDashBoardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="💪 Workout Muscle Distribution" 
                               Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}"/>

                    <lvc:PieChart Grid.Row="1" 
                                  Series="{Binding WorkoutMuscleDistributionSeries}" 
                                  LegendPosition="Right" 
                                  InitialRotation="-90"
                                  Margin="10"
                                  LegendTextSize="9"/>


                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" 
                Style="{DynamicResource BorderWorkoutInsightDashBoardStyle}"
                Margin="0,10,0,0">
            <StackPanel>
                
                <TextBlock Text="📈 Last 6 Month traning Overview" 
                           Style="{DynamicResource TextBlockWorkoutInsightsChartTitleStyle}"/>
                <lvc:CartesianChart Height="280" 
                                    Series="{Binding SeriesMonthlyTraningsVolume}" 
                                    XAxes="{Binding XAxesMonthlyTraningsVolume}" 
                                    YAxes="{Binding YAxesMonthlyTraningsVolume}"
                                    LegendPosition="Bottom"
                                    Margin="10,5,10,15"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Page>