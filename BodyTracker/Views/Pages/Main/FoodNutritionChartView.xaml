<Page x:Class="BodyTracker.Views.Pages.Main.FoodNutritionChartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"     
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="1000"
      Title="FoodInfoChartView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" HorizontalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <Grid MaxWidth="1550" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>

            <!-- CONTROLS & FILTERS HEADER -->
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= TIMESPAN SECTION ================= -->
                <Border Style="{StaticResource BorderDashboardCardStyle}"
                 Grid.Column="0"
                 Padding="10"
                 Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="{loc:Translate LblTimespan}" 
                            Style="{DynamicResource TextBlockDashBoardTitle}" 
                            Margin="0,0,0,10"/>

                        <!-- Datepickers -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate LblFrom}" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernFlatDatePicker}"/>

                            <TextBlock Text="{loc:Translate LblTo}" VerticalAlignment="Center" Margin="10,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource ModernFlatDatePicker}"/>

                            <!-- ================= TOGGLE BUTTON QUICK DATE RANGES ================= -->
                            <ToggleButton x:Name="DateShortCuts"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnQuickRanges}"
                                   Margin="10,0,0,0"          
                                   ToolTip="{loc:Translate ToolTipQuickRanges}"/>

                            <!-- ================= POPUP QUICK DATE RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=DateShortCuts}"
                            Placement="Bottom"
                            StaysOpen="False"
                            IsOpen="{Binding IsChecked, ElementName=DateShortCuts}" 
                            AllowsTransparency="True">

                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                 Width="{Binding ActualWidth, ElementName=DateShortCuts}">

                                    <StackPanel>
                                        <Button Content="{loc:Translate BtnYear}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualYear}" 
                                         ToolTip="{loc:Translate ToolTipYear}"
                                         Margin="0,0,0,0"/>

                                        <Button Content="{loc:Translate BtnWeek}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualWeek}" 
                                         ToolTip="{loc:Translate ToolTipWeek}"
                                         Margin="0,5,0,0"/>

                                        <Button Content="{loc:Translate BtnMonth}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualMonth}" 
                                         ToolTip="{loc:Translate ToolTipMonth}"
                                         Margin="0,5,0,0"/>

                                        <Button Content="{loc:Translate BtnAllTime}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandShowAllData}" 
                                         ToolTip="{loc:Translate ToolTipAllTime}"
                                         Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="1" Padding="10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{loc:Translate LblSeriesVisibility}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">

                            <!-- ================= TOGGLE BUTTON SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="SeriesButton"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnShowMeasurements}"
                                   Margin="0,0,10,0"          
                                   ToolTip="{loc:Translate ToolTipShowMeasurements}"/>

                            <!-- ================= POPUP SERIES CHECKBOXES RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=SeriesButton}" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=SeriesButton}" AllowsTransparency="true">
                                <Border Background="White" Style="{DynamicResource BorderPopupDownCardStyle}" Width="{Binding ActualWidth, ElementName=SeriesButton}">
                                    <StackPanel Margin="0">
                                        <CheckBox Content="{loc:Translate ChartTitleCalories}" IsChecked="{Binding ShowCalories}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleProtein}" IsChecked="{Binding ShowProtein}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleCarbs}" IsChecked="{Binding ShowCarbs}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleFat}" IsChecked="{Binding ShowFat}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleVitaminA}" IsChecked="{Binding ShowVitaminA}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleVitaminC}" IsChecked="{Binding ShowVitaminC}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleVitaminD}" IsChecked="{Binding ShowVitaminD}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleIron}" IsChecked="{Binding ShowIron}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleCalcium}" IsChecked="{Binding ShowCalcium}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleNatrium}" IsChecked="{Binding ShowNatrium}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleKalium}" IsChecked="{Binding ShowKalium}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- ================= TOGGLE BUTTON TREND SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="TrendSeriesButton"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnShowTrends}"
                                   ToolTip="{loc:Translate ToolTipShowTrends}"/>

                            <!-- ================= POPUP TREND SERIES CHECKBOXES RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=TrendSeriesButton}" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=TrendSeriesButton}" AllowsTransparency="True">
                                <Border Background="White" Style="{DynamicResource BorderPopupDownCardStyle}" Width="{Binding ActualWidth, ElementName=TrendSeriesButton}">
                                    <StackPanel Margin="0">
                                        <CheckBox Content="{loc:Translate ChartTitleCalories}" IsChecked="{Binding ShowCaloriesTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleProtein}" IsChecked="{Binding ShowProteinTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleCarbs}" IsChecked="{Binding ShowCarbsTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleFat}" IsChecked="{Binding ShowFatTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleVitaminA}" IsChecked="{Binding ShowVitaminATrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleVitaminC}" IsChecked="{Binding ShowVitaminCTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleVitaminD}" IsChecked="{Binding ShowVitaminDTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleIron}" IsChecked="{Binding ShowIronTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleCalcium}" IsChecked="{Binding ShowCalciumTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleNatrium}" IsChecked="{Binding ShowNatriumTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleKalium}" IsChecked="{Binding ShowKaliumTrend}" Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" Margin="0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button Content="🔄" ToolTip="{loc:Translate ToolTipRefreshDatabaseDatas}" Command="{Binding CommandRefreshAsync}" Style="{DynamicResource IconStandardButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CHARTS -->
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="1" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleCalories}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesCalories}" XAxes="{Binding XAxesCalories}" YAxes="{Binding YAxesCalories}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="2" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleProtein}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesProtein}" XAxes="{Binding XAxesProtein}" YAxes="{Binding YAxesProtein}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="3" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleCarbs}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesCarbs}" XAxes="{Binding XAxesCarbs}" YAxes="{Binding YAxesCarbs}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="4" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleFat}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesFat}" XAxes="{Binding XAxesFat}" YAxes="{Binding YAxesFat}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="5" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleVitaminA}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesVitaminA}" XAxes="{Binding XAxesVitaminA}" YAxes="{Binding YAxesVitaminA}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="6" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleVitaminC}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesVitaminC}" XAxes="{Binding XAxesVitaminC}" YAxes="{Binding YAxesVitaminC}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="7" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleVitaminD}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesVitaminD}" XAxes="{Binding XAxesVitaminD}" YAxes="{Binding YAxesVitaminD}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="8" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleIron}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesIron}" XAxes="{Binding XAxesIron}" YAxes="{Binding YAxesIron}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="9" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleCalcium}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesCalcium}" XAxes="{Binding XAxesCalcium}" YAxes="{Binding YAxesCalcium}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="10" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleNatrium}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesNatrium}" XAxes="{Binding XAxesNatrium}" YAxes="{Binding YAxesNatrium}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Row="11" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleKalium}" Style="{DynamicResource TextBlockDashBoardTitle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesPotassium}" XAxes="{Binding XAxesPotassium}" YAxes="{Binding YAxesPotassium}" LegendPosition="Hidden" Background="Transparent"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>