<Page x:Class="BodyTracker.Views.Pages.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views"
      mc:Ignorable="d"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
ScrollViewer.VerticalScrollBarVisibility="Auto"
      Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"  Padding="0"
                  HorizontalScrollBarVisibility="Auto">
        <Grid MaxWidth="1550"
              Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="267"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <StackPanel>

                <!-- ================= BODY SETTING | REFRESHING ================= -->

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                    Margin="0,0,10,10"
                    Grid.Column="0"
                    Grid.Row="0">
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="🛠️ Actions"
                               Style="{DynamicResource TextBlockDashBoardTitle}"/>

                        <StackPanel Orientation="Horizontal">


                            <Button Content="🔄"
                                ToolTip="Refresh Dashboard without AI Result"
                                Command="{Binding CommandRefresh}"
                                Style="{DynamicResource IconStandardButton}" 
                                Margin="0,0,15,0"/>


                        </StackPanel>
                    </StackPanel>

                </Border>

                <!-- ================= TOTAL WORKOUTS AND EXERCISE VOLUME OVERVIEW ================= -->
                <Border Grid.Column="0"
                    Grid.Row="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Style="{DynamicResource BorderDashboardCardStyle}">

                    <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center">

                        <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="010" Width="215" Height="Auto" Margin="0,0,0,0">
                            <StackPanel Orientation="Vertical">

                                <TextBlock FontSize="12" 
                                           Foreground="Gray" 
                                           HorizontalAlignment="Center">
                                    
                                        <Run Text="🏋️"/>
                                        <Run Text="{Binding HeaderTotalWorkouts}"/>
                                    
                                    
                                </TextBlock>

                                <TextBlock Text="{Binding TotalWorkouts}" 
                                            FontSize="18" 
                                            FontWeight="Bold" 
                                            Foreground="#333333" 
                                            HorizontalAlignment="Center" 
                                            Margin="0,0,0,0"/>

                                <TextBlock FontSize="12" 
                                           Foreground="Gray" 
                                           HorizontalAlignment="Center">
  
                                    <Run Text="📊"/>
                                    <Run Text="{Binding HeaderTotalVolume}"/>

                                </TextBlock>

                                <TextBlock Text="{Binding TotalWorkoutsVolume}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#2ECC71" 
                                           HorizontalAlignment="Center" Margin="0,0,0,0"/>

                                
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>


            <!-- ================= BODY PROGRESS ================= -->
            <Border Grid.Column="1" 
                    Grid.Row="0"
                    Style="{DynamicResource BorderDashboardCardStyle}"
                    Width="Auto"
                    VerticalAlignment="Stretch"
                    Margin="0,0,10,0">

                <StackPanel Margin="0">

                    <TextBlock Text="📊 Body Progress" 
                               Style="{DynamicResource TextBlockDashBoardTitle}" 
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <StackPanel Orientation="Horizontal" 
                        Margin="0,0,16,0">

                            <Rectangle Style="{DynamicResource RectanglePreviousMonth}"/>

                            <TextBlock Text="{Binding PeriodTwoMonthsBefore}" 
                                       Style="{DynamicResource TextBlockPreviousMonth}" 
                                       Margin="6,0,0,0"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <Rectangle Style="{DynamicResource RectangleActualMonth}"/>

                            <TextBlock Text="{Binding PeriodMonthBefore}" 
                                       Style="{DynamicResource TextBlockActualMonth}" 
                                       Margin="6,0,0,0"/>

                        </StackPanel>
                    </StackPanel>

                    <!-- 1. Weight -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,5">

                            <TextBlock Text="Weight (kg)" 
                           Style="{DynamicResource TextBlockDescribing}"/>

                            <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">

                                <ContentControl Content="{Binding BodyWeightTrendArrow}" 
                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                <TextBlock Text="{Binding BodyWeightDifference}" 
                               Style="{DynamicResource TextBlockDifference}" 
                               Margin="4,0,0,0"/>

                            </StackPanel>
                        </Grid>

                        <Grid Height="10">

                            <ProgressBar Value="{Binding BodyWeightPreviousBarValue}" 
                             Maximum="{Binding BodyWeightBarMaximum}" 
                             Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                            <ProgressBar Value="{Binding BodyWeightCurrentBarValue}" 
                             Maximum="{Binding BodyWeightBarMaximum}" 
                             Style="{DynamicResource ProgressbarCurrentBarValue}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Body Fat -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,5">

                            <TextBlock Text="Body Fat (%)" 
                           Style="{DynamicResource TextBlockDescribing}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                <ContentControl Content="{Binding BodyFatTrendArrow}" 
                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                <TextBlock Text="{Binding BodyFatDifference}" 
                               Style="{DynamicResource TextBlockDifference}" 
                               Margin="4,0,0,0"/>

                            </StackPanel>
                        </Grid>

                        <Grid Height="10">

                            <ProgressBar Value="{Binding BodyFatPreviousBarValue}" 
                             Maximum="{Binding BodyFatBarMaximum}" 
                             Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                            <ProgressBar Value="{Binding BodyFatCurrentBarValue}" 
                             Maximum="{Binding BodyFatBarMaximum}" 
                             Style="{DynamicResource ProgressbarCurrentBarValue}"/>

                        </Grid>
                    </StackPanel>

                    <!-- 3. Muscle Mass -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,5">

                            <TextBlock Text="Muscle Mass (%)" 
                           Style="{DynamicResource TextBlockDescribing}"/>

                            <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">

                                <ContentControl Content="{Binding BodyMuscleMassTrendArrow}" 
                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                <TextBlock Text="{Binding BodyMuscleMassDifference}" 
                               Style="{DynamicResource TextBlockDifference}" 
                               Margin="4,0,0,0"/>

                            </StackPanel>
                        </Grid>
                        <Grid Height="10">

                            <ProgressBar Value="{Binding BodyMuscleMassPreviousBarValue}" 
                             Maximum="{Binding BodyMuscleMassBarMaximum}" 
                             Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                            <ProgressBar Value="{Binding BodyMuscleMassCurrentBarValue}" 
                             Maximum="{Binding BodyMuscleMassBarMaximum}" 
                             Style="{DynamicResource ProgressbarCurrentBarValue}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 4. Body Water -->
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Body Water (%)" 
                           Style="{DynamicResource TextBlockDescribing}"/>

                            <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">

                                <ContentControl Content="{Binding BodyWaterTrendArrow}" 
                                    Style="{DynamicResource ContentControlTrendArrow}"/>

                                <TextBlock Text="{Binding BodyWaterDifference}" 
                               Style="{DynamicResource TextBlockDifference}" 
                               Margin="4,0,0,0"/>

                            </StackPanel>
                        </Grid>
                        <Grid Height="10">

                            <ProgressBar Value="{Binding BodyWaterPreviousBarValue}" 
                             Maximum="{Binding BodyWaterBarMaximum}" 
                             Style="{DynamicResource ProgressbarPreviousBarValue}"/>

                            <ProgressBar Value="{Binding BodyWaterCurrentBarValue}" 
                             Maximum="{Binding BodyWaterBarMaximum}" Style="{DynamicResource ProgressbarCurrentBarValue}"/>

                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Average Body Measurements ================= -->
            <Border Grid.Row="0" 
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Stretch"
                    Style="{DynamicResource BorderDashboardCardStyle}"
                    Margin="0,0,10,0"
                    Width="Auto">

                <StackPanel Margin="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="📐 Average Body Measurements" 
                                               Style="{DynamicResource TextBlockDashBoardTitle}"
                                               Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>

                                <!--<TextBlock Text="📅 Timespan" 
                                Style="{DynamicResource TextBlockDashBoardTitle}" 
                                Margin="0,0,0,10"/>-->

                                <!-- Datepickers -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                                    <DatePicker SelectedDate="{Binding MeanStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernFlatDatePicker}"/>

                                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>

                                    <DatePicker SelectedDate="{Binding MeanEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource ModernFlatDatePicker}"/>

                                    <!-- ================= TOGGLE BUTTON QUICK DATE RANGES ================= -->
                                    <ToggleButton x:Name="DateShortCuts"
                                       Style="{DynamicResource ModernStandardToggleButton}"
                                       Content="📅 Quick Ranges ▼ "
                                       Margin="10,0,0,0"          
                                       ToolTip="Filters the chart to show data exclusively for the current year."/>

                                    <!-- ================= POPUP QUICK DATE RANGES ================= -->
                                    <Popup PlacementTarget="{Binding ElementName=DateShortCuts}"
                                            Placement="Bottom"
                                            StaysOpen="False"
                                            IsOpen="{Binding IsChecked, ElementName=DateShortCuts}" 
                                            AllowsTransparency="True">

                                        <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                     Width="{Binding ActualWidth, ElementName=DateShortCuts}">

                                            <StackPanel>

                                                <Button Content="📅 Year" 
                                                         Style="{StaticResource ModernStandardButton}" 
                                                         Command="{Binding CommandSetActualYearMeanValue}" 
                                                         ToolTip="Filter chart data for the current year."
                                                         Margin="0,0,0,0"/>

                                                <Button Content="📆 Week" 
                                                         Style="{StaticResource ModernStandardButton}" 
                                                         Command="{Binding CommandSetActualWeekMeanValue}" 
                                                         ToolTip="Filter chart data for the current week."
                                                         Margin="0,5,0,0"/>

                                                <Button Content="🗓️ Month" 
                                                         Style="{StaticResource ModernStandardButton}" 
                                                         Command="{Binding CommandSetActualMonthMeanValue}" 
                                                         ToolTip="Filter chart data for the current month."
                                                         Margin="0,5,0,0"/>

                                                
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>



                                <!-- ================= Weight ================= -->

                                <TextBlock Text="⚖️ Weight:"
                                           x:Name="tbWeight"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           Grid.Column="0"
                                           Grid.Row="0"/>

                                <TextBox Text="{Binding BodyWeight}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_kg}"
                                         IsReadOnly="True"
                                         VerticalAlignment="Center"
                                         Grid.Column="1"
                                         Grid.Row="0"/>

                                <!-- ================= BMI ================= -->

                                <TextBlock Text="📐 BMI:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="2"
                                           Grid.Row="0"/>

                                <TextBox Text="{Binding BMI}"
                                         Style="{DynamicResource StandardNumericInputField}"
                                         IsReadOnly="True"
                                         Width="{Binding ActualWidth, ElementName=tbWeight}"
                                         Grid.Column="3"
                                         Grid.Row="0"/>

                                <!-- ================= FFM ================= -->

                                <TextBlock Text="💪 FFM:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="0"
                                           Grid.Row="1"/>

                                <TextBox Text="{Binding FFM_kg}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_kg}"
                                         IsReadOnly="True"
                                         Grid.Column="1"
                                         Grid.Row="1"/>

                                <!-- ================= FFM Describing ================= -->

                                <TextBlock Text="💪 FFMI: "
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="0"
                                           Grid.Row="2"/>


                                <TextBox Text="{Binding FFM_describing}"
                                         Style="{DynamicResource StandardTextBoxWithFrame}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         TextAlignment="Left"
                                         Width="Auto"
                                         Grid.Column="1"
                                         Grid.Row="2"
                                         Grid.ColumnSpan="3"/>


                                <!-- ================= Body Fat ================= -->

                                <TextBlock Text="💧 Fat:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="4"
                                           Grid.Row="0"/>

                                <TextBox Text="{Binding BodyFatPercentage}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_Percentage}"
                                         IsReadOnly="True"
                                         Grid.Column="5"
                                         Grid.Row="0"/>

                                <!-- ================= Caliper 7 Point ================= -->

                                <TextBlock Text="🗜️ Caliper:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="4"
                                           Grid.Row="2"/>

                                <TextBox Text="{Binding BodyFatCaliper}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_Percentage}"
                                         IsReadOnly="True"
                                         Grid.Column="5"
                                         Grid.Row="2"/>

                                <!-- ================= Body Muscle ================= -->

                                <TextBlock Text="🧬 Muscle:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="2"
                                           Grid.Row="1"/>

                                <TextBox Text="{Binding BodyMusclePercentage}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_Percentage}"
                                         IsReadOnly="True"
                                         Grid.Column="3"
                                         Grid.Row="1"/>

                                <!-- ================= Body Water  ================= -->

                                <TextBlock Text="💧 Water:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="4"
                                           Grid.Row="1"/>

                                <TextBox Text="{Binding BodyWaterPercentage}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_Percentage}"
                                         IsReadOnly="True"
                                         Grid.Column="5"
                                         Grid.Row="1"/>

                                <!-- ================= Chest Circumference  ================= -->

                                <TextBlock Text="📏 Chest:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="6"      
                                           Grid.Row="0"/>

                                <TextBox Text="{Binding ChestCircumference}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_cm}"
                                         IsReadOnly="True"
                                         Grid.Column="7"
                                         Grid.Row="0"/>

                                <!-- ================= Waist Circumference  ================= -->

                                <TextBlock Text="📏 Waist:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="6"
                                           Grid.Row="1"/>

                                <TextBox Text="{Binding WaistCircumference}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_cm}"
                                         IsReadOnly="True"
                                         Grid.Column="7"
                                         Grid.Row="1"/>

                                <!-- ================= Hip Circumference  ================= -->

                                <TextBlock Text="📏 Hip:"
                                           FontSize="14"
                                           Style="{DynamicResource TextBlockDescribing}"
                                           VerticalAlignment="Center"
                                           Grid.Column="6"
                                           Grid.Row="2"/>

                                <TextBox Text="{Binding HipsCircumference}"
                                         Style="{DynamicResource TextBoxWithSuffixStyle_cm}"
                                         IsReadOnly="True"
                                         Grid.Column="7"
                                         Grid.Row="2"/>

                            </Grid>




                        </Grid>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= AI Insights  ================= -->
            <Border 
                Grid.Column="4" 
                    Grid.Row="0"
                Grid.RowSpan="2"
                    Style="{DynamicResource BorderDashboardCardStyle}"
                    Width="Auto"
                    VerticalAlignment="Stretch"
                    Margin="0,0,0,0"
                     >

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="0"  Grid.Row="0"  VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               Text="🧠 AI Insights" 
               Style="{DynamicResource TextBlockDashBoardTitle}" 
               VerticalAlignment="Center"
               Margin="0,0,0,10"/>

                        <Button Grid.Column="1"
                                Style="{DynamicResource IconStandardButton}"
                                Content="🔄"
                                ToolTip="Refresh AI Result"
                                Command="{Binding CommandRefreshAI}"
                                Margin="0,0,0,10"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                Padding="0"
                                FontSize="15"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBox x:Name="test" Text="{Binding AiAnylyseResult}"
                             Style="{DynamicResource TextBoxAiInsightsStyle}"
                             MaxHeight="500"
                             Margin="0,0,0,5"
                             Grid.Column="0"
                             Grid.Row="1"/>
                </Grid>

            </Border>


            <!-- ================= Body Metrics: Actual Last Months ================= -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Style="{DynamicResource BorderDashboardCardStyle}"
                    Margin="0,10,10,0">

                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Style="{DynamicResource TextBlockDashBoardTitle}" 
                               Margin="0,0,0,10">
                        

                        <Run Text="📈 "/>
                        <Run Text="{Binding HeaderBodyMeasurements}"/>

                    </TextBlock>

                    <lvc:CartesianChart Grid.Column="0"
                                        Grid.Row="1"
                                        MinHeight="1"
                                        MinWidth="1"
                                        Height="Auto"
                                        Width="Auto"
                                        Series="{Binding SeriesBodyMeasurements}" 
                                        XAxes="{Binding XAxesBodyMeasurements}" 
                                        YAxes="{Binding YAxesBodyMeasurements}"
                                        LegendPosition="Bottom"/>
                </Grid>



               
            </Border>

            <!-- ================= MONTH WORKOUT OVERVIEW ================= -->
            <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,10,10,0"
                    Style="{DynamicResource BorderDashboardCardStyle}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>



                    <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Style="{DynamicResource TextBlockDashBoardTitle}" 
                               Margin="0,0,0,12">
                        
                        <Run Text="📈 "/>
                        <Run Text="{Binding HeaderTrainingsVolume}"/>

                    </TextBlock>

                    <lvc:CartesianChart Grid.Column="0"
                                        Grid.Row="1"
                                        MinHeight="2"
                                        MinWidth="2"
                                        Height="Auto"
                                        Width="Auto"
                                        Series="{Binding SeriesMonthlyTraningsVolume}" 
                                        XAxes="{Binding XAxesMonthlyTraningsVolume}" 
                                        YAxes="{Binding YAxesMonthlyTraningsVolume}" 
                                        LegendPosition="Bottom"/>
                </Grid>

            </Border>


            <!-- ================= Muscle Distribution Spider Chart ================= -->
            <Border Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Style="{DynamicResource BorderDashboardCardStyle}"
                    Margin="0,10,0,0">

                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="💪 Workout Muscle Distribution"
                               Grid.Column="0"
                               Grid.Row="0"
                               Style="{DynamicResource TextBlockDashBoardTitle}" 
                               Height="27" VerticalAlignment="Top"/>

                    <TextBlock Text="{Binding HeaderMuscleDistribution}"
                               Grid.Column="0"
                               Grid.Row="1"
                               Style="{DynamicResource TextBlockDashBoardTitle}" 
                               FontSize="12"
                               VerticalAlignment="Top"/>
     
                        <lvc:PolarChart Grid.Column="0"
                                        Grid.Row="2"
                                        MinHeight="1"
                                        MinWidth="1"
                                        Height="Auto"
                                        Width="Auto"
                                        LegendPosition="Hidden"
                                        LegendTextSize="10"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Series="{Binding SeriesMuscleDistributionSpiderChart}" 
                                        AngleAxes="{Binding AngleAxisMuscleDistirbutionSpiderChart}"
                                        RadiusAxes="{Binding RadiusAxisMuscleDistirbutionSpiderChart}"/>
                </Grid>
            </Border>

            <!-- ================= MOST DONE EXERCISES ================= -->
            <Border Grid.Row="3" 
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Stretch"
                    Style="{DynamicResource BorderDashboardCardStyle}"
                    Margin="0,10,10,0"
>

                <StackPanel HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                    <TextBlock Style="{DynamicResource TextBlockDashBoardTitle}" 
                               Margin="0,0,0,20">
                        
                        <Run Text="🏋️‍ "/>
                        <Run Text="{Binding HeaderMostDoneExercises}"/>

                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">

                        <ItemsControl ItemsSource="{Binding TopExercises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Exercise Name -->
                                        <TextBlock Grid.Column="0" Style="{DynamicResource TextBlockDescribing}" 
                                       Text="{Binding ExerciseName}" 
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis"/>

                                        <!-- ProgressBar -->
                                        <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="1" 
                                         Value="{Binding Percentage}" 
                                         VerticalAlignment="Center" 
                                         Margin="10,0" 
                                         Foreground="#38BDF8" 
                                         Background="Transparent"/>

                                        <!-- Percentage -->
                                        <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat={}{0:P0}}" 
                                       Style="{DynamicResource TextBlockWorkoutInsightsPercentageStyle}" 
                                       VerticalAlignment="Center"/>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>