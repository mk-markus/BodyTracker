<Page x:Class="BodyTracker.Views.Pages.StepDailyTrendImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:BodyTracker.ViewModels"
      Title="Step Daily Trend">

    <!--<Page.DataContext>
        <vm:StepDailyTrendViewModel />
    </Page.DataContext>-->

    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="10">

                <Button Content="Open Daily Trend File" 
                    Command="{Binding OpenSamsungStepDailyTrendCommand}" 
                    Style="{DynamicResource ModernStandardButton}"/>

                <Button Content="Upload Step Daily Trend Data"
                    Command="{Binding InsertSamsungStepsDailyTrendToDatabaseCommand}" 
                    Style="{DynamicResource ModernStandardButton}"/>

                <ProgressBar Height="25" 
                             MinWidth="100"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding IsLoading, Converter={StaticResource bool2VisibilityConverter}}" 
                             Style="{DynamicResource ProgressbarCurrentBarValue}"
                             Margin="0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                <TextBlock Text="{Binding ProgressText}"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource TextBlockDescribing}"
                           Width="300"
                           TextAlignment="Center"/>

            </StackPanel>


            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding StepDailyTrend}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="10"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Date"
                            Binding="{Binding DayTime, StringFormat=dd.MM.yyyy}"
                            Width="120" />

                    <DataGridTextColumn Header="Steps"
                            Binding="{Binding Count}"
                            Width="100" />

                    <DataGridTextColumn Header="Distance (m)"
                            Binding="{Binding Distance, StringFormat=F2}"
                            Width="120" />

                    <DataGridTextColumn Header="Speed"
                            Binding="{Binding Speed, StringFormat=F2}"
                            Width="100" />

                    <DataGridTextColumn Header="Calories"
                            Binding="{Binding Calorie, StringFormat=F0}"
                            Width="100" />

                    <DataGridTextColumn Header="Source Package"
                            Binding="{Binding SourcePkgName}"
                            Width="220" />

                    <DataGridTextColumn Header="Source Type"
                            Binding="{Binding SourceType}"
                            Width="100" />

                    <DataGridTextColumn Header="Created"
                            Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm}"
                            Width="150" />

                    <DataGridTextColumn Header="Updated"
                            Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm}"
                            Width="150" />

                    <DataGridTextColumn Header="Device UUID"
                            Binding="{Binding DeviceUuid}"
                            Width="150" />

                    <DataGridTextColumn Header="Package"
                            Binding="{Binding PkgName}"
                            Width="220" />

                    <DataGridTextColumn Header="Data UUID"
                            Binding="{Binding DataUuid}"
                            Width="250" />

                    <DataGridTextColumn Header="Binning Data"
                            Binding="{Binding BinningData}"
                            Width="300" />

                </DataGrid.Columns>

            </DataGrid>
        </Grid>

    </Border>
</Page>
