<Page x:Class="BodyTracker.Views.Pages.StepTrendImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:BodyTracker.ViewModels"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      Title="Step Daily Trend">

    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="10">

                <Button Content="🔄"
                        ToolTip="{loc:Translate ToolTipRefresh}"
                        Command="{Binding CommandRefresh}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📁"
                        ToolTip="{loc:Translate ToolTipOpenFileDialog}"
                        Command="{Binding CommandOpen}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📤"
                        ToolTip="{loc:Translate ToolTipInsertDatabase}"
                        Command="{Binding CommandInsert}"
                        Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}"
                               Margin="10"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                    <TextBlock Text="{Binding ProgressText}"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding StepTrendDatas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="10"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate ColBinningData}" Binding="{Binding BinningData}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSourcePackage}" Binding="{Binding SourcePkgName}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSourceType}" Binding="{Binding SourceType}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCount}" Binding="{Binding Count}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColSpeed}" Binding="{Binding Speed, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDistance}" Binding="{Binding Distance, StringFormat=F2}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCalorie}" Binding="{Binding Calorie, StringFormat=F0}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPkgName}" Binding="{Binding PkgName}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDayTime}" Binding="{Binding DayTime, StringFormat=dd.MM.yyyy}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>