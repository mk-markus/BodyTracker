<Page x:Class="BodyTracker.Views.Pages.FoodIntakeImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      Title="Food Intake">

    <Border Style="{DynamicResource BorderDashboardCardStyle}" Margin="0,10,0,0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                <Button Content="🔄" ToolTip="{loc:Translate ToolTipRefresh}" Command="{Binding CommandRefresh}" Style="{DynamicResource IconStandardButton}" />
                <Button Content="📁" ToolTip="{loc:Translate ToolTipOpenFileDialog}" Command="{Binding CommandOpen}" Style="{DynamicResource IconStandardButton}" />
                <Button Content="📤" ToolTip="{loc:Translate ToolTipInsertDatabase}" Command="{Binding CommandInsert}" Style="{DynamicResource IconStandardButton}" />

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}" Margin="10" TextAlignment="Center" Style="{DynamicResource TextBlockDescribing}" />
                    <TextBlock Text="{Binding ProgressText}" TextAlignment="Center" Style="{DynamicResource TextBlockDescribing}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding FoodIntakeDatas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Margin="10" Style="{StaticResource DataGrid_Default}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate ColCreateShVer}" Binding="{Binding CreateShVer}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColAmount}" Binding="{Binding Amount}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCustom}" Binding="{Binding Custom}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColModifyShVer}" Binding="{Binding ModifyShVer}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColClientDataId}" Binding="{Binding ClientDataId}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColName}" Binding="{Binding Name}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColUnit}" Binding="{Binding Unit}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColClientDataVer}" Binding="{Binding ClientDataVer}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColCalorie}" Binding="{Binding Calorie, StringFormat=F0}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColTimeOffset}" Binding="{Binding TimeOffset}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColComment}" Binding="{Binding Comment}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColPkgName}" Binding="{Binding PkgName}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Translate ColFoodInfoId}" Binding="{Binding FoodInfoId}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>