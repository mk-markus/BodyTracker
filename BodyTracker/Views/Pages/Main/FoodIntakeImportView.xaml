<Page x:Class="BodyTracker.Views.Pages.FoodIntakeImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:BodyTracker.ViewModels"
      Title="Food Intake">


    <Border Style="{DynamicResource BorderDashboardCardStyle}"
            Margin="0,10,0,0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="left" 
                        Margin="10">


                <Button Content="🔄"
                        ToolTip="Refresh"
                        Command="{Binding CommandRefresh}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📁"
                        ToolTip="Open File Dialog"
                        Command="{Binding CommandOpen}"
                        Style="{DynamicResource IconStandardButton}" />

                <Button Content="📤"
                        ToolTip="Insert Datas in Database"
                        Command="{Binding CommandInsert}"
                        Style="{DynamicResource IconStandardButton}" />

                <!--<ProgressBar Height="25"
                             MinWidth="100"
                             IsIndeterminate="True"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding IsLoading, Converter={StaticResource bool2VisibilityConverter}}"
                             Style="{DynamicResource ProgressbarCurrentBarValue}" />-->

                <WrapPanel>
                    <TextBlock Text="{Binding TimeElapse}"
                               Margin="10"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                    <TextBlock Text="{Binding ProgressText}"
                               TextAlignment="Center"
                               Style="{DynamicResource TextBlockDescribing}" />

                </WrapPanel>

            </StackPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding FoodIntakeDatas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="10"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Style="{StaticResource DataGrid_Default}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="create__sh__ver"
                                        Binding="{Binding CreateShVer}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="start__time"
                                        Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="Auto" />
                   
                    <DataGridTextColumn Header="amount"
                                        Binding="{Binding Amount}"
                                        Width="Auto" />
                    

                    <DataGridTextColumn Header="custom"
                                        Binding="{Binding Custom}"
                                        Width="Auto" />


                    <DataGridTextColumn Header="modify__sh__ver"
                                        Binding="{Binding ModifyShVer}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="update__time"
                                        Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="Auto" />
                    
                    <DataGridTextColumn Header="create__time"
                                        Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="client__data__id"
                                        Binding="{Binding ClientDataId}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="name"
                                        Binding="{Binding Name}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="unit"
                                        Binding="{Binding Unit}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="client__data__ver"
                                        Binding="{Binding ClientDataVer}"
                                        Width="Auto" />
                    
                    <DataGridTextColumn Header="calories"
                                        Binding="{Binding Calorie, StringFormat=F0}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="time__offset"
                                        Binding="{Binding TimeOffset}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="deviceuuid"
                                        Binding="{Binding DeviceUuid}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="comment"
                                        Binding="{Binding Comment}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="pkg__name"
                                        Binding="{Binding PkgName}"
                                        Width="Auto" />


                    <DataGridTextColumn Header="dataeuuid"
                                        Binding="{Binding DataUuid}"
                                        Width="Auto" />


                    <DataGridTextColumn Header="food__info__id"
                                        Binding="{Binding FoodInfoId}"
                                        Width="Auto" />

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>
