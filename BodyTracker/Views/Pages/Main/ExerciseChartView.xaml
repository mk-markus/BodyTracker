<Page x:Class="BodyTracker.ViewModels.Main.ExerciseChartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"     
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="ExerciseChartView">

    <ScrollViewer VerticalScrollBarVisibility="Auto"  Padding="0"
              HorizontalScrollBarVisibility="Auto"
                  Margin="0,10,0,0">
        <Grid MaxWidth="1550" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>

            <!-- SECTION 1: CONTROLS & FILTERS HEADER -->
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ================= TIMESPAN SECTION ================= -->
                <Border Style="{StaticResource BorderDashboardCardStyle}"
                 Grid.Column="0"
                 Padding="10"
                 Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="{loc:Translate LblTimespan}" 
                            Style="{DynamicResource TextBlockDashBoardTitle}" 
                            Margin="0,0,0,10"/>

                        <!-- Datepickers -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate LblFrom}" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernFlatDatePicker}"/>

                            <TextBlock Text="{loc:Translate LblTo}" VerticalAlignment="Center" Margin="10,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource ModernFlatDatePicker}"/>

                            <!-- ================= TOGGLE BUTTON QUICK DATE RANGES ================= -->
                            <ToggleButton x:Name="DateShortCuts"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnQuickRanges}"
                                   Margin="10,0,0,0"          
                                   ToolTip="{loc:Translate ToolTipQuickRanges}"/>

                            <!-- ================= POPUP QUICK DATE RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=DateShortCuts}"
                            Placement="Bottom"
                            StaysOpen="False"
                            IsOpen="{Binding IsChecked, ElementName=DateShortCuts}" 
                            AllowsTransparency="True">

                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                 Width="{Binding ActualWidth, ElementName=DateShortCuts}">

                                    <StackPanel>
                                        <Button Content="{loc:Translate BtnYear}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualYear}" 
                                         ToolTip="{loc:Translate ToolTipYear}"
                                         Margin="0,0,0,0"/>

                                        <Button Content="{loc:Translate BtnWeek}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualWeek}" 
                                         ToolTip="{loc:Translate ToolTipWeek}"
                                         Margin="0,5,0,0"/>

                                        <Button Content="{loc:Translate BtnMonth}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualMonth}" 
                                         ToolTip="{loc:Translate ToolTipMonth}"
                                         Margin="0,5,0,0"/>

                                        <Button Content="{loc:Translate BtnAllTime}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandShowAllData}" 
                                         ToolTip="{loc:Translate ToolTipAllTime}"
                                         Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= METRICS SETTINGS SECTION ================= -->
                <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="1" Padding="10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{loc:Translate LblSeriesVisibility}" 
                                VerticalAlignment="Center"
                                Style="{DynamicResource TextBlockDashBoardTitle}" 
                                Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- ================= TOGGLE BUTTON SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="SeriesButton"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnShowMeasurements}"
                                   Margin="0,0,10,0"          
                                   ToolTip="{loc:Translate ToolTipShowMeasurements}"/>


                            <Popup PlacementTarget="{Binding ElementName=SeriesButton}"
                                Placement="Bottom" StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=SeriesButton}" 
                                AllowsTransparency="True">
                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                      Width="{Binding ActualWidth, ElementName=SeriesButton}">
                                    <StackPanel>
                                        <CheckBox Content="{loc:Translate ChartTitleDuration}" IsChecked="{Binding ShowDuration}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleCalories}" IsChecked="{Binding ShowCalories}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleDistance}" IsChecked="{Binding ShowDistance}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleHeartRate}" IsChecked="{Binding ShowHeartRate}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleMinHeartRate}" IsChecked="{Binding ShowMinHeartRate}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleMaxHeartRate}" IsChecked="{Binding ShowMaxHeartRate}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleSpeed}" IsChecked="{Binding ShowSpeed}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- ================= TOGGLE BUTTON TREND SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="TrendSeriesButton"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnShowTrends}"
                                   ToolTip="{loc:Translate ToolTipShowTrends}"/>

                            <!-- ================= POPUP TREND SERIES CHECKBOXES RANGES ================= -->
                              <Popup PlacementTarget="{Binding ElementName=TrendSeriesButton}"
                                Placement="Bottom" StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=TrendSeriesButton}"
                                AllowsTransparency="True">
                                <Border Background="White" Style="{DynamicResource BorderPopupDownCardStyle}" Width="{Binding ActualWidth, ElementName=TrendSeriesButton}">
                                    <StackPanel>
                                        <CheckBox Content="{loc:Translate ChartTitleDuration}" IsChecked="{Binding ShowDurationTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleCalories}" IsChecked="{Binding ShowCaloriesTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleDistance}" IsChecked="{Binding ShowDistanceTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleHeartRate}" IsChecked="{Binding ShowHeartRateTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleMinHeartRate}" IsChecked="{Binding ShowMinHeartRateTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleMaxHeartRate}" IsChecked="{Binding ShowMaxHeartRateTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{loc:Translate ChartTitleSpeed}" IsChecked="{Binding ShowSpeedTrend}" Command="{Binding CommandReloadChartsAsync}" Style="{StaticResource StandardCheckBox}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button Content="🔄" ToolTip="{loc:Translate ToolTipRefreshDatabaseDatas}" Command="{Binding CommandRefreshAsync}" Style="{DynamicResource IconStandardButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CHARTS -->
            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="0" Grid.Row="1" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleDuration}" Style="{DynamicResource TextBlockDashBoardTitle}" Grid.Row="0" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesDuration}" XAxes="{Binding XAxesDuration}" YAxes="{Binding YAxesDuration}" LegendPosition="Hidden" Background="Transparent" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="0" Grid.Row="2" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleCalories}" Style="{DynamicResource TextBlockDashBoardTitle}" Grid.Row="0" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesCalories}" XAxes="{Binding XAxesCalories}" YAxes="{Binding YAxesCalories}" LegendPosition="Bottom" Background="Transparent" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="0" Grid.Row="3" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleDistance}" Style="{DynamicResource TextBlockDashBoardTitle}" Grid.Row="0" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesDistance}" XAxes="{Binding XAxesDistance}" YAxes="{Binding YAxesDistance}" LegendPosition="Hidden" Background="Transparent" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="0" Grid.Row="4" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleHeartRate}" Style="{DynamicResource TextBlockDashBoardTitle}" Grid.Row="0" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesHeartRate}" XAxes="{Binding XAxesHeartRate}" YAxes="{Binding YAxesHeartRate}" LegendPosition="Hidden" Background="Transparent" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource BorderDashboardCardStyle}" Grid.Column="0" Grid.Row="5" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="{loc:Translate ChartTitleSpeed}" Style="{DynamicResource TextBlockDashBoardTitle}" Grid.Row="0" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Series="{Binding SeriesSpeed}" XAxes="{Binding XAxesSpeed}" YAxes="{Binding YAxesSpeed}" LegendPosition="Hidden" Background="Transparent" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>