<Page x:Class="BodyTracker.ViewModels.Main.ExerciseChartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"     
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="ExerciseChartView">

    <ScrollViewer VerticalScrollBarVisibility="Auto"  Padding="0"
              HorizontalScrollBarVisibility="Auto"
                  Margin="0,10,0,0">
        <Grid MaxWidth="1550"
          Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>


            <!-- SECTION 1: CONTROLS & FILTERS HEADER -->
            <Grid Grid.Column="0"
               Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- ================= TIMESPAN SECTION ================= -->
                <Border Style="{StaticResource BorderDashboardCardStyle}"
                     Grid.Column="0"
                     Padding="10"
                     Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="📅 Timespan" 
                                Style="{DynamicResource TextBlockDashBoardTitle}" 
                                Margin="0,0,0,10"/>

                        <!-- Datepickers -->
                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding StartDateDatas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernFlatDatePicker}"/>

                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>

                            <DatePicker SelectedDate="{Binding EndDateDatas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource ModernFlatDatePicker}"/>

                            <!-- ================= TOGGLE BUTTON QUICK DATE RANGES ================= -->
                            <ToggleButton x:Name="DateShortCuts"
                                       Style="{DynamicResource ModernStandardToggleButton}"
                                       Content="📅 Quick Ranges ▼ "
                                       Margin="10,0,0,0"          
                                       ToolTip="Filters the chart to show data exclusively for the current year."/>

                            <!-- ================= POPUP QUICK DATE RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=DateShortCuts}"
                                Placement="Bottom"
                                StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=DateShortCuts}" 
                                AllowsTransparency="True">

                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                     Width="{Binding ActualWidth, ElementName=DateShortCuts}">

                                    <StackPanel>

                                        <Button Content="📅 Year" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandSetActualYear}" 
                                             ToolTip="Filter chart data for the current year."
                                             Margin="0,0,0,0"/>

                                        <Button Content="📆 Week" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandSetActualWeek}" 
                                             ToolTip="Filter chart data for the current week."
                                             Margin="0,5,0,0"/>

                                        <Button Content="🗓️ Month" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandSetActualMonth}" 
                                             ToolTip="Filter chart data for the current month."
                                             Margin="0,5,0,0"/>

                                        <Button Content="🌍 All Time" 
                                             Style="{StaticResource ModernStandardButton}" 
                                             Command="{Binding CommandShowAllData}" 
                                             ToolTip="Display the complete historical dataset without time restrictions."
                                             Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= METRICS SETTINGS SECTION ================= -->
                <Border Style="{StaticResource BorderDashboardCardStyle}"
                     Grid.Column="1"
                     Padding="10">

                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="📊 Series Visibility" 
                                VerticalAlignment="Center"
                                Style="{DynamicResource TextBlockDashBoardTitle}" 
                                Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">

                            <!-- ================= TOGGLE BUTTON SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="SeriesButton"
                                       Style="{DynamicResource ModernStandardToggleButton}"
                                       Content="📊 Show Measurements ▼ "
                                       Margin="0,0,10,0"          
                                       ToolTip="Select or clear the check boxes to show or hide in the following diagrams."/>


                            <!-- ================= POPUP SERIES CHECKBOXES RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=SeriesButton}"
                                Placement="Bottom"
                                StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=SeriesButton}" 
                                AllowsTransparency="True">


                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                      Width="{Binding ActualWidth, ElementName=SeriesButton}">


                                    <StackPanel>
                                        <CheckBox Content="📈 Duration" 
                                               IsChecked="{Binding ShowDuration}"
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}" 
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="🔥 Calories" 
                                               IsChecked="{Binding ShowCalories}"
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}" 
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="🏃 Distance" 
                                               IsChecked="{Binding ShowDistance}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}" 
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="❤️ Heart Rate" 
                                               IsChecked="{Binding ShowHeartRate}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>


                                        <CheckBox Content="❤️ Min Heart Rate" 
                                               IsChecked="{Binding ShowMinHeartRate}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>


                                        <CheckBox Content="❤️ Max Heart Rate" 
                                               IsChecked="{Binding ShowMaxHeartRate}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="⚡ Speed" 
                                               IsChecked="{Binding ShowSpeed}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>
                                    </StackPanel>

                                </Border>
                            </Popup>


                            <!-- ================= TOGGLE BUTTON TREND SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="TrendSeriesButton"
                                       Style="{DynamicResource ModernStandardToggleButton}"
                                       Content="📈 Show Trends ▼ "
                                       ToolTip="Select or clear the trend check boxes to show or hide in the following diagrams."/>

                            <!-- ================= POPUP TREND SERIES CHECKBOXES RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=TrendSeriesButton}"
                                Placement="Bottom"
                                StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=TrendSeriesButton}"
                                AllowsTransparency="True">

                                <Border Background="White"
                                     Style="{DynamicResource BorderPopupDownCardStyle}"
                                      Width="{Binding ActualWidth, ElementName=TrendSeriesButton}">

                                    <StackPanel>
                                        <CheckBox Content="📈 Duration" 
                                               IsChecked="{Binding ShowDurationTrend}"
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}" 
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="🔥 Calories" 
                                               IsChecked="{Binding ShowCaloriesTrend}"
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}" 
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="🏃 Distance" 
                                               IsChecked="{Binding ShowDistanceTrend}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}" 
                                               Margin="0,0,0,8"/>

                                        <CheckBox Content="❤️ Heart Rate" 
                                               IsChecked="{Binding ShowHeartRateTrend}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>


                                        <CheckBox Content="❤️ Min Heart Rate" 
                                               IsChecked="{Binding ShowMinHeartRateTrend}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>


                                        <CheckBox Content="❤️ Max Heart Rate" 
                                               IsChecked="{Binding ShowMaxHeartRateTrend}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>
                                        
                                        <CheckBox Content="⚡ Speed" 
                                               IsChecked="{Binding ShowSpeedTrend}" 
                                               Command="{Binding CommandReloadChartsAsync}" 
                                               Style="{StaticResource StandardCheckBox}"
                                               Margin="0,0,0,8"/>
                                    </StackPanel>

                                </Border>
                            </Popup>


                            <Button Content="🔄"
                             ToolTip="Refresh Datas: Reload all datas from Database"
                             Command="{Binding CommandRefreshAsync}"
                             Style="{DynamicResource IconStandardButton}" />

                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= POPUP EXERCISE DISTANCE CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
                 Grid.Column="0"
                 Grid.Row="1"
                 Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="📈 Duration" 
                                Style="{DynamicResource TextBlockDashBoardTitle}"
                                Grid.Column="0"
                                Grid.Row="0"
                                Margin="0,0,0,12"/>

                    <lvc:CartesianChart Series="{Binding SeriesDuration}" 
                                        XAxes="{Binding XAxesDuration}" 
                                        YAxes="{Binding YAxesDuration}" 
                                        LegendPosition="Hidden"
                                        Background="Transparent"
                                        Grid.Column="0"
                                        Grid.Row="1">
                    </lvc:CartesianChart>

                </Grid>
            </Border>

            <!-- ================= POPUP EXERCISE CALORIES CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
                 Grid.Column="0"
                 Grid.Row="2"
                 Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="🔥 Calories"
                      Style="{DynamicResource TextBlockDashBoardTitle}"
                      Grid.Column="0"
                      Grid.Row="0"
                      Margin="0,0,0,12"/>

                    <lvc:CartesianChart  Series="{Binding SeriesCalories}" 
                                         XAxes="{Binding XAxesCalories}" 
                                         YAxes="{Binding YAxesCalories}" 
                                         LegendPosition="Bottom"
                                         Background="Transparent"
                                         Grid.Column="0"
                                         Grid.Row="1">
                    </lvc:CartesianChart>

                </Grid>
            </Border>

            <!-- ================= POPUP EXERCISE DISTANCE CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
                 Grid.Column="0"
                 Grid.Row="3"
                 Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="🏃 Distance" 
                      Style="{DynamicResource TextBlockDashBoardTitle}"
                      Grid.Column="0"
                      Grid.Row="0"
                      Margin="0,0,0,12"/>

                    <lvc:CartesianChart  Series="{Binding SeriesDistance}" 
                           XAxes="{Binding XAxesDistance}" 
                           YAxes="{Binding YAxesDistance}" 
                           LegendPosition="Hidden"
                           Background="Transparent"
                           Grid.Column="0"
                           Grid.Row="1">
                    </lvc:CartesianChart>

                </Grid>
            </Border>

            <!-- ================= POPUP EXERCISE HEART RATE CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
                    Grid.Column="0"
                    Grid.Row="4"
                    Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="❤️ Heart Rate" 
                                Style="{DynamicResource TextBlockDashBoardTitle}"
                                Grid.Column="0"
                                Grid.Row="0"
                                Margin="0,0,0,12"/>

                    <lvc:CartesianChart  Series="{Binding SeriesHeartRate}" 
                                         XAxes="{Binding XAxesHeartRate}" 
                                         YAxes="{Binding YAxesHeartRate}" 
                                         LegendPosition="Hidden"
                                         Background="Transparent"
                                         Grid.Column="0"
                                         Grid.Row="1">
                    </lvc:CartesianChart>

                </Grid>
            </Border>

            <!-- ================= POPUP EXERCISE SPEED CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
                     Grid.Column="0"
                     Grid.Row="5"
                     Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="⚡ Ø Speed" 
                                Style="{DynamicResource TextBlockDashBoardTitle}"
                                Grid.Column="0"
                                Grid.Row="0"
                                Margin="0,0,0,12"/>

                    <lvc:CartesianChart  Series="{Binding SeriesSpeed}" 
                                          XAxes="{Binding XAxesSpeed}" 
                                          YAxes="{Binding YAxesSpeed}" 
                                          LegendPosition="Hidden"
                                          Background="Transparent"
                                          Grid.Column="0"
                                          Grid.Row="1">
                    </lvc:CartesianChart>

                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
