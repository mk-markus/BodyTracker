<Page x:Class="BodyTracker.Views.Pages.Main.DBEntryOxygenSaturationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Translate TitleDBEntryOxygenSaturationView}">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Style="{DynamicResource BorderDashboardCardStyle}"
                   Margin="0,10,0,10"
                   Grid.Column="0"
                   Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{loc:Translate TitleActions}"
                              Style="{DynamicResource TextBlockDashBoardTitle}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🗑"
                               ToolTip="{loc:Translate TooltipDeleteSelectedEntry}"
                               Command="{Binding CommandDelete}"
                               Style="{DynamicResource IconStandardButton}" 
                               Margin="0,0,15,0"/>

                        <Button Content="🔄"
                               ToolTip="{loc:Translate TooltipRefreshDatabaseDatas}"
                               Command="{Binding CommandRefresh}"
                               Style="{DynamicResource IconStandardButton}" />

                    </StackPanel>
                </StackPanel>

            </Border>

            <Grid Grid.Column="0"
                 Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                       Grid.Column="0"
                       Grid.Row="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="OxygenSaturationGrid"
                                  ItemsSource="{Binding OxygenSaturationDatas}"
                                  SelectedItem="{Binding SelectedData, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Single"
                                  Margin="0,10,10,0"
                                  FontWeight="Normal"
                                  VerticalScrollBarVisibility="Auto"
                                  HeadersVisibility="Column"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  GridLinesVisibility="All"
                                  Style="{StaticResource DataGrid_Default}">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="RowEditEnding">
                                    <i:InvokeCommandAction
                                Command="{Binding CommandRowEditEnding}"
                                PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="{loc:Translate ColDbId}" Binding="{Binding OxygenSaturationID}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColIntegratedId}" Binding="{Binding IntegratedId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColClientDataId}" Binding="{Binding ClientDataId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColTagId}" Binding="{Binding TagId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColStartTime}" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColEndTime}" Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSpO2}" Binding="{Binding SpO2, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSpO2Max}" Binding="{Binding SpO2Max, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSpO2Min}" Binding="{Binding SpO2Min, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColLowSpO2Duration}" Binding="{Binding LowSpO2Duration}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCoverageRate}" Binding="{Binding SpO2CoverageRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColHeartRate}" Binding="{Binding HeartRate, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCreateShVer}" Binding="{Binding CreateShVer}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColModifyShVer}" Binding="{Binding ModifyShVer}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColClientDataVer}" Binding="{Binding ClientDataVer}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColUpdateTime}" Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCreateTime}" Binding="{Binding CreateTime, StringFormat=dd.MM.yyyy HH:mm:ss}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColTimeOffset}" Binding="{Binding TimeOffset}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColCustom}" Binding="{Binding Custom}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColComment}" Binding="{Binding Comment}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColSource}" Binding="{Binding Source}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColPackageName}" Binding="{Binding PackageName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDeviceUuid}" Binding="{Binding DeviceUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDataUuid}" Binding="{Binding DataUuid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColBinning}" Binding="{Binding Binning}" IsReadOnly="True"/>

                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>