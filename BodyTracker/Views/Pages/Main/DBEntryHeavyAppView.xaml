<Page x:Class="BodyTracker.Views.Pages.Main.DBEntryHevyAppView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d"       
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DBEntryHevyAppView">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource BorderDashboardCardStyle}"
                   Margin="0,10,0,10"
                   Grid.Column="0"
                   Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{loc:Translate TitleActions}"
                              Style="{DynamicResource TextBlockDashBoardTitle}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🗑"
                               ToolTip="{loc:Translate TooltipDeleteSelectedEntry}"
                               Command="{Binding CommandDelete}"
                               Style="{DynamicResource IconStandardButton}" 
                               Margin="0,0,15,0"/>

                        <Button Content="🔄"
                               ToolTip="{loc:Translate TooltipRefreshDatabaseDatas}"
                               Command="{Binding CommandRefresh}"
                               Style="{DynamicResource IconStandardButton}" />

                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                       Grid.Column="0"
                       Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="MeasurementsGrid"
                                 ItemsSource="{Binding BodyMeasurement, UpdateSourceTrigger=PropertyChanged}" 
                                 SelectedItem="{Binding SelectedMeasurement, Mode=TwoWay}"
                                 AutoGenerateColumns="False" 
                                 CanUserAddRows="False" 
                                 SelectionUnit="FullRow"
                                 SelectionMode="Single"
                                 Margin="0,10,10,0"
                                 FontWeight="Normal"
                                 VerticalScrollBarVisibility="Auto"
                                 HeadersVisibility="Column"
                                 ScrollViewer.CanContentScroll="True"
                                 EnableColumnVirtualization="True"
                                 EnableRowVirtualization="True"
                                 Height="Auto"
                                 GridLinesVisibility="All"
                                 Style="{StaticResource DataGrid_Default}"
                                 Grid.Column="0"
                                 Grid.Row="0">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="RowEditEnding">
                                    <i:InvokeCommandAction Command="{Binding CommandRowEditEnding}"
                                                          PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Translate ColDate}" Binding="{Binding WorkoutLogID, StringFormat='dddd, dd.MM.yyyy'}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColDate}" Binding="{Binding MeasurementDate, StringFormat='dddd, dd.MM.yyyy'}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyWeight}" Binding="{Binding BodyWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBmi}" Binding="{Binding BMI, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyFatPercentage}" Binding="{Binding BodyFatPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyFatPercentageTop}" Binding="{Binding BodyFatPercentageTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyFatPercentageBottom}" Binding="{Binding BodyFatPercentageBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyMusclePercentage}" Binding="{Binding BodyMusclePercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyMusclePercentageTop}" Binding="{Binding BodyMusclePercentageTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyMusclePercentageBottom}" Binding="{Binding BodyMusclePercentageBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyWaterPercentage}" Binding="{Binding BodyWaterPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyBoneMass}" Binding="{Binding BodyBoneMass, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColBodyVisceralFat}" Binding="{Binding BodyVisceralFat, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColChestCircumference}" Binding="{Binding ChestCircumference, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColWaistCircumference}" Binding="{Binding WaistCircumference, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColHipsCircumference}" Binding="{Binding HipsCircumference, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongBreastCrease}" Binding="{Binding FatTongBreastCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongArmpitCrease}" Binding="{Binding FatTongArmpitCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongAbdominalCrease}" Binding="{Binding FatTongAbdominalCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongHipCrease}" Binding="{Binding FatTongHipCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongThighCrease}" Binding="{Binding FatTongThighCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongBackCrease}" Binding="{Binding FatTongBackCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                <DataGridTextColumn Header="{loc:Translate ColFatTongTricepsCrease}" Binding="{Binding FatTongTricepsCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Expander Header="{loc:Translate InitialValues}"
                         ExpandDirection="Left"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Right"
                         Grid.Column="1"
                         Grid.Row="0">

                    <Border Style="{DynamicResource BorderDashboardCardStyle}"
                           Grid.Column="0"
                           Grid.Row="1"
                           MaxWidth="600">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.Row="0">
                                <Run Text="{loc:Translate InitialMeasurementsFrom}" FontWeight="SemiBold" FontSize="12"/>
                                <Run Text="{Binding UserName}" FontWeight="Bold" FontSize="15"/>
                            </TextBlock>

                            <DataGrid x:Name="InitialMeasurementsGrid"
                                     ItemsSource="{Binding InitialBodyMeasurement, UpdateSourceTrigger=PropertyChanged}" 
                                     SelectedItem="{Binding SelectedMeasurement, Mode=TwoWay}"
                                     AutoGenerateColumns="False" 
                                     CanUserAddRows="False" 
                                     SelectionUnit="FullRow"
                                     SelectionMode="Single"
                                     Margin="0,10,10,0"
                                     FontWeight="Normal"
                                     VerticalScrollBarVisibility="Auto"
                                     HeadersVisibility="Column"
                                     ScrollViewer.CanContentScroll="True"
                                     EnableColumnVirtualization="True"
                                     EnableRowVirtualization="True"
                                     Height="Auto"
                                     GridLinesVisibility="All"
                                     Style="{StaticResource DataGrid_Default}"
                                     Grid.Column="0"
                                     Grid.Row="1"
                                     IsReadOnly="True">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Translate ColDate}" Binding="{Binding MeasurementDate, StringFormat='dddd, dd.MM.yyyy'}" Width="Auto" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyWeight}" Binding="{Binding BodyWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBmi}" Binding="{Binding BMI, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyFatPercentage}" Binding="{Binding BodyFatPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyFatPercentageTop}" Binding="{Binding BodyFatPercentageTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyFatPercentageBottom}" Binding="{Binding BodyFatPercentageBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyMusclePercentage}" Binding="{Binding BodyMusclePercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyMusclePercentageTop}" Binding="{Binding BodyMusclePercentageTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyMusclePercentageBottom}" Binding="{Binding BodyMusclePercentageBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyWaterPercentage}" Binding="{Binding BodyWaterPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyBoneMass}" Binding="{Binding BodyBoneMass, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColBodyVisceralFat}" Binding="{Binding BodyVisceralFat, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColChestCircumference}" Binding="{Binding ChestCircumference, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColWaistCircumference}" Binding="{Binding WaistCircumference, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColHipsCircumference}" Binding="{Binding HipsCircumference, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongBreastCrease}" Binding="{Binding FatTongBreastCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongArmpitCrease}" Binding="{Binding FatTongArmpitCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongAbdominalCrease}" Binding="{Binding FatTongAbdominalCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongHipCrease}" Binding="{Binding FatTongHipCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongThighCrease}" Binding="{Binding FatTongThighCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongBackCrease}" Binding="{Binding FatTongBackCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                    <DataGridTextColumn Header="{loc:Translate ColFatTongTricepsCrease}" Binding="{Binding FatTongTricepsCrease, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" CellStyle="{StaticResource DataGrid_CellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Page>