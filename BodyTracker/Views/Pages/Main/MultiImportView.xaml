<Page x:Class="BodyTracker.Views.Pages.MultiImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiChartPage">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Sidebar -->
        <Border Grid.Column="0"
                Grid.Row="0"
                Style="{DynamicResource BorderDashboardCardStyle}">
            
            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">


                <!-- ================= SHOW IMPORT SAMSUNG FOOD INTAKE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowFoodIntakeEntryView}"
                             GroupName="ImportSelection"
                             IsChecked="True"
                             ToolTip="Samsung Food Intake CSV Import">

                    <TextBlock Text="🥗 Food Intake"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                    
                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG DAILY STEP ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowStepTrendImportView}"
                             GroupName="ImportSelection"
                             ToolTip="Samsung Daily Step Trend CSV Import">

                    <TextBlock Text="🚶 Daily Steps"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG EXERCISE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowExerciseImportView}"
                             GroupName="ImportSelection"
                             ToolTip="Samsung Exercise CSV Import">

                    <TextBlock Text="🏃‍♀️ Exercises"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG HEART RATE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowHeartRateImportView}"
                             GroupName="ImportSelection"
                             ToolTip="Samsung Heart Rate CSV Import">

                    <TextBlock Text="💓 Heart Rate"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG OXYGEN SATURATION ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandOxygenSaturationImportView}"
                             GroupName="ImportSelection"
                             ToolTip="Samsung Oxygen Saturation CSV Import">

                    <TextBlock Style="{DynamicResource TextBlockNavButtonTabTitle}">

                            <InlineUIContainer>
                                <Image Source="/Ressources/Images/icons8-pulse-oximeter-100.png" 
                                       Width="22" 
                                       Height="22" 
                                       Margin="0"/>
                            </InlineUIContainer>
                        
                            <Run Text=" SpO₂"/>
                        
                    </TextBlock>



                </RadioButton>

                <!-- ================= SHOW IMPOR HEAVY APP ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowHeavyAppImportView}"
                             GroupName="ImportSelection"
                             ToolTip="Heavy App CSV Import">

                    <TextBlock Text="🏋️ Gym"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>



            </StackPanel>
        </Border>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="1">
            <Frame x:Name="MainChartContent" 
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>
