<Page x:Class="BodyTracker.Views.Pages.MultiImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiChartPage">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Sidebar -->
        <Border Grid.Column="0"
                Grid.Row="0"
                Style="{DynamicResource BorderDashboardCardStyle}">

            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">

                <!-- ================= SHOW IMPORT SAMSUNG FOOD INTAKE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowFoodIntakeEntryView}"
                             GroupName="ImportSelection"
                             IsChecked="True"
                             ToolTip="{loc:Translate ToolTipFoodIntakeImport}">

                    <TextBlock Text="{loc:Translate NavFoodIntake}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG FOOD INFO ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowFoodInfoImportView}"
                             GroupName="ImportSelection"
                             IsChecked="False"
                             ToolTip="{loc:Translate ToolTipFoodInfoImport}">

                    <TextBlock Text="{loc:Translate NavFoodInfo}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG DAILY STEP ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowStepTrendImportView}"
                             GroupName="ImportSelection"
                             ToolTip="{loc:Translate ToolTipDailyStepsImport}">

                    <TextBlock Text="{loc:Translate NavDailyStep}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG EXERCISE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowExerciseImportView}"
                             GroupName="ImportSelection"
                             ToolTip="{loc:Translate ToolTipExerciseImport}">

                    <TextBlock Text="{loc:Translate NavExercise}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG HEART RATE ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowHeartRateImportView}"
                             GroupName="ImportSelection"
                             ToolTip="{loc:Translate ToolTipHeartRateImport}">

                    <TextBlock Text="{loc:Translate NavHeartRate}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                </RadioButton>

                <!-- ================= SHOW IMPORT SAMSUNG OXYGEN SATURATION ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandOxygenSaturationImportView}"
                             GroupName="ImportSelection"
                             ToolTip="{loc:Translate ToolTipOxygenSaturationImport}">

                    <TextBlock Style="{DynamicResource TextBlockNavButtonTabTitle}"
                               Text="{loc:Translate NavSpO2}"/>
                    </RadioButton>

                <!-- ================= SHOW IMPORT Hevy APP ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowHevyAppImportView}"
                             GroupName="ImportSelection"
                             ToolTip="{loc:Translate ToolTipHevyImport}">

                    <TextBlock Text="{loc:Translate NavGym}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>
                </RadioButton>

            </StackPanel>
        </Border>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="1">
            <Frame x:Name="MainChartContent" 
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>