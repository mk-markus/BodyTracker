<Page x:Class="BodyTracker.Views.Pages.Main.OxygenSaturationChartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"     
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="OxygenSaturationChartView">

    <ScrollViewer VerticalScrollBarVisibility="Auto"  Padding="0"
            HorizontalScrollBarVisibility="Auto"
                Margin="0,10,0,0">
        <Grid MaxWidth="1550" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>

            <!-- SECTION 1: CONTROLS & FILTERS HEADER -->
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ================= TIMESPAN SECTION ================= -->
                <Border Style="{StaticResource BorderDashboardCardStyle}"
                 Grid.Column="0"
                 Padding="10"
                 Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="{loc:Translate LblTimespan}" 
                            Style="{DynamicResource TextBlockDashBoardTitle}" 
                            Margin="0,0,0,10"/>

                        <!-- Datepickers -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate LblFrom}" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernFlatDatePicker}"/>

                            <TextBlock Text="{loc:Translate LblTo}" VerticalAlignment="Center" Margin="10,0,10,0" Style="{DynamicResource TextBlockDescribing}"/>
                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource ModernFlatDatePicker}"/>

                            <!-- ================= TOGGLE BUTTON QUICK DATE RANGES ================= -->
                            <ToggleButton x:Name="DateShortCuts"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnQuickRanges}"
                                   Margin="10,0,0,0"          
                                   ToolTip="{loc:Translate ToolTipQuickRanges}"/>

                            <!-- ================= POPUP QUICK DATE RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=DateShortCuts}"
                            Placement="Bottom"
                            StaysOpen="False"
                            IsOpen="{Binding IsChecked, ElementName=DateShortCuts}" 
                            AllowsTransparency="True">

                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                 Width="{Binding ActualWidth, ElementName=DateShortCuts}">

                                    <StackPanel>
                                        <Button Content="{loc:Translate BtnYear}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualYear}" 
                                         ToolTip="{loc:Translate ToolTipYear}"
                                         Margin="0,0,0,0"/>

                                        <Button Content="{loc:Translate BtnWeek}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualWeek}" 
                                         ToolTip="{loc:Translate ToolTipWeek}"
                                         Margin="0,5,0,0"/>

                                        <Button Content="{loc:Translate BtnMonth}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandSetActualMonth}" 
                                         ToolTip="{loc:Translate ToolTipMonth}"
                                         Margin="0,5,0,0"/>

                                        <Button Content="{loc:Translate BtnAllTime}" 
                                         Style="{StaticResource ModernStandardButton}" 
                                         Command="{Binding CommandShowAllData}" 
                                         ToolTip="{loc:Translate ToolTipAllTime}"
                                         Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= METRICS SETTINGS SECTION ================= -->
                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                 Grid.Column="1"
                 Padding="10">

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{loc:Translate LblSeriesVisibility}" 
                            VerticalAlignment="Center"
                            Style="{DynamicResource TextBlockDashBoardTitle}" 
                            Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">

                            <!-- ================= TOGGLE BUTTON SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="SeriesButton"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnShowMeasurements}"
                                   Margin="0,0,10,0"          
                                   ToolTip="{loc:Translate ToolTipShowMeasurements}"/>

                            <!-- ================= POPUP SERIES CHECKBOXES RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=SeriesButton}"
                            Placement="Bottom"
                            StaysOpen="False"
                            IsOpen="{Binding IsChecked, ElementName=SeriesButton}" 
                            AllowsTransparency="True">

                                <Border Style="{DynamicResource BorderPopupDownCardStyle}"
                                  Width="{Binding ActualWidth, ElementName=SeriesButton}">

                                    <StackPanel>
                                        <CheckBox Content="{loc:Translate ColSpO2}" 
                                                  IsChecked="{Binding ShowSpO2}"
                                                  Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" 
                                                  Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColSpO2Max}" 
                                           IsChecked="{Binding ShowMaxSpO2}"
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColSpO2Min}" 
                                           IsChecked="{Binding ShowMinSpO2}"
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColLowSpO2Duration}" 
                                           IsChecked="{Binding ShowLowSpO2Duration}"
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColCoverageRate}" 
                                           IsChecked="{Binding ShowSpO2CoverageRate}" 
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- ================= TOGGLE BUTTON TREND SERIES MEASUREMENT DATAS ================= -->
                            <ToggleButton x:Name="TrendSeriesButton"
                                   Style="{DynamicResource ModernStandardToggleButton}"
                                   Content="{loc:Translate BtnShowTrends}"
                                   ToolTip="{loc:Translate ToolTipShowTrends}"/>

                            <!-- ================= POPUP TREND SERIES CHECKBOXES RANGES ================= -->
                            <Popup PlacementTarget="{Binding ElementName=TrendSeriesButton}"
                            Placement="Bottom"
                            StaysOpen="False"
                            IsOpen="{Binding IsChecked, ElementName=TrendSeriesButton}"
                            AllowsTransparency="True">

                                <Border Background="White"
                                 Style="{DynamicResource BorderPopupDownCardStyle}"
                                  Width="{Binding ActualWidth, ElementName=TrendSeriesButton}">

                                    <StackPanel>
                                        <CheckBox Content="{loc:Translate ColSpO2}" 
                                                  IsChecked="{Binding ShowSpO2Trend}"
                                                  Command="{Binding CommandReloadChartsAsync}" 
                                                  Style="{StaticResource StandardCheckBox}" 
                                                  Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColSpO2Max}" 
                                           IsChecked="{Binding ShowMaxSpO2Trend}"
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColSpO2Min}" 
                                           IsChecked="{Binding ShowMinSpO2Trend}"
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColLowSpO2Duration}" 
                                           IsChecked="{Binding ShowLowSpO2DurationTrend}"
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>

                                        <CheckBox Content="{loc:Translate ColCoverageRate}" 
                                           IsChecked="{Binding ShowSpO2CoverageRateTrend}" 
                                           Command="{Binding CommandReloadChartsAsync}" 
                                           Style="{StaticResource StandardCheckBox}" 
                                           Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button Content="🔄"
                         ToolTip="{loc:Translate ToolTipRefreshData}"
                         Command="{Binding CommandRefreshAsync}"
                         Style="{DynamicResource IconStandardButton}" />

                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= POPUP SPO2 CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
             Grid.Column="0"
             Grid.Row="1"
             Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Translate ChartTitleSpO2}"
                  Style="{DynamicResource TextBlockDashBoardTitle}"
                  Grid.Column="0"
                  Grid.Row="0"
                  Margin="0,0,0,12"/>

                    <lvc:CartesianChart Series="{Binding SeriesSpO2}" 
                                     XAxes="{Binding XAxesSpO2}" 
                                     YAxes="{Binding YAxesSpO2}" 
                                     LegendPosition="Bottom"
                                     Background="Transparent"
                                     Grid.Column="0"
                                     Grid.Row="1">
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- ================= POPUP LOW SPO2 DURATION CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
             Grid.Column="0"
             Grid.Row="2"
             Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Translate ChartTitleLowSpO2Duration}" 
                  Style="{DynamicResource TextBlockDashBoardTitle}"
                  Grid.Column="0"
                  Grid.Row="0"
                  Margin="0,0,0,12"/>

                    <lvc:CartesianChart Series="{Binding SeriesLowSpO2Duration}" 
                       XAxes="{Binding XAxesLowSpO2Duration}" 
                       YAxes="{Binding YAxesLowSpO2Duration}" 
                       LegendPosition="Hidden"
                       Background="Transparent"
                       Grid.Column="0"
                       Grid.Row="1">
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- ================= POPUP SPO2 COVERAGE RATE CHART ================= -->
            <Border Style="{StaticResource BorderDashboardCardStyle}"
                Grid.Column="0"
                Grid.Row="3"
                Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Translate ChartTitleSpO2CoverageRate}" 
                            Style="{DynamicResource TextBlockDashBoardTitle}"
                            Grid.Column="0"
                            Grid.Row="0"
                            Margin="0,0,0,12"/>

                    <lvc:CartesianChart Series="{Binding SeriesSpO2CoverageRate}" 
                                     XAxes="{Binding XAxesSpO2CoverageRate}" 
                                     YAxes="{Binding YAxesSpO2CoverageRate}" 
                                     LegendPosition="Hidden"
                                     Background="Transparent"
                                     Grid.Column="0"
                                     Grid.Row="1">
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>