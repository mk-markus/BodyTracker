<Page x:Class="BodyTracker.Views.Pages.Main.DBEntryWorkoutLogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages.Main"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DBEntryFoodIntakeView">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Style="{DynamicResource BorderDashboardCardStyle}"
                   Margin="0,10,0,10"
                   Grid.Column="0"
                   Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="🛠️ Actions"
                              Style="{DynamicResource TextBlockDashBoardTitle}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🗑"
                               ToolTip="Delete Selected Entry"
                               Command="{Binding CommandDelete}"
                               Style="{DynamicResource IconStandardButton}" 
                               Margin="0,0,15,0"/>

                        <Button Content="🔄"
                               ToolTip="Refresh Datas: Reload all datas from Database"
                               Command="{Binding CommandRefresh}"
                               Style="{DynamicResource IconStandardButton}" />

                    </StackPanel>
                </StackPanel>

            </Border>

            <Grid Grid.Column="0"
                 Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource BorderDashboardCardStyle}"
                       Grid.Column="0"
                       Grid.Row="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!--<RowDefinition Height="*"/>-->
                        </Grid.RowDefinitions>

                        <!--<TextBlock Grid.Column="0"
                                  Grid.Row="0">
                           
                       <Run Text="Measurements from " 
                            FontWeight="SemiBold"
                            FontSize="12"/>
                       <Run Text="{Binding UserName}" 
                            FontWeight="Bold"
                            FontSize="15"/>

                       </TextBlock>-->

                        <DataGrid x:Name="HevyAppGrid"
                                  ItemsSource="{Binding HevyAppDatas}"
                                  SelectedItem="{Binding SelectedData, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Single"
                                  Margin="0,10,10,0"
                                  FontWeight="Normal"
                                  VerticalScrollBarVisibility="Auto"
                                  HeadersVisibility="Column"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  GridLinesVisibility="All"
                                  Style="{StaticResource DataGrid_Default}">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="RowEditEnding">
                                    <i:InvokeCommandAction
                                        Command="{Binding CommandRowEditEnding}"
                                        PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="DB ID"
                                                    Binding="{Binding ExerciseLogID}"
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Workout"
                            Binding="{Binding Title}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Exercise"
                            Binding="{Binding ExerciseTitle}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Start Time"
                            Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="End Time"
                            Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Update Time"
                            Binding="{Binding UpdateTime, StringFormat=dd.MM.yyyy HH:mm:ss}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Description"
                            Binding="{Binding Description}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Superset ID"
                            Binding="{Binding SupersetId}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Exercise Notes"
                            Binding="{Binding ExerciseNotes}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Set Index"
                            Binding="{Binding SetIndex}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Set Type"
                            Binding="{Binding SetType}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Weight (kg)"
                            Binding="{Binding WeightKg, StringFormat=N2}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Reps"
                            Binding="{Binding Reps, StringFormat=N0}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Distance (km)"
                            Binding="{Binding DistanceKm, StringFormat=N2}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="Duration (sec)"
                            Binding="{Binding DurationSeconds}"
                            IsReadOnly="True"/>

                                <DataGridTextColumn Header="RPE"
                                                    Binding="{Binding Rpe, StringFormat=N1}"
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Data UUID"
                                            Binding="{Binding DataUuid}"
                                            IsReadOnly="True"/>

                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
