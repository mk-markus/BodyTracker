<Page x:Class="BodyTracker.Views.InfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="400"
      Title="InfoPage"
      Background="White">



    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
                    
        <StackPanel Orientation="Vertical"
            CanVerticallyScroll="True" >


            <Border Style="{DynamicResource BorderDashboardCardStyle}">

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="License"
                               FontSize="20"
                               FontWeight="Bold"
                               FontStyle="Italic"
                               Style="{StaticResource TextBlockDashBoardTitle}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding License, Mode=OneWay}"
                               Style="{StaticResource TextBlockDescribing}"/>
                </StackPanel>
                
            </Border>

            <Border Style="{DynamicResource BorderDashboardCardStyle}">
                
                <StackPanel Orientation="Vertical">
                
                    <TextBlock Text="Additional License"
                               FontSize="20"
                               FontWeight="Bold"
                               FontStyle="Italic"
                               Style="{StaticResource TextBlockDashBoardTitle}"
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="{Binding AdditionalLicense, Mode=OneWay}"
                               Style="{StaticResource TextBlockDescribing}"/>
                </StackPanel>
                
            </Border>
        </StackPanel>

    </ScrollViewer>
    
</Page>
