<Page x:Class="BodyTracker.Views.Pages.MultiChartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiChartPage">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <Border Grid.Column="0"
                Grid.Row="0"
                Style="{DynamicResource BorderDashboardCardStyle}">
            
            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">


                <!-- ================= SHOW PAGE MEASUREMENT CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowMeasurements}"
                             GroupName="ChartSelection"
                             IsChecked="True">
                    
                    <TextBlock Text="Body Measurements"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DAILY STEPS CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowDailyStep}"
                             GroupName="ChartSelection">
                    
                    <TextBlock Text="Daily Steps"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW WORKOUT CHARTS & EXERCISES ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding ShowWorkoutsCommand}"
                             GroupName="ChartSelection">
                    
                    <TextBlock Text="Workouts"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>
                
            </StackPanel>
        </Border>

        
        <!-- Hauptinhalt (Beispielhaft für New Entry Kachel mit den neuen Styles) -->
        <Grid Grid.Row="1">
            <Frame x:Name="MainChartContent" 
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>
