<Page x:Class="BodyTracker.Views.Pages.MultiChartsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      xmlns:loc="clr-namespace:BodyTracker.Services.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiChartPage">

    <Grid Background="{StaticResource AppBackgroundBrush}"
          Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                Style="{DynamicResource BorderDashboardCardStyle}">

            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">

                <!-- ================= SHOW PAGE MEASUREMENT CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowMeasurements}"
                             GroupName="ChartSelection"
                             IsChecked="True">

                    <TextBlock Text="{loc:Translate NavBodyMeasurement}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW FOOD INFO CHART ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowFoodInfo}"
                             GroupName="ChartSelection">

                    <TextBlock Text="{loc:Translate NavFoodInfo}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DAILY STEPS CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowDailyStep}"
                             GroupName="ChartSelection">

                    <TextBlock Text="{loc:Translate NavMovementEnergy}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW EXERCISE CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowExercise}"
                             GroupName="ChartSelection">

                    <TextBlock Text="{loc:Translate NavExercise}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW HEART RATE CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowHeartRate}"
                             GroupName="ChartSelection">

                    <TextBlock Text="{loc:Translate NavHeartRate}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW SPO2 CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowSpO2}"
                             GroupName="ChartSelection">

                    <TextBlock  Text="{loc:Translate NavSpO2}"
                                Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW WORKOUT CHARTS & EXERCISES ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowWorkouts}"
                             GroupName="ChartSelection">

                    <TextBlock Text="{loc:Translate NavGym}"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

            </StackPanel>
        </Border>

        <!-- Hauptinhalt -->
        <Grid Grid.Row="1">
            <Frame x:Name="MainChartContent" 
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>