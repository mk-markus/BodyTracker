<Page x:Class="BodyTracker.Views.Pages.MultiChartsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BodyTracker.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiChartPage">

    <Grid Background="{StaticResource AppBackgroundBrush}"
          Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <Border Grid.Column="0"
                Grid.Row="0"
                Style="{DynamicResource BorderDashboardCardStyle}">
            
            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">


                <!-- ================= SHOW PAGE MEASUREMENT CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}"
                             Command="{Binding CommandShowMeasurements}"
                             GroupName="ChartSelection"
                             IsChecked="True">

                    <TextBlock Text="📋 Body Measurement"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>


                <!-- ================= SHOW FOOD INFO CHART ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowFoodInfo}"
                             GroupName="ChartSelection">

                    <TextBlock Text="🥗 Food Info"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW DAILY STEPS CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowDailyStep}"
                             GroupName="ChartSelection">

                    <TextBlock Text="📊 Movement | Energy"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW EXERCISE CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowExercise}"
                             GroupName="ChartSelection">

                    <TextBlock Text="🏃 Exercise"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW HEART RATE CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowHeartRate}"
                             GroupName="ChartSelection">

                    <TextBlock Text="💓 Heart Rate"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>

                <!-- ================= SHOW HEART RATE CHARTS ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowSpO2}"
                             GroupName="ChartSelection">

                    <TextBlock Style="{DynamicResource TextBlockNavButtonTabTitle}">

                    <InlineUIContainer>
                        <Image Source="/Ressources/Images/icons8-pulse-oximeter-100.png" 
                                Width="22" 
                                Height="22" 
                                Margin="0"/>
                    </InlineUIContainer>
    
                    <Run Text=" SpO₂"/>
                    </TextBlock>

                </RadioButton>


                <!-- ================= SHOW WORKOUT CHARTS & EXERCISES ================= -->
                <RadioButton Style="{StaticResource NavButtonTabStyle}" 
                             Command="{Binding CommandShowWorkouts}"
                             GroupName="ChartSelection">

                    <TextBlock Text="🏋️ Gym"
                               Style="{DynamicResource TextBlockNavButtonTabTitle}"/>

                </RadioButton>




            </StackPanel>
        </Border>

        
        <!-- Hauptinhalt (Beispielhaft für New Entry Kachel mit den neuen Styles) -->
        <Grid Grid.Row="1">
            <Frame x:Name="MainChartContent" 
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>
