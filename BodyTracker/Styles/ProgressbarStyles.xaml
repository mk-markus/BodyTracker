<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ProgressbarPreviousBarValue" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        
        <Setter Property="Height" Value="6"/>

        <Setter Property="VerticalAlignment" Value="Top"/>

        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>

        <Setter Property="Background" Value="{DynamicResource ProgressbarPreviousValueBackgroundBrush}"/>

        <Setter Property="BorderThickness" Value="0"/>
        
        
    </Style>

    
    <Style x:Key="ProgressbarCurrentBarValue" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>

        <Setter Property="Height" Value="6"/>

        <Setter Property="VerticalAlignment" Value="Bottom"/>

        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>

        <Setter Property="Background" Value="{DynamicResource ProgressbarCurrentValueBackgroundBrush}"/>

        <Setter Property="BorderThickness" Value="0"/>


    </Style>

</ResourceDictionary>